# Dependencies
node_modules/
package-lock.json
yarn.lock

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Editor
.zcode/

# Environment
.env
.env.local

# Output
dist/
*.log

# Runtime data (data/ 是运行时数据目录：writer.db、reports、版权样本等，不入库)
data/
# 例外：README 演示用的评估示例样本（项目原创，版权自有）
!data/
data/*
!data/spike-samples/
data/spike-samples/*
!data/spike-samples/sample-novel.txt

# Spike 输出（含真实 LLM 响应、token/费用记录，可能含摘录片段）
spike/output/

# Dependencies (spike 本地安装)
spike/node_modules/

# Web runtime data
packages/web/data/

# Writer runtime data (writer.db / writer.db-shm / writer.db-wal，运行时生成，不入库)
packages/writer/data/

# Golden corpus: generated slices and run summaries (source novels stay under data/)
tests/golden/slices/
tests/golden/runs/
tests/golden/cassettes/
packages/eval/data/
