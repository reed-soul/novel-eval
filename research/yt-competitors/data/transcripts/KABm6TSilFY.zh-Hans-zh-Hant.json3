{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 3333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "请大家在看视频之前点赞护体"
    } ]
  }, {
    "tStartMs": 15300,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "欢迎收听"
    } ]
  }, {
    "tStartMs": 15933,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "由鲶鱼志为您带来的鲶鱼夜话节目"
    } ]
  }, {
    "tStartMs": 18500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "如果您有一些适合在夜里说的奇事"
    } ]
  }, {
    "tStartMs": 20900,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "怪事、邪事"
    } ]
  }, {
    "tStartMs": 22200,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "欢迎投给小编"
    } ]
  }, {
    "tStartMs": 23433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我是鲶鱼夜话的老于"
    } ]
  }, {
    "tStartMs": 25000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "我是妙妙"
    } ]
  }, {
    "tStartMs": 26033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "下面开始今天的夜话"
    } ]
  }, {
    "tStartMs": 28300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "好，欢迎收听本期的鲶鱼夜话"
    } ]
  }, {
    "tStartMs": 30033,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "欢迎回来"
    } ]
  }, {
    "tStartMs": 31166,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "哎，妙老师"
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你记得我们之前讲过一期知乎的"
    } ]
  }, {
    "tStartMs": 34400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "「阴宅」的一个故事吗"
    } ]
  }, {
    "tStartMs": 36700,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "就很火吗"
    } ]
  }, {
    "tStartMs": 37233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "节目里面的吗"
    } ]
  }, {
    "tStartMs": 38033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "对对对。完了，我阳过记忆不行啊……是吧"
    } ]
  }, {
    "tStartMs": 41400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "就是讲的一个"
    } ]
  }, {
    "tStartMs": 42766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "一个x乎上面很有名的帖子"
    } ]
  }, {
    "tStartMs": 44600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "就是这个答主呢"
    } ]
  }, {
    "tStartMs": 45966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "他在这个"
    } ]
  }, {
    "tStartMs": 47633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "租的这个房子里面出现怪事了"
    } ]
  }, {
    "tStartMs": 49500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "主要我们其实做了很多"
    } ]
  }, {
    "tStartMs": 52000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就是房子里面出事的"
    } ]
  }, {
    "tStartMs": 54433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "对对对。然后他出现的怪事"
    } ]
  }, {
    "tStartMs": 55633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "就是他在那个监控里面看到很多人脸"
    } ]
  }, {
    "tStartMs": 58433,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "哦！那个我记得"
    } ]
  }, {
    "tStartMs": 60100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那那……那个印象太深"
    } ]
  }, {
    "tStartMs": 61533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "很多鱼友在后台就是讲"
    } ]
  }, {
    "tStartMs": 63533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你怎么能这样对你的狗和猫"
    } ]
  }, {
    "tStartMs": 65533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "他不是出了问题就把猫……"
    } ]
  }, {
    "tStartMs": 66966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "对对对对"
    } ]
  }, {
    "tStartMs": 67933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就留那了对吧"
    } ]
  }, {
    "tStartMs": 69500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "很有问题对吧"
    } ]
  }, {
    "tStartMs": 71366,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "对。我们这种养猫养狗的人真看不下去"
    } ]
  }, {
    "tStartMs": 74233,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 74566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "感觉应该比自己的命还要重要才对"
    } ]
  }, {
    "tStartMs": 77566,
    "dDurationMs": 234,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 77800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "是啊。所以"
    } ]
  }, {
    "tStartMs": 79566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "他住的宅子为什么会出现这种情况"
    } ]
  }, {
    "tStartMs": 82033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "老于查过之后啊"
    } ]
  }, {
    "tStartMs": 83833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "有一个说法叫做y宅你有听过吗"
    } ]
  }, {
    "tStartMs": 86900,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "「y宅」就是顾名思义不好的宅子呗"
    } ]
  }, {
    "tStartMs": 90133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "哎对吧。这很简单吧"
    } ]
  }, {
    "tStartMs": 91933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "所以我想问你的问题是"
    } ]
  }, {
    "tStartMs": 93733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果你碰到这个宅子，你怎么办"
    } ]
  }, {
    "tStartMs": 96433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我其实我在早期节目"
    } ]
  }, {
    "tStartMs": 99433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我就讲过我的处理方法"
    } ]
  }, {
    "tStartMs": 101400,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "嗯？就是走掉，就走掉嘛"
    } ]
  }, {
    "tStartMs": 103566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "你不要想到什么止损不止损啊"
    } ]
  }, {
    "tStartMs": 105500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你自己命最重要"
    } ]
  }, {
    "tStartMs": 106966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "其实现在是这么想的"
    } ]
  }, {
    "tStartMs": 108166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "多了一个新的方法啊"
    } ]
  }, {
    "tStartMs": 109500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "就是你想想办法把旭仔请过来让"
    } ]
  }, {
    "tStartMs": 112800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "他镇一镇"
    } ]
  }, {
    "tStartMs": 114033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "猛男！对"
    } ]
  }, {
    "tStartMs": 115433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我们的前特警猛男，让他陪着住两天"
    } ]
  }, {
    "tStartMs": 118000,
    "dDurationMs": 566,
    "segs": [ {
      "utf8": "镇一镇"
    } ]
  }, {
    "tStartMs": 118566,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "可以，可以"
    } ]
  }, {
    "tStartMs": 119333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "好，今天我们的第一个故事呢"
    } ]
  }, {
    "tStartMs": 121000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "就是y宅发生的故事"
    } ]
  }, {
    "tStartMs": 123766,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "而且更恐怖的是呢"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "还有一个概念叫阴伶"
    } ]
  }, {
    "tStartMs": 127366,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "阴伶这个「伶」，它不是灵魂的「灵」"
    } ]
  }, {
    "tStartMs": 130833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "它是单人旁，一个命令的「令」"
    } ]
  }, {
    "tStartMs": 135200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "「亻」，一个命「令」……"
    } ]
  }, {
    "tStartMs": 137833,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "孤苦伶仃的那个「伶」"
    } ]
  }, {
    "tStartMs": 139833,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "看过。就是听过戏的人可能对这个词"
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "比较熟悉啊"
    } ]
  }, {
    "tStartMs": 144966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "但是如果说没有接触过戏曲的"
    } ]
  }, {
    "tStartMs": 148000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能会对这个事情"
    } ]
  }, {
    "tStartMs": 150000,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "对这个词呢"
    } ]
  }, {
    "tStartMs": 151200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "要弱一些啊"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "因为有一种说法是"
    } ]
  }, {
    "tStartMs": 154766,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "阴伶就是为过去的亡魂"
    } ]
  }, {
    "tStartMs": 158733,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "唱戏、哭泣、唱挽的这种人"
    } ]
  }, {
    "tStartMs": 162633,
    "dDurationMs": 167,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 162800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "也有说法呢是"
    } ]
  }, {
    "tStartMs": 164733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "阴伶是专门给鬼唱戏的旦角儿"
    } ]
  }, {
    "tStartMs": 168800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "旦角啊"
    } ]
  }, {
    "tStartMs": 171900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "那通常呢"
    } ]
  }, {
    "tStartMs": 173633,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "是这种八字极阴的女性，来从事这个"
    } ]
  }, {
    "tStartMs": 178800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "角色或者说这个职业啊"
    } ]
  }, {
    "tStartMs": 181633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那在某种玄学中解释呢"
    } ]
  }, {
    "tStartMs": 184100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "阴伶不仅具备沟通阴阳的能力"
    } ]
  }, {
    "tStartMs": 186766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "她还甚至可以啊"
    } ]
  }, {
    "tStartMs": 188133,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "通过通灵的方式，来预知未来"
    } ]
  }, {
    "tStartMs": 192700,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "是能力很强啊"
    } ]
  }, {
    "tStartMs": 194300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但这样一讲，就给我感觉中西合璧了"
    } ]
  }, {
    "tStartMs": 197133,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 197400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "「预知未来」这几个字……对对对，有点出戏"
    } ]
  }, {
    "tStartMs": 199966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "有点西方的感觉啊"
    } ]
  }, {
    "tStartMs": 202566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "好，那我们的今天的第一个故事呢"
    } ]
  }, {
    "tStartMs": 204500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "来自于我们b站的鱼友小q"
    } ]
  }, {
    "tStartMs": 207300,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "那不仅她遇到了类似于阴伶的人"
    } ]
  }, {
    "tStartMs": 211166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "而且"
    } ]
  }, {
    "tStartMs": 211933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她还发现，自己住了很多年的房子啊"
    } ]
  }, {
    "tStartMs": 214900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "风水不佳"
    } ]
  }, {
    "tStartMs": 215933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "有点像y宅的这种状况哦"
    } ]
  }, {
    "tStartMs": 218833,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "好在是"
    } ]
  }, {
    "tStartMs": 220200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "整体是没有发生太多的危险啊"
    } ]
  }, {
    "tStartMs": 222566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "请听我说啊"
    } ]
  }, {
    "tStartMs": 224033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "加上客服微信之后"
    } ]
  }, {
    "tStartMs": 225433,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小q特别有礼貌就跟我打招呼"
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "然后开门见山的说了自己这个故事"
    } ]
  }, {
    "tStartMs": 231033,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "不知道算不算得上灵异"
    } ]
  }, {
    "tStartMs": 233566,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "但是她是说自己啊"
    } ]
  }, {
    "tStartMs": 235400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "是整理了很久，才给我们做的投稿"
    } ]
  }, {
    "tStartMs": 238533,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "事情发生在2018年"
    } ]
  }, {
    "tStartMs": 240533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "那个时候小q刚上高中"
    } ]
  }, {
    "tStartMs": 242900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "因为上学的原因她搬家了"
    } ]
  }, {
    "tStartMs": 245366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "小q说也就是这次搬家"
    } ]
  }, {
    "tStartMs": 247533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "成为了自己人生的一个重要转折点"
    } ]
  }, {
    "tStartMs": 250533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "因为搬进新房子之后啊"
    } ]
  }, {
    "tStartMs": 253100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "不仅小q受到了影响"
    } ]
  }, {
    "tStartMs": 255000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "连带着家人一起受到了影响"
    } ]
  }, {
    "tStartMs": 258533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "小q住进新房之后啊"
    } ]
  }, {
    "tStartMs": 260233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "一开始是频繁的出现g压床的事情"
    } ]
  }, {
    "tStartMs": 263300,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "包括她弟弟啊，亲弟弟也说"
    } ]
  }, {
    "tStartMs": 266600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "会梦到女鬼来追自己"
    } ]
  }, {
    "tStartMs": 268433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那后来呢"
    } ]
  }, {
    "tStartMs": 269966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "小q发现"
    } ]
  }, {
    "tStartMs": 271033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "妈妈身上还出现了各种小毛病啊"
    } ]
  }, {
    "tStartMs": 273700,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "就是这种生理性的病。生病"
    } ]
  }, {
    "tStartMs": 276166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那父母呢"
    } ]
  }, {
    "tStartMs": 278000,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "也开始因为一些小事情"
    } ]
  }, {
    "tStartMs": 280366,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "就爆发出很大的矛盾"
    } ]
  }, {
    "tStartMs": 282766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "经常一直炸大吵大闹"
    } ]
  }, {
    "tStartMs": 284800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "好像很经常会有这种情况啊就是"
    } ]
  }, {
    "tStartMs": 288600,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "容易暴怒吵架，就是如果在y宅里面"
    } ]
  }, {
    "tStartMs": 292033,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "对！而且就是身边如果有"
    } ]
  }, {
    "tStartMs": 293533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "被这种东西影响到"
    } ]
  }, {
    "tStartMs": 295433,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "人的情绪是不对"
    } ]
  }, {
    "tStartMs": 296566,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "情绪波动很大"
    } ]
  }, {
    "tStartMs": 297966,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "是的，是的"
    } ]
  }, {
    "tStartMs": 298733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "不正常。对"
    } ]
  }, {
    "tStartMs": 300233,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "而且她说啊"
    } ]
  }, {
    "tStartMs": 301166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "他们就是严重到经常是半夜都在"
    } ]
  }, {
    "tStartMs": 304333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "大吵大闹"
    } ]
  }, {
    "tStartMs": 305166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "把小q和弟弟吓得呢"
    } ]
  }, {
    "tStartMs": 307166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就只敢躲在房间里面不敢出声"
    } ]
  }, {
    "tStartMs": 309966,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "那时间久了之后"
    } ]
  }, {
    "tStartMs": 310800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "小q就觉得很奇怪嘛，这种情况"
    } ]
  }, {
    "tStartMs": 313333,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就上网找了些信息"
    } ]
  }, {
    "tStartMs": 315400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "也和周围的这些邻居大妈们聊了聊"
    } ]
  }, {
    "tStartMs": 319100,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "你看小q这边的这个操作"
    } ]
  }, {
    "tStartMs": 320833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "给我们一个新的方式"
    } ]
  }, {
    "tStartMs": 322633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "跟邻居大妈们聊一聊"
    } ]
  }, {
    "tStartMs": 324333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "对。你如果住的新的地方"
    } ]
  }, {
    "tStartMs": 326333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "因为你过来之后，你产生什么情况啊"
    } ]
  }, {
    "tStartMs": 329166,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "你完全可以跟这种大妈们（聊聊）还真是"
    } ]
  }, {
    "tStartMs": 332600,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 333133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "嚼嚼舌根子"
    } ]
  }, {
    "tStartMs": 334166,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "对她们肯定大部分情况都了解"
    } ]
  }, {
    "tStartMs": 337533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "对，是的"
    } ]
  }, {
    "tStartMs": 339333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "小q聊完之后"
    } ]
  }, {
    "tStartMs": 341033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "大致知道了一些信息啊"
    } ]
  }, {
    "tStartMs": 342800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "首先上一任的房主跟小q他们家一样"
    } ]
  }, {
    "tStartMs": 345800,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "是为了学区买的这个房子"
    } ]
  }, {
    "tStartMs": 348566,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "但是，这个房主住进房子之后啊"
    } ]
  }, {
    "tStartMs": 350800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "也是碰到各种奇怪的问题"
    } ]
  }, {
    "tStartMs": 352933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "最后好像是因为生病"
    } ]
  }, {
    "tStartMs": 354933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "生了重病，才把这个房子转卖了"
    } ]
  }, {
    "tStartMs": 358400,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "小q一开始觉得"
    } ]
  }, {
    "tStartMs": 359333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "可能是这个房子的这个光照不够"
    } ]
  }, {
    "tStartMs": 362333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "就阳光照进来"
    } ]
  }, {
    "tStartMs": 363333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "很少阴冷"
    } ]
  }, {
    "tStartMs": 364366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "所以才会有这种情况"
    } ]
  }, {
    "tStartMs": 366200,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那直到"
    } ]
  }, {
    "tStartMs": 367566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这个事后面的事情发生之后啊"
    } ]
  }, {
    "tStartMs": 369566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "她才明白远远没有自己想的这么简单"
    } ]
  }, {
    "tStartMs": 372966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "说到这里呢"
    } ]
  }, {
    "tStartMs": 373600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "小q就给我"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "把这个房子的这个情况描述了一下"
    } ]
  }, {
    "tStartMs": 377933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "首先这个房子呢"
    } ]
  }, {
    "tStartMs": 378900,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "也是早期的公转私的房子"
    } ]
  }, {
    "tStartMs": 381400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "就是单位分配的楼房"
    } ]
  }, {
    "tStartMs": 382933,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就跟阿伟之前的那个朋友"
    } ]
  }, {
    "tStartMs": 385133,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "就是"
    } ]
  }, {
    "tStartMs": 385766,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "诡异录音带的那个，录像带的那个朋友"
    } ]
  }, {
    "tStartMs": 388300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "是一样的啊"
    } ]
  }, {
    "tStartMs": 390500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那转成这个私有之后啊"
    } ]
  }, {
    "tStartMs": 392133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "这个房子就正式流通"
    } ]
  }, {
    "tStartMs": 393766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "在市面上流通了嘛"
    } ]
  }, {
    "tStartMs": 395133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "房子这个构造呢比较老式"
    } ]
  }, {
    "tStartMs": 397766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "这一点啊"
    } ]
  }, {
    "tStartMs": 398900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我希望咱们广东的鱼友"
    } ]
  }, {
    "tStartMs": 400633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "可以出来帮我们鉴定一下啊"
    } ]
  }, {
    "tStartMs": 403033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "是不是广东的房子"
    } ]
  }, {
    "tStartMs": 404366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这种构造比较普遍啊"
    } ]
  }, {
    "tStartMs": 406000,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "小q说它的具体构造是"
    } ]
  }, {
    "tStartMs": 408233,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "房门进门就是榻榻米"
    } ]
  }, {
    "tStartMs": 410566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "那不远处呢，大概有两米的距离就是床"
    } ]
  }, {
    "tStartMs": 413900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "再往前呢就是窗"
    } ]
  }, {
    "tStartMs": 415966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "就等于床是放中间的啊"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她虽然说这个窗户很大"
    } ]
  }, {
    "tStartMs": 421766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "但是因为房屋的这个结构原因"
    } ]
  }, {
    "tStartMs": 424566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "也可能是因为朝向原因"
    } ]
  }, {
    "tStartMs": 426500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "基本上是没什么阳光照进来的"
    } ]
  }, {
    "tStartMs": 429166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "那回到这个房间门口啊"
    } ]
  }, {
    "tStartMs": 431033,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "左手边就是厕所"
    } ]
  }, {
    "tStartMs": 433233,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "右手边是书柜和书桌"
    } ]
  }, {
    "tStartMs": 435733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "嗯那小q还补充说啊"
    } ]
  }, {
    "tStartMs": 437733,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她说床尾是对着厕所"
    } ]
  }, {
    "tStartMs": 440933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "也就是说如果她睡在这个床上"
    } ]
  }, {
    "tStartMs": 444366,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她其实是看不见厕所的"
    } ]
  }, {
    "tStartMs": 447333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 448433,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "然后我就问她"
    } ]
  }, {
    "tStartMs": 448966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我说这个为什么窗户那么大"
    } ]
  }, {
    "tStartMs": 451933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "就还没有太阳照进来"
    } ]
  }, {
    "tStartMs": 453166,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "是因为是西晒房吗"
    } ]
  }, {
    "tStartMs": 455800,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "就是有很多房子，它不是南北通透的嘛"
    } ]
  }, {
    "tStartMs": 458166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "小q说不是"
    } ]
  }, {
    "tStartMs": 459366,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "她说因为窗户外面有另外一栋居民楼"
    } ]
  }, {
    "tStartMs": 463400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "但肯定是因为"
    } ]
  }, {
    "tStartMs": 464600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "早期的这个建房子的原因"
    } ]
  }, {
    "tStartMs": 466400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "他没有规划好啊"
    } ]
  }, {
    "tStartMs": 468233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他离得很近"
    } ]
  }, {
    "tStartMs": 469033,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "全挡住"
    } ]
  }, {
    "tStartMs": 469700,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "哎，把阳光都挡住了"
    } ]
  }, {
    "tStartMs": 471366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "嗯小q还说呢"
    } ]
  }, {
    "tStartMs": 473233,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "也可能是因为"
    } ]
  }, {
    "tStartMs": 474766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "就是因为这个阳光啊"
    } ]
  }, {
    "tStartMs": 476500,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "射不进来的原因"
    } ]
  }, {
    "tStartMs": 477733,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "所以厕所呢"
    } ]
  }, {
    "tStartMs": 478566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "总给她一种特别阴冷的感觉"
    } ]
  }, {
    "tStartMs": 481733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她基本上晚上去厕所之后啊"
    } ]
  }, {
    "tStartMs": 484433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "都有一种不知道从哪边吹出来的冷风"
    } ]
  }, {
    "tStartMs": 487500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我靠！吹的她阵阵发冷"
    } ]
  }, {
    "tStartMs": 489600,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "关键是她的厕所还特别大"
    } ]
  }, {
    "tStartMs": 494133,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "就一般来说啊"
    } ]
  }, {
    "tStartMs": 495900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "普通人不都会把厕所"
    } ]
  }, {
    "tStartMs": 497633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "进家里面的厕所"
    } ]
  }, {
    "tStartMs": 498633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "尽量打扫的比较干净嘛"
    } ]
  }, {
    "tStartMs": 500200,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 500733,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "因为它（厕所）这边本身就是一种污秽之地嘛"
    } ]
  }, {
    "tStartMs": 503400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 504600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "所以呢她这个厕所啊"
    } ]
  }, {
    "tStartMs": 507366,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "老会刮冷风"
    } ]
  }, {
    "tStartMs": 509100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "又很阴冷"
    } ]
  }, {
    "tStartMs": 510600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "就真的不是什么好事啊"
    } ]
  }, {
    "tStartMs": 512433,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 512633,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "这个是我听完之后，我自己的一个看法"
    } ]
  }, {
    "tStartMs": 516500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "那因为这个是学区房"
    } ]
  }, {
    "tStartMs": 518166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "所以小q呢没有办法"
    } ]
  }, {
    "tStartMs": 519966,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "她只能硬着头皮住"
    } ]
  }, {
    "tStartMs": 522033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "一年之后呢，也就是2019年的时候"
    } ]
  }, {
    "tStartMs": 524833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "小q高中就强制住校了"
    } ]
  }, {
    "tStartMs": 526633,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "她就只能去学校住了"
    } ]
  }, {
    "tStartMs": 529300,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "小q说一开始以为"
    } ]
  }, {
    "tStartMs": 530833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "只要离开这个奇怪的房子啊"
    } ]
  }, {
    "tStartMs": 532633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "情况就能有所有所好转"
    } ]
  }, {
    "tStartMs": 534833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "但没想到的是"
    } ]
  }, {
    "tStartMs": 536133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小q整个人的状态每况愈下"
    } ]
  }, {
    "tStartMs": 539366,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "用她自己的话说"
    } ]
  }, {
    "tStartMs": 540400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "是肉眼可见的变得憔悴"
    } ]
  }, {
    "tStartMs": 542433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 543633,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那开学的时候呢"
    } ]
  }, {
    "tStartMs": 544800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "小q要重新办一张校园卡"
    } ]
  }, {
    "tStartMs": 546933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "就去拍了个证件照"
    } ]
  }, {
    "tStartMs": 548633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "但是照片洗出来"
    } ]
  }, {
    "tStartMs": 550033,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "她自己都吓到了"
    } ]
  }, {
    "tStartMs": 551333,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "她形容说是照片里的自己，眼神凶狠"
    } ]
  }, {
    "tStartMs": 554600,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "就像那种杀人犯，入狱前拍的照片一样"
    } ]
  }, {
    "tStartMs": 558200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "印堂发黑的那种是吧"
    } ]
  }, {
    "tStartMs": 560000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就眼神反正很狠的那种"
    } ]
  }, {
    "tStartMs": 561766,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那高二开始呢"
    } ]
  }, {
    "tStartMs": 563366,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "小q就越发的形单影只了"
    } ]
  }, {
    "tStartMs": 565800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "做什么事情都独来独往"
    } ]
  }, {
    "tStartMs": 567933,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "她自己都没有意识到"
    } ]
  }, {
    "tStartMs": 569300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "这种变化是什么时候开始的"
    } ]
  }, {
    "tStartMs": 571533,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "而且小q啊"
    } ]
  }, {
    "tStartMs": 572366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "她现在是没有跟人交流的欲望"
    } ]
  }, {
    "tStartMs": 575000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "也没有任何活力"
    } ]
  }, {
    "tStartMs": 577566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "具体的话，就是有一天啊"
    } ]
  }, {
    "tStartMs": 580833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "小q上课教室在5楼"
    } ]
  }, {
    "tStartMs": 583033,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "她突然萌生出了一个想法"
    } ]
  }, {
    "tStartMs": 585166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "就是：要不我从5楼跳下去吧"
    } ]
  }, {
    "tStartMs": 587400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我靠！就我感觉这是有点抑郁症"
    } ]
  }, {
    "tStartMs": 590566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 591800,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "那小q在投稿里面说呢"
    } ]
  }, {
    "tStartMs": 593166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "自从这个念头出现之后啊"
    } ]
  }, {
    "tStartMs": 595000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "就在她里面心里面不断的滋生"
    } ]
  }, {
    "tStartMs": 598100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "就像一个吞噬内心的怪物"
    } ]
  }, {
    "tStartMs": 600200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "靠着这个迷茫跟孤独的这个力量"
    } ]
  }, {
    "tStartMs": 603000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "不断变大"
    } ]
  }, {
    "tStartMs": 604000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "不停的去撩拨自己：zs吧，zs吧"
    } ]
  }, {
    "tStartMs": 607733,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "小q说她那段时间"
    } ]
  }, {
    "tStartMs": 609500,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "每天说话可能都不超过10句"
    } ]
  }, {
    "tStartMs": 612033,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "而且她给自己定了一个计划"
    } ]
  }, {
    "tStartMs": 614100,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "下个学期前，我一定要死掉"
    } ]
  }, {
    "tStartMs": 618133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我估计真的就是……有点可怕"
    } ]
  }, {
    "tStartMs": 620300,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "这个"
    } ]
  }, {
    "tStartMs": 620700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "对对对"
    } ]
  }, {
    "tStartMs": 622366,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "这个时候呢"
    } ]
  }, {
    "tStartMs": 623533,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "她的投稿是聊天的（语音投稿）"
    } ]
  }, {
    "tStartMs": 626333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "她不是那种写好的"
    } ]
  }, {
    "tStartMs": 628833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我还在措辞怎么去劝她的时候"
    } ]
  }, {
    "tStartMs": 631166,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "她就投了下面新的内容"
    } ]
  }, {
    "tStartMs": 634000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "嗯就好在是呢"
    } ]
  }, {
    "tStartMs": 635933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小q她有几个比较积极阳光的朋友啊"
    } ]
  }, {
    "tStartMs": 638400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "所以她这个计划，迟迟没有推进"
    } ]
  }, {
    "tStartMs": 640933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "那精神状态反倒是有所好转"
    } ]
  }, {
    "tStartMs": 644300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "所有的事情貌似都在往好的方面发展"
    } ]
  }, {
    "tStartMs": 647366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "但是她遇到了一个朋友叫做L"
    } ]
  }, {
    "tStartMs": 650000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我们简称他为L"
    } ]
  }, {
    "tStartMs": 651100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "L算是小q的半个"
    } ]
  }, {
    "tStartMs": 653900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "同乡"
    } ]
  }, {
    "tStartMs": 655133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "之前一起上课下课"
    } ]
  }, {
    "tStartMs": 657700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "偶尔呢回家的时候啊"
    } ]
  }, {
    "tStartMs": 659100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她们会共同搭乘一班车"
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "但小q说啊"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "L给她的感觉就是有一点阴森森的"
    } ]
  }, {
    "tStartMs": 666433,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "阴冷的感觉"
    } ]
  }, {
    "tStartMs": 667566,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "她形容，L是眼神空洞"
    } ]
  }, {
    "tStartMs": 670833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "神情疲惫"
    } ]
  }, {
    "tStartMs": 672433,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "甚至在说，就是互相聊天的时候啊"
    } ]
  }, {
    "tStartMs": 676033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "她（L）会突然出现一段沉默"
    } ]
  }, {
    "tStartMs": 679100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就聊到一半，突然就不说话了"
    } ]
  }, {
    "tStartMs": 680700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "就很沉默"
    } ]
  }, {
    "tStartMs": 682600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "而且呢在这个时候"
    } ]
  }, {
    "tStartMs": 684133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "L会用一种特别"
    } ]
  }, {
    "tStartMs": 685500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "瘮人的表情去看着对方"
    } ]
  }, {
    "tStartMs": 688500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 689500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "还挺吓人的这种"
    } ]
  }, {
    "tStartMs": 691633,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那小q开始觉得啊"
    } ]
  }, {
    "tStartMs": 692800,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "可能是她们高中课业负担比较大"
    } ]
  }, {
    "tStartMs": 695933,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "伙食也不太好，才造成了L的这种状况"
    } ]
  }, {
    "tStartMs": 699966,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "但是她在强制住校之后"
    } ]
  }, {
    "tStartMs": 703400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "她发现L同寝的女孩都说害怕她"
    } ]
  }, {
    "tStartMs": 707133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就害怕L"
    } ]
  }, {
    "tStartMs": 708633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "甚至有的女孩子说啊"
    } ]
  }, {
    "tStartMs": 710166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "自己都不敢直视（L）"
    } ]
  }, {
    "tStartMs": 712966,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "补充一下"
    } ]
  }, {
    "tStartMs": 713966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "L跟小q是同一个寝室的啊"
    } ]
  }, {
    "tStartMs": 716366,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "呃"
    } ]
  }, {
    "tStartMs": 716566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "小q这个时候，也逐渐有点害怕L了"
    } ]
  }, {
    "tStartMs": 719900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "在投稿里面说呢"
    } ]
  }, {
    "tStartMs": 720900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "自己在上洗手间的时候"
    } ]
  }, {
    "tStartMs": 722833,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "总觉得L会透过厕所的门"
    } ]
  }, {
    "tStartMs": 726100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "上面的这个玻璃来"
    } ]
  }, {
    "tStartMs": 728400,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "窥探自己"
    } ]
  }, {
    "tStartMs": 729566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "啊嗯"
    } ]
  }, {
    "tStartMs": 730933,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "就是真的挺诡异的……这种感觉我觉得"
    } ]
  }, {
    "tStartMs": 735600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "那与此同时啊"
    } ]
  }, {
    "tStartMs": 736600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "小q其实并没有放弃zs的计划"
    } ]
  }, {
    "tStartMs": 739766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "她心里面还是打算，等放假后就去zs"
    } ]
  }, {
    "tStartMs": 743133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "但改变这一切的"
    } ]
  }, {
    "tStartMs": 744933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "L把小q约出去玩那件事"
    } ]
  }, {
    "tStartMs": 747533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 748766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那放假的时候呢"
    } ]
  }, {
    "tStartMs": 749966,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "L突然找到小q问她说"
    } ]
  }, {
    "tStartMs": 752166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "你有没有觉得"
    } ]
  }, {
    "tStartMs": 753400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我放假前，我的眼神特别空洞"
    } ]
  }, {
    "tStartMs": 756600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "整个人像丢了魂一样"
    } ]
  }, {
    "tStartMs": 758633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小q就点点头说：是是是"
    } ]
  }, {
    "tStartMs": 760200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "确实是，是吧。对"
    } ]
  }, {
    "tStartMs": 762233,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我觉得L突然问这个问题"
    } ]
  }, {
    "tStartMs": 763566,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "可能他人"
    } ]
  }, {
    "tStartMs": 764633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "缓过来了。她缓过来了，她缓过来了"
    } ]
  }, {
    "tStartMs": 766600,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "那L说呢"
    } ]
  }, {
    "tStartMs": 767800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "那段时间啊"
    } ]
  }, {
    "tStartMs": 768933,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "她不仅精神上面有各种问题"
    } ]
  }, {
    "tStartMs": 771200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "她自己也经常生病"
    } ]
  }, {
    "tStartMs": 772633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "然后看了各种医生也没有用"
    } ]
  }, {
    "tStartMs": 774933,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "之后啊家里面人给他找了师傅看"
    } ]
  }, {
    "tStartMs": 777400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "师傅说L有两个问题"
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "第一，她被学校里面往死的阿飘盯上"
    } ]
  }, {
    "tStartMs": 783500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "那这个阿飘呢"
    } ]
  }, {
    "tStartMs": 785100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "是想求助于她"
    } ]
  }, {
    "tStartMs": 786933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就是想让L替它办事"
    } ]
  }, {
    "tStartMs": 789600,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "然后她的下一句话，把小q直接吓傻了"
    } ]
  }, {
    "tStartMs": 792800,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "她说这个阿飘一直跟着她们"
    } ]
  }, {
    "tStartMs": 795733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就跟着L和小q"
    } ]
  }, {
    "tStartMs": 797566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 798733,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "说在她们吃饭、上课、回宿舍、睡觉、"
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "上厕所、说话……"
    } ]
  }, {
    "tStartMs": 805333,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "所有的时候都盯着自己啊"
    } ]
  }, {
    "tStartMs": 808366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "也是从L的背后，盯着她们两个"
    } ]
  }, {
    "tStartMs": 811633,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "所以……"
    } ]
  }, {
    "tStartMs": 812700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "所以在厕所里面可能是"
    } ]
  }, {
    "tStartMs": 816033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "可能是那个g"
    } ]
  }, {
    "tStartMs": 817933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "而且L的那个状态，是吧"
    } ]
  }, {
    "tStartMs": 820200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "对。而且L的那个状态啊"
    } ]
  }, {
    "tStartMs": 822033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "可能就是因为被这个g粘住了"
    } ]
  }, {
    "tStartMs": 824700,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "对啊"
    } ]
  }, {
    "tStartMs": 826166,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "就所以这个"
    } ]
  }, {
    "tStartMs": 827833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我觉得这个小q"
    } ]
  }, {
    "tStartMs": 829166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "她对L的这个所有看法啊"
    } ]
  }, {
    "tStartMs": 830900,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "不光是小q"
    } ]
  }, {
    "tStartMs": 831533,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "其实是所有人对L的看法，可能是"
    } ]
  }, {
    "tStartMs": 834766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "被这个阿飘影响了。对啊，对"
    } ]
  }, {
    "tStartMs": 837366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "光环一样"
    } ]
  }, {
    "tStartMs": 839100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "然后L就说，为什么这个阿飘啊"
    } ]
  }, {
    "tStartMs": 841900,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "不找别人找我呢"
    } ]
  }, {
    "tStartMs": 843966,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "师傅说L的命格极阴"
    } ]
  }, {
    "tStartMs": 846300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "放在古代，就是阴伶的命啊"
    } ]
  }, {
    "tStartMs": 849366,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "哦……就是你开头讲。"
    } ]
  }, {
    "tStartMs": 851766,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "当时L和家里面人并不理解"
    } ]
  }, {
    "tStartMs": 854633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "什么叫阴伶的命"
    } ]
  }, {
    "tStartMs": 856433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "师傅也没有做过多的解释"
    } ]
  }, {
    "tStartMs": 858966,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "就是做法，替L把这个问题解决了"
    } ]
  }, {
    "tStartMs": 862300,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "后来，他们家里面人又背着这个"
    } ]
  }, {
    "tStartMs": 866233,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "就是他们不太方便去……背这个大师"
    } ]
  }, {
    "tStartMs": 869600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "找这个其他师傅"
    } ]
  }, {
    "tStartMs": 872300,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "但是呢"
    } ]
  }, {
    "tStartMs": 872766,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "他们还是想办法，去找了一些懂行的"
    } ]
  }, {
    "tStartMs": 875400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就他们想知道这个原因嘛"
    } ]
  }, {
    "tStartMs": 877600,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "但没有说L的任何事情"
    } ]
  }, {
    "tStartMs": 880366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "没有说，哎，我女儿怎么怎么怎么"
    } ]
  }, {
    "tStartMs": 882200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "就直接问什么叫阴伶命"
    } ]
  }, {
    "tStartMs": 884700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "然后有的师傅，给咱们解释啊"
    } ]
  }, {
    "tStartMs": 886600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "说大概意思就是：命格极阴"
    } ]
  }, {
    "tStartMs": 889000,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "理论上，要么就是跟他们当同行"
    } ]
  }, {
    "tStartMs": 891933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "要么就是去做阴伶"
    } ]
  }, {
    "tStartMs": 893700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "因为这种人呢"
    } ]
  }, {
    "tStartMs": 895100,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "容易被往生的这种灵缠上"
    } ]
  }, {
    "tStartMs": 898200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "所以他们必须要靠修行来保护自己"
    } ]
  }, {
    "tStartMs": 901933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "那最早的师傅不给他们说的原因呢"
    } ]
  }, {
    "tStartMs": 904933,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "可能也是因为觉得，这个事情比较棘手"
    } ]
  }, {
    "tStartMs": 908000,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那小q补充说"
    } ]
  }, {
    "tStartMs": 909133,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "L给自己说这件事情的时候啊"
    } ]
  }, {
    "tStartMs": 911300,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "广东是夏天"
    } ]
  }, {
    "tStartMs": 912933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "是那种穿短袖短裤的季节"
    } ]
  }, {
    "tStartMs": 914900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "而且广东很热嘛"
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "但是她当时就觉得格外的阴冷"
    } ]
  }, {
    "tStartMs": 919366,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "甚至想找一件外套披上"
    } ]
  }, {
    "tStartMs": 921700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "但是，她看到L的状态确实已经变好了"
    } ]
  }, {
    "tStartMs": 924366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "她还是为L感到高兴啊"
    } ]
  }, {
    "tStartMs": 927566,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "但是L虽然是转好了"
    } ]
  }, {
    "tStartMs": 929700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "小q还是越发糟糕"
    } ]
  }, {
    "tStartMs": 932566,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "最明显的呢，是她觉得自己"
    } ]
  }, {
    "tStartMs": 935366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "被人盯着的感觉"
    } ]
  }, {
    "tStartMs": 937000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "没有因为L把这个事情解决掉，消失了"
    } ]
  }, {
    "tStartMs": 940000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "而是越发强烈了"
    } ]
  }, {
    "tStartMs": 943100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "那回到小q最早这个住的房子的问题"
    } ]
  }, {
    "tStartMs": 946600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "她说自己的这个客厅里面，有个酒柜"
    } ]
  }, {
    "tStartMs": 949300,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "她听完L说到这个事情之后啊"
    } ]
  }, {
    "tStartMs": 951900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "她回到家"
    } ]
  }, {
    "tStartMs": 952933,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "经常会时不时的看到这个"
    } ]
  }, {
    "tStartMs": 955500,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "酒柜的玻璃上有影子划过"
    } ]
  }, {
    "tStartMs": 958033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "让她感觉到非常的害怕"
    } ]
  }, {
    "tStartMs": 960633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "但是小q还是觉得这可能是巧合"
    } ]
  }, {
    "tStartMs": 962733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "或者是光线的错觉啊"
    } ]
  }, {
    "tStartMs": 964000,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 964533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "她就用这种科学的解释来安慰自己"
    } ]
  }, {
    "tStartMs": 967433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "直到某一天"
    } ]
  }, {
    "tStartMs": 968700,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "小q背对着窗侧卧在床上睡午觉"
    } ]
  }, {
    "tStartMs": 971566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "突然她醒了"
    } ]
  }, {
    "tStartMs": 973100,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "紧接着呢"
    } ]
  }, {
    "tStartMs": 973733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "她就感觉到，有人在他耳边吹了一口气"
    } ]
  }, {
    "tStartMs": 977800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小q在投稿里面说啊"
    } ]
  }, {
    "tStartMs": 978900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "说这种感觉特别真切"
    } ]
  }, {
    "tStartMs": 980566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "她一开始以为是弟弟恶作剧"
    } ]
  }, {
    "tStartMs": 982600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "心里面特别气"
    } ]
  }, {
    "tStartMs": 983966,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "想翻过身去骂人"
    } ]
  }, {
    "tStartMs": 985366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这个时候她才意识到动不了了"
    } ]
  }, {
    "tStartMs": 988133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "被gyc了"
    } ]
  }, {
    "tStartMs": 989333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 990433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "小q说自己此时整个人都是麻了"
    } ]
  }, {
    "tStartMs": 993133,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "像被重物压的感觉一样"
    } ]
  }, {
    "tStartMs": 995166,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "她在心理上就是，心里面就破口大骂"
    } ]
  }, {
    "tStartMs": 997600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "骂了好一阵她才能动"
    } ]
  }, {
    "tStartMs": 999300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "然后顿时，她就赶紧翻身起床"
    } ]
  }, {
    "tStartMs": 1001900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "整个人特别清醒"
    } ]
  }, {
    "tStartMs": 1003500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "小q这个时候"
    } ]
  }, {
    "tStartMs": 1004333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "还是觉得"
    } ]
  }, {
    "tStartMs": 1005833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "是不是弟弟在恶作剧什么的"
    } ]
  }, {
    "tStartMs": 1007366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "因为她要找一个理由说服自己嘛"
    } ]
  }, {
    "tStartMs": 1010200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "她就想去骂弟弟"
    } ]
  }, {
    "tStartMs": 1012366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "但她发现啊"
    } ]
  }, {
    "tStartMs": 1013333,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "弟弟一直在安静的睡午觉"
    } ]
  }, {
    "tStartMs": 1015600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "根本没有醒过来的迹象"
    } ]
  }, {
    "tStartMs": 1017033,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "那小q就坐回沙发上面去"
    } ]
  }, {
    "tStartMs": 1019700,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "思考这个事情"
    } ]
  }, {
    "tStartMs": 1020766,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "她越想越不对，越想越害怕"
    } ]
  }, {
    "tStartMs": 1022900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "有些细节就慢慢浮现出来了"
    } ]
  }, {
    "tStartMs": 1025433,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "她说当时自己能动之后啊"
    } ]
  }, {
    "tStartMs": 1027800,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "第一反应是翻身"
    } ]
  }, {
    "tStartMs": 1029733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "小q说自己平躺在床上的姿势啊"
    } ]
  }, {
    "tStartMs": 1032433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "可能她就只有一两秒钟的这种感觉"
    } ]
  }, {
    "tStartMs": 1035033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "她就清晰的感觉到"
    } ]
  }, {
    "tStartMs": 1036700,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "有什么东西垂到自己身上"
    } ]
  }, {
    "tStartMs": 1039166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "在来回扫动"
    } ]
  }, {
    "tStartMs": 1040566,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "现在这么一想啊……可能是头发丝"
    } ]
  }, {
    "tStartMs": 1044833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "他脑补出一个画面"
    } ]
  }, {
    "tStartMs": 1045966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "就是有一个人倒吊在天花板上面"
    } ]
  }, {
    "tStartMs": 1048633,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "然后倒吊着"
    } ]
  }, {
    "tStartMs": 1050133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "对，倒吊着"
    } ]
  }, {
    "tStartMs": 1051800,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然后，诡异这个姿势"
    } ]
  }, {
    "tStartMs": 1053966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "是啊"
    } ]
  }, {
    "tStartMs": 1054833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "而且这个「人」，我估计是打引号，对吧"
    } ]
  }, {
    "tStartMs": 1056800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "对啊"
    } ]
  }, {
    "tStartMs": 1057400,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "然后用这个长长的头发丝"
    } ]
  }, {
    "tStartMs": 1059966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "撩她"
    } ]
  }, {
    "tStartMs": 1061300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 1062600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那小q只能安慰自己"
    } ]
  }, {
    "tStartMs": 1064100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "不要多想……不要多想……"
    } ]
  }, {
    "tStartMs": 1065133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "毕竟她也没办法，她也搬不了家"
    } ]
  }, {
    "tStartMs": 1068100,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "但之后呢"
    } ]
  }, {
    "tStartMs": 1068733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "她就更频繁的感觉"
    } ]
  }, {
    "tStartMs": 1070433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "有一双眼睛在背后盯着自己"
    } ]
  }, {
    "tStartMs": 1072600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "无论自己做什么，只要是在家里面"
    } ]
  }, {
    "tStartMs": 1075133,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "她就有这种被"
    } ]
  }, {
    "tStartMs": 1076166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "窥探的感觉"
    } ]
  }, {
    "tStartMs": 1078300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那时间在继续啊"
    } ]
  }, {
    "tStartMs": 1079733,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "没有任何人，能够阻止时间的推移"
    } ]
  }, {
    "tStartMs": 1083433,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "小q说"
    } ]
  }, {
    "tStartMs": 1084300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "时间到了她打算结束生命的那天"
    } ]
  }, {
    "tStartMs": 1087600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她那天呢就把自己打扮了一番"
    } ]
  }, {
    "tStartMs": 1089833,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "整夜没睡，坐在客厅里面"
    } ]
  }, {
    "tStartMs": 1091533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "一直坐到了将近天亮"
    } ]
  }, {
    "tStartMs": 1093966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "应该是5点或者6点的样子"
    } ]
  }, {
    "tStartMs": 1095766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "她就走上天台准备跳下去了"
    } ]
  }, {
    "tStartMs": 1098500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那这段投稿"
    } ]
  }, {
    "tStartMs": 1099600,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "小q就是用这个语音投的"
    } ]
  }, {
    "tStartMs": 1101966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我明显听出语音里面有哽咽感"
    } ]
  }, {
    "tStartMs": 1105566,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "小q说自己走上天台的整个阶段啊"
    } ]
  }, {
    "tStartMs": 1108166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "有一种被什么人操纵和支配的感觉"
    } ]
  }, {
    "tStartMs": 1111166,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "当她走到天台的时候啊"
    } ]
  }, {
    "tStartMs": 1113633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "心里面有一个声音"
    } ]
  }, {
    "tStartMs": 1115966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "就不停的告诉她说"
    } ]
  }, {
    "tStartMs": 1117833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "哎，你可以给家里面人打电话"
    } ]
  }, {
    "tStartMs": 1120800,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "那小q说可能是因为"
    } ]
  }, {
    "tStartMs": 1122733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "人类的生存本能吧"
    } ]
  }, {
    "tStartMs": 1124333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这种动物性"
    } ]
  }, {
    "tStartMs": 1125700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "她就挣扎着"
    } ]
  }, {
    "tStartMs": 1127200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "听从了自己心里面的这个声音"
    } ]
  }, {
    "tStartMs": 1129566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "好在她还没来得及做什么"
    } ]
  }, {
    "tStartMs": 1133933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "她也没来得及跳，也没来得及打电话"
    } ]
  }, {
    "tStartMs": 1136133,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "家里面人及时赶到，把她给拦住"
    } ]
  }, {
    "tStartMs": 1139133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦！"
    } ]
  }, {
    "tStartMs": 1140433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "对，就把她拦下来了"
    } ]
  }, {
    "tStartMs": 1141933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但这个事情呢，并没有因此结束"
    } ]
  }, {
    "tStartMs": 1145033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "家里面发现这个情况之后啊"
    } ]
  }, {
    "tStartMs": 1147366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "也带着小q去找师傅"
    } ]
  }, {
    "tStartMs": 1149533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "师傅说小q是丢了魂魄"
    } ]
  }, {
    "tStartMs": 1151566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "所以才会被这个g附身操作的"
    } ]
  }, {
    "tStartMs": 1154233,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "那关键呢这个师傅的说法"
    } ]
  }, {
    "tStartMs": 1157133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他找的这个师傅"
    } ]
  }, {
    "tStartMs": 1157933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "跟L的那个，不是一个师傅啊"
    } ]
  }, {
    "tStartMs": 1159533,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "哦，知道啊"
    } ]
  }, {
    "tStartMs": 1160800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "她这个师傅"
    } ]
  }, {
    "tStartMs": 1161533,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "跟L的那个师傅说的是一样的"
    } ]
  }, {
    "tStartMs": 1163366,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "说她是被学校里面的枉死g盯上了"
    } ]
  }, {
    "tStartMs": 1166333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1167333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那小q就很疑惑啊说"
    } ]
  }, {
    "tStartMs": 1169966,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "当时L说"
    } ]
  }, {
    "tStartMs": 1171700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "这个阿飘不是已经给超度了嘛"
    } ]
  }, {
    "tStartMs": 1174100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "对吧，已经给她的那个师傅超度了"
    } ]
  }, {
    "tStartMs": 1176600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "难道是有新的阿飘"
    } ]
  }, {
    "tStartMs": 1178366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "或者是学校就这么邪"
    } ]
  }, {
    "tStartMs": 1180300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "能有这么多阿飘"
    } ]
  }, {
    "tStartMs": 1181366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那小q说"
    } ]
  }, {
    "tStartMs": 1183033,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她说因为家里面人很笃信这些东西"
    } ]
  }, {
    "tStartMs": 1185900,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "就所以一连做了两、三场法事"
    } ]
  }, {
    "tStartMs": 1189566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那每次做法事"
    } ]
  }, {
    "tStartMs": 1190966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "小q就会莫名其妙的烦躁"
    } ]
  }, {
    "tStartMs": 1193366,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "虽然在这个过程中"
    } ]
  }, {
    "tStartMs": 1194600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "她没有看到任何的阿飘的这种"
    } ]
  }, {
    "tStartMs": 1196700,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "g影什么的"
    } ]
  }, {
    "tStartMs": 1198166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "师傅呢也没有给小q多做解释"
    } ]
  }, {
    "tStartMs": 1201766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "所以她不知道"
    } ]
  }, {
    "tStartMs": 1202966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "这个阿飘是为什么跟着她"
    } ]
  }, {
    "tStartMs": 1205000,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "以及是怎么盯上她的"
    } ]
  }, {
    "tStartMs": 1207300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "好在呢，估计是这个师傅真的是有本事"
    } ]
  }, {
    "tStartMs": 1210333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "做法事之前呢"
    } ]
  }, {
    "tStartMs": 1211833,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "也就是小q她消沉的那段时间"
    } ]
  }, {
    "tStartMs": 1214833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "她照镜子的时候"
    } ]
  }, {
    "tStartMs": 1216433,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "她感觉镜子里面出现的，不是自己"
    } ]
  }, {
    "tStartMs": 1220133,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "或者说不止自己，还有一个中年阿姨"
    } ]
  }, {
    "tStartMs": 1223000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但是法事做完之后啊"
    } ]
  }, {
    "tStartMs": 1224733,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "就消失了"
    } ]
  }, {
    "tStartMs": 1225900,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "就消失了"
    } ]
  }, {
    "tStartMs": 1227500,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "在之后，小q就高中毕业了"
    } ]
  }, {
    "tStartMs": 1230366,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "她家里面就赶紧把这个房子卖掉了"
    } ]
  }, {
    "tStartMs": 1232600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那一切呢就回归到了正轨"
    } ]
  }, {
    "tStartMs": 1235033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小q也就逐渐恢复如初了啊"
    } ]
  }, {
    "tStartMs": 1238000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "但是，她说不知道什么原因呢"
    } ]
  }, {
    "tStartMs": 1240133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "她有一次回到那个房子就看了一眼"
    } ]
  }, {
    "tStartMs": 1242300,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "就发现啊"
    } ]
  }, {
    "tStartMs": 1243300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "第三任的房主，在房门外贴满了黄符"
    } ]
  }, {
    "tStartMs": 1247966,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "啊嗯"
    } ]
  }, {
    "tStartMs": 1248800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "这个整个故事"
    } ]
  }, {
    "tStartMs": 1251000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "它的整个故事呢到这边就结束了啊"
    } ]
  }, {
    "tStartMs": 1253933,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "那就是这个宅子的问题吧，对吧"
    } ]
  }, {
    "tStartMs": 1256966,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "对。我觉得就是因为这个宅子是y宅"
    } ]
  }, {
    "tStartMs": 1260100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "所以才把"
    } ]
  }, {
    "tStartMs": 1261966,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "学校里面的这个阿飘吸引到了"
    } ]
  }, {
    "tStartMs": 1264600,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "小q身上"
    } ]
  }, {
    "tStartMs": 1265300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她现在好了，对吧？"
    } ]
  }, {
    "tStartMs": 1268000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "已经好了，已经好了"
    } ]
  }, {
    "tStartMs": 1268766,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "那太好了。对！那就好，那就好！"
    } ]
  }, {
    "tStartMs": 1272100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "而且这个学校里面的这个阿飘"
    } ]
  }, {
    "tStartMs": 1274233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我觉得就是不是看上了这个（y宅）"
    } ]
  }, {
    "tStartMs": 1275900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1276833,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "宅子嘛，我估计可以养（g）"
    } ]
  }, {
    "tStartMs": 1279366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "甚至有的宅子啊"
    } ]
  }, {
    "tStartMs": 1281366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "出现这种情况最严重的时候"
    } ]
  }, {
    "tStartMs": 1283333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "可以把一些"
    } ]
  }, {
    "tStartMs": 1285166,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "来往过路的灵体吸进来啊"
    } ]
  }, {
    "tStartMs": 1288133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "那这种房子，容易滋阴养邪"
    } ]
  }, {
    "tStartMs": 1290800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "有一些小g在里面待久了"
    } ]
  }, {
    "tStartMs": 1293133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "怨念会越来越深"
    } ]
  }, {
    "tStartMs": 1295200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "嗯所以她（小q）给我们的建议是"
    } ]
  }, {
    "tStartMs": 1297700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我们无论是在买房还是在租房的时候"
    } ]
  }, {
    "tStartMs": 1300433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "可以去"
    } ]
  }, {
    "tStartMs": 1302033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "多听听自己的心声"
    } ]
  }, {
    "tStartMs": 1304133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "如果你进入这个房子"
    } ]
  }, {
    "tStartMs": 1305633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "刚进去，你就感觉不好"
    } ]
  }, {
    "tStartMs": 1307600,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "感觉很不对"
    } ]
  }, {
    "tStartMs": 1309166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "那你就相信自己第六感情"
    } ]
  }, {
    "tStartMs": 1309933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "就不要这个吧"
    } ]
  }, {
    "tStartMs": 1311366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "是，对"
    } ]
  }, {
    "tStartMs": 1313133,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "所以最后……还好就是都解决了嘛"
    } ]
  }, {
    "tStartMs": 1316100,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "我们还是祝这个"
    } ]
  }, {
    "tStartMs": 1317900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是的是的是的"
    } ]
  }, {
    "tStartMs": 1318933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "这个解决太好了"
    } ]
  }, {
    "tStartMs": 1320200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "对，还是祝咱们小q，一切都好"
    } ]
  }, {
    "tStartMs": 1322766,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "平平安安"
    } ]
  }, {
    "tStartMs": 1323333,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "对好"
    } ]
  }, {
    "tStartMs": 1324100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "第一故事到这边"
    } ]
  }, {
    "tStartMs": 1328533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "好，第二故事依然是来自b站的鱼友啊"
    } ]
  }, {
    "tStartMs": 1332000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "叫：湛蓝。我们喊他"
    } ]
  }, {
    "tStartMs": 1334633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "小蓝（是女孩子）"
    } ]
  }, {
    "tStartMs": 1335600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小蓝说"
    } ]
  }, {
    "tStartMs": 1337600,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "自己发生故事大概是上初一的时候啊"
    } ]
  }, {
    "tStartMs": 1341766,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "自己呢"
    } ]
  }, {
    "tStartMs": 1343366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "一直是"
    } ]
  }, {
    "tStartMs": 1344733,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "比较喜欢盗墓笔记，这个系列的书"
    } ]
  }, {
    "tStartMs": 1347633,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "嗯。你看过吗"
    } ]
  }, {
    "tStartMs": 1349133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我还真不喜欢"
    } ]
  }, {
    "tStartMs": 1350600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊，你看过"
    } ]
  }, {
    "tStartMs": 1351400,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "你不喜欢是吧"
    } ]
  }, {
    "tStartMs": 1352400,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我没看过书，我看过电影的片段吧"
    } ]
  }, {
    "tStartMs": 1355733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "书，其实还行"
    } ]
  }, {
    "tStartMs": 1356733,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "书我看过大概两三册，我觉得还行"
    } ]
  }, {
    "tStartMs": 1359800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1360400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1361500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "他（小蓝）特别喜欢这系列书"
    } ]
  }, {
    "tStartMs": 1363366,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "然后正好那年是八月十七日"
    } ]
  }, {
    "tStartMs": 1367300,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我一开始以为是中元节前后嘛"
    } ]
  }, {
    "tStartMs": 1370033,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然后就问他"
    } ]
  }, {
    "tStartMs": 1370933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "就八月十七日那年到底有什么特别的"
    } ]
  }, {
    "tStartMs": 1373733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "后来他跟我讲啊"
    } ]
  }, {
    "tStartMs": 1376033,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "这个是盗墓笔记"
    } ]
  }, {
    "tStartMs": 1377800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "粉丝们约定俗成的"
    } ]
  }, {
    "tStartMs": 1379733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "就是可能和故事里面有关的"
    } ]
  }, {
    "tStartMs": 1382133,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是八月十七日叫稻米节"
    } ]
  }, {
    "tStartMs": 1384766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "哦，对。然后因为小蓝是粉丝嘛"
    } ]
  }, {
    "tStartMs": 1387733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "然后就准备和妈妈"
    } ]
  }, {
    "tStartMs": 1389400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "还有一位阿姨准备去……盗墓？"
    } ]
  }, {
    "tStartMs": 1392166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 1392933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "过分了啊！盗墓是犯法的啊"
    } ]
  }, {
    "tStartMs": 1394800,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "是的，是的，不能多说"
    } ]
  }, {
    "tStartMs": 1395933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "准备去长白山玩去"
    } ]
  }, {
    "tStartMs": 1397966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "哦！就是那个发生的地是吧"
    } ]
  }, {
    "tStartMs": 1400333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "对对对"
    } ]
  }, {
    "tStartMs": 1401566,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "行程定在8月17日的前几天"
    } ]
  }, {
    "tStartMs": 1404500,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "嗯小蓝说，他们一行玩完了黑龙潭漂流等项目"
    } ]
  }, {
    "tStartMs": 1408800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "其他的不记得了"
    } ]
  }, {
    "tStartMs": 1411400,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "因为回忆实在是不太美好"
    } ]
  }, {
    "tStartMs": 1413766,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "所以自己已经记不清去哪玩了嗯"
    } ]
  }, {
    "tStartMs": 1417000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "小蓝说，当时不光有妈妈、阿姨"
    } ]
  }, {
    "tStartMs": 1419566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "还有姥姥姥爷"
    } ]
  }, {
    "tStartMs": 1421133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "也一起去了"
    } ]
  }, {
    "tStartMs": 1422133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "嗯小蓝回忆到，特别奇怪的一点是"
    } ]
  }, {
    "tStartMs": 1425500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "他们从头到尾碰到了很多事情"
    } ]
  }, {
    "tStartMs": 1428233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "吓成那样"
    } ]
  }, {
    "tStartMs": 1430033,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "但是就好像被隔离在"
    } ]
  }, {
    "tStartMs": 1433166,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "自己那间出事的宾馆一样"
    } ]
  }, {
    "tStartMs": 1434600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就感觉好像只有"
    } ]
  }, {
    "tStartMs": 1437100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "小蓝、妈妈还有阿姨这三个人来旅游了"
    } ]
  }, {
    "tStartMs": 1440000,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "根本没有姥姥姥爷一起来"
    } ]
  }, {
    "tStartMs": 1442833,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "所以姥姥姥​​爷是没有发生这个事是吧"
    } ]
  }, {
    "tStartMs": 1445333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "对！他们在一起玩了"
    } ]
  }, {
    "tStartMs": 1447400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "但是没有遇到怪事"
    } ]
  }, {
    "tStartMs": 1449500,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1450166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "是的。小蓝这里补充啊"
    } ]
  }, {
    "tStartMs": 1452100,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "自己家里面比较信这些"
    } ]
  }, {
    "tStartMs": 1454733,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以也经常能碰到灵异事件"
    } ]
  }, {
    "tStartMs": 1457766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "包括自己和妈妈"
    } ]
  }, {
    "tStartMs": 1459400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "从小就能看见遇见这些事情"
    } ]
  }, {
    "tStartMs": 1462533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "然后小蓝说啊"
    } ]
  }, {
    "tStartMs": 1464966,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "妈妈和同行的阿姨都已经皈依了"
    } ]
  }, {
    "tStartMs": 1468333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "会经常去寺庙里面做法事"
    } ]
  }, {
    "tStartMs": 1471000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也捐了不少香火钱，很虔诚"
    } ]
  }, {
    "tStartMs": 1473733,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "并且啊每天都会诵经"
    } ]
  }, {
    "tStartMs": 1476833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "小蓝小时候呢"
    } ]
  }, {
    "tStartMs": 1477900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "也经常跟着家里人去寺庙里面玩"
    } ]
  }, {
    "tStartMs": 1480933,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "可以说呢"
    } ]
  }, {
    "tStartMs": 1481600,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "他们一家子呢"
    } ]
  }, {
    "tStartMs": 1482500,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "都是那种灵感比较强的人"
    } ]
  }, {
    "tStartMs": 1484633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "下面进入正题"
    } ]
  }, {
    "tStartMs": 1487233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "小蓝一行人大概晚上8点多吃完团餐"
    } ]
  }, {
    "tStartMs": 1491000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "买了点啤酒鸭货什么的"
    } ]
  }, {
    "tStartMs": 1493100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "就准备回屋边聊天边吃"
    } ]
  }, {
    "tStartMs": 1496100,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "小蓝说"
    } ]
  }, {
    "tStartMs": 1496600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "他们第一天晚上住的那个酒店啊"
    } ]
  }, {
    "tStartMs": 1499733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "一进房间门"
    } ]
  }, {
    "tStartMs": 1501366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "小蓝就觉得有点害怕"
    } ]
  }, {
    "tStartMs": 1504400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "瘮得慌。但当时没多想"
    } ]
  }, {
    "tStartMs": 1506800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "觉得可能就是自己恐怖故事"
    } ]
  }, {
    "tStartMs": 1509166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "恐怖电影看多了"
    } ]
  }, {
    "tStartMs": 1511200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "加上晚上入住酒店，就自己吓自己"
    } ]
  }, {
    "tStartMs": 1514633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "小蓝说自己是个"
    } ]
  }, {
    "tStartMs": 1516766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "重度恐怖爱好者啊"
    } ]
  }, {
    "tStartMs": 1518100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是小说电影什么都看"
    } ]
  }, {
    "tStartMs": 1520400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "甚至这个行程里面啊"
    } ]
  }, {
    "tStartMs": 1522800,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "自己还带了一本恐怖小说在身上"
    } ]
  }, {
    "tStartMs": 1525600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "那真的是重度爱好者对"
    } ]
  }, {
    "tStartMs": 1528033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "收拾了一下行李"
    } ]
  }, {
    "tStartMs": 1529700,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "妈妈和阿姨就坐在右边的靠窗户的"
    } ]
  }, {
    "tStartMs": 1533766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "床上聊天"
    } ]
  }, {
    "tStartMs": 1534700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "小蓝跟我说，妈妈其实呢"
    } ]
  }, {
    "tStartMs": 1537433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她自己也会看一些这些事情"
    } ]
  }, {
    "tStartMs": 1540000,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "所以她和阿姨两人聊着聊着"
    } ]
  }, {
    "tStartMs": 1543133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "话题就偏向了那个方向啊"
    } ]
  }, {
    "tStartMs": 1545900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "对啊，就跟我们俩一样"
    } ]
  }, {
    "tStartMs": 1548366,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是我觉得好像长辈一般都不太喜欢"
    } ]
  }, {
    "tStartMs": 1550833,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "但他们信这个"
    } ]
  }, {
    "tStartMs": 1552566,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "而且可能自身也有懂一点这个"
    } ]
  }, {
    "tStartMs": 1556100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1557000,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "主要阿姨就问嘛，就问他妈妈说"
    } ]
  }, {
    "tStartMs": 1561200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "阿姨的爸爸最近身体各方面有点不好"
    } ]
  }, {
    "tStartMs": 1565533,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "而且也不顺"
    } ]
  }, {
    "tStartMs": 1566766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是不是招惹了一些不干净的东西啊"
    } ]
  }, {
    "tStartMs": 1569766,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "小蓝妈妈就和阿姨就分析了一阵子啊"
    } ]
  }, {
    "tStartMs": 1573200,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "就说，确实可能是有东西缠着他爸爸了"
    } ]
  }, {
    "tStartMs": 1576366,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "嗯可以去庙里面做一下法事什么的"
    } ]
  }, {
    "tStartMs": 1579100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "嗯两人聊着聊着聊着也很开心"
    } ]
  }, {
    "tStartMs": 1582033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就举起酒杯碰了一下"
    } ]
  }, {
    "tStartMs": 1583833,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小蓝妈妈在仰头喝酒的时候"
    } ]
  }, {
    "tStartMs": 1586700,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "余光往下扫了一下"
    } ]
  }, {
    "tStartMs": 1589100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "发现有个女的趴在她的脚边"
    } ]
  }, {
    "tStartMs": 1591500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "就在两床之间过道里面"
    } ]
  }, {
    "tStartMs": 1595133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "据他妈妈后来说啊"
    } ]
  }, {
    "tStartMs": 1596633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "也不是一个传统的贞子形象"
    } ]
  }, {
    "tStartMs": 1599366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是个短发啊"
    } ]
  }, {
    "tStartMs": 1601166,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "头发呢垂到耳朵下面，有很小很小的卷"
    } ]
  }, {
    "tStartMs": 1605166,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "头发是湿的还滴着水"
    } ]
  }, {
    "tStartMs": 1607833,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1609333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "身上穿的是那种白色的睡裙啊"
    } ]
  }, {
    "tStartMs": 1612033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "朝着小蓝的妈妈咧开嘴笑"
    } ]
  }, {
    "tStartMs": 1615300,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1615933,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "嘴里布满了细细密密的小尖牙"
    } ]
  }, {
    "tStartMs": 1619166,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "特别特别尖"
    } ]
  }, {
    "tStartMs": 1620600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "描述的好细啊"
    } ]
  }, {
    "tStartMs": 1622400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "对！满嘴都是黑色的"
    } ]
  }, {
    "tStartMs": 1624900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "后面小蓝妈妈猜测啊"
    } ]
  }, {
    "tStartMs": 1627100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "就可能是干掉的x液……就变黑了"
    } ]
  }, {
    "tStartMs": 1629800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1631033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小蓝他妈妈很……"
    } ]
  }, {
    "tStartMs": 1633533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这个，这个实在是太顶了"
    } ]
  }, {
    "tStartMs": 1636233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "是的。接着小蓝妈妈呢就看向阿姨了"
    } ]
  }, {
    "tStartMs": 1639900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就心里琢磨说"
    } ]
  }, {
    "tStartMs": 1642033,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "是不是阿姨也能看见"
    } ]
  }, {
    "tStartMs": 1644766,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "阿姨看见小蓝妈妈僵在那了"
    } ]
  }, {
    "tStartMs": 1647433,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1648000,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "自己也可能感觉不对劲，也不敢动了"
    } ]
  }, {
    "tStartMs": 1650833,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "妈妈呢就一直盯在下面"
    } ]
  }, {
    "tStartMs": 1653200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "足足盯了两分钟"
    } ]
  }, {
    "tStartMs": 1655200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "阿姨一直问小蓝妈妈：怎么了怎么了"
    } ]
  }, {
    "tStartMs": 1657700,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "妈妈就用眼神示意阿姨，你看床下没"
    } ]
  }, {
    "tStartMs": 1660633,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "阿姨不敢说话"
    } ]
  }, {
    "tStartMs": 1661400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "妈妈也不敢说话。对"
    } ]
  }, {
    "tStartMs": 1663700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "阿姨虽然看不见啊"
    } ]
  }, {
    "tStartMs": 1665000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "但是这时候已经完全就懂了"
    } ]
  }, {
    "tStartMs": 1667900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "两个人也不敢继续喝酒了"
    } ]
  }, {
    "tStartMs": 1669933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "嗯转头赶紧起来收拾东西"
    } ]
  }, {
    "tStartMs": 1672300,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "再一看呢"
    } ]
  }, {
    "tStartMs": 1673366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "幸好这女的是不见了啊"
    } ]
  }, {
    "tStartMs": 1675300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1676833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "接着呢"
    } ]
  }, {
    "tStartMs": 1677833,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "赶紧把今天数量的经文，给述掉了"
    } ]
  }, {
    "tStartMs": 1681100,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1681766,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "小蓝则在左边靠厕所床上，看着自己的"
    } ]
  }, {
    "tStartMs": 1685100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "恐怖小说"
    } ]
  }, {
    "tStartMs": 1686433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "等于小蓝全程就没有参与进来"
    } ]
  }, {
    "tStartMs": 1689733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "后面是被妈妈……应该是被妈妈告诉的"
    } ]
  }, {
    "tStartMs": 1692500,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "告诉他了"
    } ]
  }, {
    "tStartMs": 1694300,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "小蓝说呢"
    } ]
  }, {
    "tStartMs": 1695333,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "当时自己看不见那东西啊"
    } ]
  }, {
    "tStartMs": 1697566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "也没注意到她俩刚刚发生了什么"
    } ]
  }, {
    "tStartMs": 1700900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "但是，心里是有一点毛毛的"
    } ]
  }, {
    "tStartMs": 1704000,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "不知道怎么形容"
    } ]
  }, {
    "tStartMs": 1705400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "感觉自己的汗毛，都竖起来了"
    } ]
  }, {
    "tStartMs": 1709333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "但是那会"
    } ]
  }, {
    "tStartMs": 1710133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "小蓝觉得，可能是自己看小说看的"
    } ]
  }, {
    "tStartMs": 1712700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "然后自己吓自己"
    } ]
  }, {
    "tStartMs": 1714333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "转头就爬向妈妈她们床上去了"
    } ]
  }, {
    "tStartMs": 1717133,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1717833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "11点多小蓝准备去洗漱了"
    } ]
  }, {
    "tStartMs": 1720433,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "突然一股莫名的恐​​惧涌上来了"
    } ]
  }, {
    "tStartMs": 1724566,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "就喊妈妈陪着自己"
    } ]
  }, {
    "tStartMs": 1727300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "小蓝跟我说啊，他自己胆子"
    } ]
  }, {
    "tStartMs": 1729800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "因为刚才不是说他喜欢这些东西吗"
    } ]
  }, {
    "tStartMs": 1732300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "然后他胆子也很大"
    } ]
  }, {
    "tStartMs": 1734900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "玩鬼屋都是坦克位的"
    } ]
  }, {
    "tStartMs": 1736600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1738100,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "然后他就和妈妈两人挤进厕所里面"
    } ]
  }, {
    "tStartMs": 1740633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "准备洗漱了嘛"
    } ]
  }, {
    "tStartMs": 1741600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "嗯让妈妈陪"
    } ]
  }, {
    "tStartMs": 1742833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "结果阿姨也跟进来了"
    } ]
  }, {
    "tStartMs": 1744500,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "说我自己不敢一个人在外面"
    } ]
  }, {
    "tStartMs": 1746766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "呆着"
    } ]
  }, {
    "tStartMs": 1747700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就三个人在一个小厕所里面，开始洗漱"
    } ]
  }, {
    "tStartMs": 1750966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "小蓝说当时自己全程都很警觉"
    } ]
  }, {
    "tStartMs": 1753766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "不知道为什么"
    } ]
  }, {
    "tStartMs": 1754700,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "眼睛一直在镜子和厕所门口来回扫"
    } ]
  }, {
    "tStartMs": 1758433,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "时不时还往床那边看"
    } ]
  }, {
    "tStartMs": 1760733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "阿姨也是靠在门框上"
    } ]
  }, {
    "tStartMs": 1762966,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "同时盯着厕所和房间"
    } ]
  }, {
    "tStartMs": 1765300,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1765833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就好像怕一眼没注意啊"
    } ]
  }, {
    "tStartMs": 1767933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "屋子里面就多了什么东西"
    } ]
  }, {
    "tStartMs": 1769766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "或者人出来一样"
    } ]
  }, {
    "tStartMs": 1770933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1771766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "洗漱完毕"
    } ]
  }, {
    "tStartMs": 1772900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "三人准备全部挤在靠窗的那张床上睡"
    } ]
  }, {
    "tStartMs": 1776400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "小蓝说自己睡眠质量很好"
    } ]
  }, {
    "tStartMs": 1779366,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "虽然有点害怕，但是没一会就睡着了"
    } ]
  }, {
    "tStartMs": 1783200,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "妈妈在心里一直念着经，也睡着了"
    } ]
  }, {
    "tStartMs": 1787700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这下就剩阿姨了"
    } ]
  }, {
    "tStartMs": 1789400,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这下阿姨彻底失眠了"
    } ]
  }, {
    "tStartMs": 1791100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "落单了。对"
    } ]
  }, {
    "tStartMs": 1793300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "3点左右啊"
    } ]
  }, {
    "tStartMs": 1794733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "小蓝被阿姨晃了晃"
    } ]
  }, {
    "tStartMs": 1796733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "阿姨用手机给小蓝打字"
    } ]
  }, {
    "tStartMs": 1799333,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "可能怕吵醒妈妈"
    } ]
  }, {
    "tStartMs": 1800400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1801600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你听见什么声音没有"
    } ]
  }, {
    "tStartMs": 1803333,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "小蓝刚想拿起手机问她说听什么"
    } ]
  }, {
    "tStartMs": 1806900,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "就听见「哒哒哒」敲玻璃的声音"
    } ]
  }, {
    "tStartMs": 1810966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "我还以为滴水声音呢"
    } ]
  }, {
    "tStartMs": 1813600,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "你这个……你好可怕，你这个点太过分了"
    } ]
  }, {
    "tStartMs": 1817833,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "其实我听到这"
    } ]
  }, {
    "tStartMs": 1821366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我就一直有一个想法就是"
    } ]
  }, {
    "tStartMs": 1823333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "既然他们发现了这有这个房间不对"
    } ]
  }, {
    "tStartMs": 1825733,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "走啊或者换呀"
    } ]
  }, {
    "tStartMs": 1828100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "可能"
    } ]
  }, {
    "tStartMs": 1830200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "有一点，自己懂点这个……"
    } ]
  }, {
    "tStartMs": 1832400,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "我也想"
    } ]
  }, {
    "tStartMs": 1832900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "而且他们就是皈依佛教了嘛"
    } ]
  }, {
    "tStartMs": 1835833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "也念了经文什么的"
    } ]
  }, {
    "tStartMs": 1837033,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "就不怵这些东西"
    } ]
  }, {
    "tStartMs": 1838100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我们继续往下听啊"
    } ]
  }, {
    "tStartMs": 1842366,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "小蓝回忆啊，当晚窗户是拉着窗帘的"
    } ]
  }, {
    "tStartMs": 1846233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "所以这个「哒哒哒」的声音啊"
    } ]
  }, {
    "tStartMs": 1848200,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "不知道是窗户外面有东西在敲"
    } ]
  }, {
    "tStartMs": 1850800,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "嗯还是说，有东西藏在窗帘和窗户中间"
    } ]
  }, {
    "tStartMs": 1854366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我去……这个好恐怖"
    } ]
  }, {
    "tStartMs": 1856333,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "对吧！小蓝和阿姨吓得够呛"
    } ]
  }, {
    "tStartMs": 1859233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但是最后实在是撑不过困意"
    } ]
  }, {
    "tStartMs": 1862400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "毕竟头一天，舟车劳顿的，还是睡着了"
    } ]
  }, {
    "tStartMs": 1865966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "就没管那个「哒哒哒」了"
    } ]
  }, {
    "tStartMs": 1869200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "第二天早上6点钟起来"
    } ]
  }, {
    "tStartMs": 1870800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "一行人集合就去景点玩了"
    } ]
  }, {
    "tStartMs": 1873233,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "小蓝虽然困得要死啊"
    } ]
  }, {
    "tStartMs": 1875366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "黑眼圈都快挂地上了"
    } ]
  }, {
    "tStartMs": 1877133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "但是因为离开这个酒店了"
    } ]
  }, {
    "tStartMs": 1879366,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "那天白天玩起来心情还是不错的"
    } ]
  }, {
    "tStartMs": 1882166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1883000,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "但是小蓝后面才知道，这才是个开始"
    } ]
  }, {
    "tStartMs": 1886700,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "那东西一直跟着他们"
    } ]
  }, {
    "tStartMs": 1889300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "第二晚"
    } ]
  }, {
    "tStartMs": 1890133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小蓝一行人入住了第二家酒店"
    } ]
  }, {
    "tStartMs": 1892766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "它这里有布局图啊"
    } ]
  }, {
    "tStartMs": 1894566,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "他后面第一家酒店"
    } ]
  }, {
    "tStartMs": 1896533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "第二家酒店都有布局图"
    } ]
  }, {
    "tStartMs": 1898033,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我们会贴在动态，好的"
    } ]
  }, {
    "tStartMs": 1900533,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "然后b站会放在视频里面"
    } ]
  }, {
    "tStartMs": 1903100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好嘞"
    } ]
  }, {
    "tStartMs": 1904800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "小蓝说自己不懂风水"
    } ]
  }, {
    "tStartMs": 1906733,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1907133,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "但是就是觉得这第二家酒店的屋子"
    } ]
  }, {
    "tStartMs": 1909966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "格局特别奇怪"
    } ]
  }, {
    "tStartMs": 1911566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "厕所超级大"
    } ]
  }, {
    "tStartMs": 1913566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "就和你刚才第一个故事一样"
    } ]
  }, {
    "tStartMs": 1915500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1916533,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那个厕所呢"
    } ]
  }, {
    "tStartMs": 1917733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "甚至是比外面卧室区域还要大"
    } ]
  }, {
    "tStartMs": 1920700,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "这么夸张"
    } ]
  }, {
    "tStartMs": 1921366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "对。而且厕所门一开"
    } ]
  }, {
    "tStartMs": 1923633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "洗漱台上的大镜子正对床位"
    } ]
  }, {
    "tStartMs": 1927233,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小蓝说自己也是胆肥"
    } ]
  }, {
    "tStartMs": 1929233,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "嗯当晚入住后，接着看恐怖小说"
    } ]
  }, {
    "tStartMs": 1932833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "哈哈哈！这是"
    } ]
  }, {
    "tStartMs": 1935133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "不是一般人啊"
    } ]
  }, {
    "tStartMs": 1935966,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不是一般人。太喜欢这个啊"
    } ]
  }, {
    "tStartMs": 1939200,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但是这次没看几页自己就不行了"
    } ]
  }, {
    "tStartMs": 1941800,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "嗯直接把书的封面扯下来了"
    } ]
  }, {
    "tStartMs": 1944433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "撕碎扔到垃圾桶里"
    } ]
  }, {
    "tStartMs": 1946600,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "小蓝开始觉得那个封面极其的恐怖"
    } ]
  }, {
    "tStartMs": 1949900,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "小蓝说其实后面看起来"
    } ]
  }, {
    "tStartMs": 1951533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "那本书封面还是挺正常的"
    } ]
  }, {
    "tStartMs": 1953900,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "书名，他也说了叫《14年猎鬼人》"
    } ]
  }, {
    "tStartMs": 1957766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "绿色的那本"
    } ]
  }, {
    "tStartMs": 1958700,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "听过。我听过就是说名字"
    } ]
  }, {
    "tStartMs": 1960566,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "撕完书以后一切就不对了"
    } ]
  }, {
    "tStartMs": 1963933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小蓝跟妈妈她们说"
    } ]
  }, {
    "tStartMs": 1965533,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "厕所门必须要打开，不能关上"
    } ]
  }, {
    "tStartMs": 1967933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "只要一关上嗯"
    } ]
  }, {
    "tStartMs": 1969600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我就觉得里面有人，隔着门站那看自己"
    } ]
  }, {
    "tStartMs": 1974133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1975000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "必须要开着门，开着灯，看着那镜子"
    } ]
  }, {
    "tStartMs": 1977533,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "这天晚上刚开始小蓝他们也是"
    } ]
  }, {
    "tStartMs": 1980900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "也没看见什么不好东西啊"
    } ]
  }, {
    "tStartMs": 1982566,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "嗯但就是莫名的恐惧"
    } ]
  }, {
    "tStartMs": 1984733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "就感觉自己要崩溃了"
    } ]
  }, {
    "tStartMs": 1986200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "控制不住害怕"
    } ]
  }, {
    "tStartMs": 1987933,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小蓝的妈妈呢"
    } ]
  }, {
    "tStartMs": 1989033,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "第一天晚上即使是真的看到东西了"
    } ]
  }, {
    "tStartMs": 1992133,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "一直也是比较淡定的"
    } ]
  }, {
    "tStartMs": 1994233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但是到今天这个第二个晚上"
    } ]
  }, {
    "tStartMs": 1996833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "嗯他也快扛不住了"
    } ]
  }, {
    "tStartMs": 1998800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "妈妈和小蓝和阿姨说啊"
    } ]
  }, {
    "tStartMs": 2001133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "晚上用手机放着诵经的声音睡觉"
    } ]
  }, {
    "tStartMs": 2004333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "不然一定会出事"
    } ]
  }, {
    "tStartMs": 2005900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2007733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "妈妈和阿姨两个人啊"
    } ]
  }, {
    "tStartMs": 2008933,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "甚至给寺庙的师傅"
    } ]
  }, {
    "tStartMs": 2010433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "和一个会看事的大姨打个电话"
    } ]
  }, {
    "tStartMs": 2012933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "但是可惜是没打通"
    } ]
  }, {
    "tStartMs": 2014966,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "师傅的和大姨都没打通？对"
    } ]
  }, {
    "tStartMs": 2017966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "没办法"
    } ]
  }, {
    "tStartMs": 2019333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "三个人只能硬着头皮睡了"
    } ]
  }, {
    "tStartMs": 2021300,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "这次小蓝他们学聪明了"
    } ]
  }, {
    "tStartMs": 2023333,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "直接把行李堆在另一张床上"
    } ]
  }, {
    "tStartMs": 2026133,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "三个人就是挤在一张床上"
    } ]
  }, {
    "tStartMs": 2028033,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "也不聊天了"
    } ]
  }, {
    "tStartMs": 2029233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "直接酝酿睡意"
    } ]
  }, {
    "tStartMs": 2030633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "就不走流程，直接睡觉"
    } ]
  }, {
    "tStartMs": 2033166,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "手里的诵经"
    } ]
  }, {
    "tStartMs": 2034433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "诵经的声音啊放的很大"
    } ]
  }, {
    "tStartMs": 2036200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "确实是有一点效果"
    } ]
  }, {
    "tStartMs": 2037833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "三个人很快就睡着了"
    } ]
  }, {
    "tStartMs": 2039733,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "小蓝说"
    } ]
  }, {
    "tStartMs": 2040966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "自己是那种一觉睡到天亮的人啊"
    } ]
  }, {
    "tStartMs": 2043966,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但是那天晚上小蓝半夜被冻醒"
    } ]
  }, {
    "tStartMs": 2047400,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "小蓝说真的很冷"
    } ]
  }, {
    "tStartMs": 2049166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "抬头看看呢"
    } ]
  }, {
    "tStartMs": 2050500,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "空调他们开的是暖风"
    } ]
  }, {
    "tStartMs": 2053366,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "而且是8月份"
    } ]
  }, {
    "tStartMs": 2054733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "三人穿着不薄的衣服"
    } ]
  }, {
    "tStartMs": 2056333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "挤在一个厚被子里面"
    } ]
  }, {
    "tStartMs": 2057600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "按小蓝的话说"
    } ]
  }, {
    "tStartMs": 2058833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "不热死就算好的了"
    } ]
  }, {
    "tStartMs": 2060500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2061500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "自己居然是被冻醒了"
    } ]
  }, {
    "tStartMs": 2063300,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "是那种刺的慌的冷"
    } ]
  }, {
    "tStartMs": 2065566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "小蓝突然觉得，哪里有点不对劲"
    } ]
  }, {
    "tStartMs": 2068966,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "但是一时半会不知道哪里出了问题"
    } ]
  }, {
    "tStartMs": 2071600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "山里面窗户打开比较冷"
    } ]
  }, {
    "tStartMs": 2073533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "不是，你听啊"
    } ]
  }, {
    "tStartMs": 2075233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "想了会明白过来"
    } ]
  }, {
    "tStartMs": 2077200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "环境太安静了"
    } ]
  }, {
    "tStartMs": 2079133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "诵经的声音停了"
    } ]
  }, {
    "tStartMs": 2081000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "经文声没了？对"
    } ]
  }, {
    "tStartMs": 2082400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "小蓝不知道（诵经）是什么时候停下来的"
    } ]
  }, {
    "tStartMs": 2085133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "也不敢把手从被子里面伸出来"
    } ]
  }, {
    "tStartMs": 2087300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "去拿手机"
    } ]
  }, {
    "tStartMs": 2088166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "但是那个手机"
    } ]
  }, {
    "tStartMs": 2089700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "设置的是不会熄屏的"
    } ]
  }, {
    "tStartMs": 2091233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "而且一直充着电"
    } ]
  }, {
    "tStartMs": 2093200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "没人动它绝对不会停的"
    } ]
  }, {
    "tStartMs": 2095000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小蓝这下真的毛了"
    } ]
  }, {
    "tStartMs": 2097100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "推了推妈妈和阿姨"
    } ]
  }, {
    "tStartMs": 2098600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "谁也没醒"
    } ]
  }, {
    "tStartMs": 2100566,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "就这个晚上轮到小蓝遭殃了"
    } ]
  }, {
    "tStartMs": 2103100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "独自恐怖。对"
    } ]
  }, {
    "tStartMs": 2105000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "厕所门还是没关，还开着的"
    } ]
  }, {
    "tStartMs": 2107566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2108733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "小蓝跟我说，不知道当时自己怎么想的"
    } ]
  }, {
    "tStartMs": 2111933,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "真的很欠"
    } ]
  }, {
    "tStartMs": 2113200,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "稍微抬起点身子"
    } ]
  }, {
    "tStartMs": 2115433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "想去看看厕所里面的镜子"
    } ]
  }, {
    "tStartMs": 2117400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "小蓝说真的"
    } ]
  }, {
    "tStartMs": 2119600,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "那一眼之后啊，自己肠子都悔青了"
    } ]
  }, {
    "tStartMs": 2122366,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2122833,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "那个女g"
    } ]
  }, {
    "tStartMs": 2124400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "在镜子里面扒着门框"
    } ]
  }, {
    "tStartMs": 2126400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "看着他们三个人睡觉"
    } ]
  }, {
    "tStartMs": 2127800,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我去！就像那种捉迷藏的小孩子"
    } ]
  }, {
    "tStartMs": 2131133,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "身子在厕所里面，歪着头探了出来"
    } ]
  }, {
    "tStartMs": 2135000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "小蓝整个人都不敢动了……也不敢呼吸……"
    } ]
  }, {
    "tStartMs": 2137633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "我去！一点点的躺回被窝里面"
    } ]
  }, {
    "tStartMs": 2140166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "整个人都僵直了"
    } ]
  }, {
    "tStartMs": 2141733,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小蓝当晚是一宿没睡"
    } ]
  }, {
    "tStartMs": 2144100,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "一直熬到了天亮"
    } ]
  }, {
    "tStartMs": 2146766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "你知道我想到什么吗"
    } ]
  }, {
    "tStartMs": 2148200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是我想到，这个女g"
    } ]
  }, {
    "tStartMs": 2150400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是不是他第一个故事床下的那个女g"
    } ]
  }, {
    "tStartMs": 2153700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "是一个女g"
    } ]
  }, {
    "tStartMs": 2155166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "对呀！你想啥呢"
    } ]
  }, {
    "tStartMs": 2156533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "而且那个女g，我跟你讲"
    } ]
  }, {
    "tStartMs": 2157900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "你刚刚跟我讲完之后"
    } ]
  }, {
    "tStartMs": 2159166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "我脑补的是什么"
    } ]
  }, {
    "tStartMs": 2160333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "是伊藤润二的有一个漫画"
    } ]
  }, {
    "tStartMs": 2162400,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "嗯讲的是一群人请了一个模特到"
    } ]
  }, {
    "tStartMs": 2165800,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "森林里面拍东西"
    } ]
  }, {
    "tStartMs": 2166933,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然后那个模特"
    } ]
  }, {
    "tStartMs": 2167833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "长得就跟你形容的一模一样"
    } ]
  }, {
    "tStartMs": 2169366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "哦……我好像看过那个满嘴"
    } ]
  }, {
    "tStartMs": 2171100,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "尖牙"
    } ]
  }, {
    "tStartMs": 2171433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "对，我看我第一反应好像也是她"
    } ]
  }, {
    "tStartMs": 2173733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我看过那个解析的，就是对短片解析"
    } ]
  }, {
    "tStartMs": 2176600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "到时候叫阿伟把这个配在里面"
    } ]
  }, {
    "tStartMs": 2178833,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "太可怕了"
    } ]
  }, {
    "tStartMs": 2180366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我穿着背心，吹着空调"
    } ]
  }, {
    "tStartMs": 2182033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我也有点冷……"
    } ]
  }, {
    "tStartMs": 2183800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我刚才起鸡皮疙瘩"
    } ]
  }, {
    "tStartMs": 2185033,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然后你发现，其实今天我没有录音"
    } ]
  }, {
    "tStartMs": 2187166,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "你手机上突然收了个短信："
    } ]
  }, {
    "tStartMs": 2189500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "妙妙今天我们录音吧！"
    } ]
  }, {
    "tStartMs": 2190700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你别放屁啊！"
    } ]
  }, {
    "tStartMs": 2192133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "好，我们继续啊"
    } ]
  }, {
    "tStartMs": 2193200,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "第三天小蓝一行人"
    } ]
  }, {
    "tStartMs": 2196700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "住回了第一天的酒店"
    } ]
  }, {
    "tStartMs": 2198200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2199033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "但是，还好是不同房间啊"
    } ]
  }, {
    "tStartMs": 2201300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "这边依然是有布局图"
    } ]
  }, {
    "tStartMs": 2203366,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "嗯小蓝他们玩了一天啊"
    } ]
  }, {
    "tStartMs": 2205433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "晚上回到酒店就开始洗漱"
    } ]
  }, {
    "tStartMs": 2207400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "妈妈陪着小蓝和阿姨洗漱完以后啊"
    } ]
  }, {
    "tStartMs": 2210366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "自己是最后洗的"
    } ]
  }, {
    "tStartMs": 2212000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "洗完之后坐在床边吹头发"
    } ]
  }, {
    "tStartMs": 2214933,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "此处有插图 "
    } ]
  }, {
    "tStartMs": 2216966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "有位置插图"
    } ]
  }, {
    "tStartMs": 2218933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "妈妈是低着头吹头发的"
    } ]
  }, {
    "tStartMs": 2221533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "因为小蓝他们一晚上都在聊天"
    } ]
  }, {
    "tStartMs": 2224566,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "所以电视一直没开，是熄屏的状态嗯"
    } ]
  }, {
    "tStartMs": 2228333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小蓝妈妈吹着吹着"
    } ]
  }, {
    "tStartMs": 2229900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "就从吹起头发缝隙中"
    } ]
  }, {
    "tStartMs": 2232100,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "朝前看正好看到电视"
    } ]
  }, {
    "tStartMs": 2234433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "因为电视黑屏是会反光的吗"
    } ]
  }, {
    "tStartMs": 2236533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "就从那模模糊糊的反光里"
    } ]
  }, {
    "tStartMs": 2239000,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "隐约看到自己身后，就坐着那个女的"
    } ]
  }, {
    "tStartMs": 2243333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "白衣服，一只腿放床上"
    } ]
  }, {
    "tStartMs": 2246100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "另外一只腿，在床底下耷拉着"
    } ]
  }, {
    "tStartMs": 2248700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "还一晃一晃的"
    } ]
  }, {
    "tStartMs": 2250133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2250966,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "据小蓝妈妈事后回忆"
    } ]
  }, {
    "tStartMs": 2255300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "好像这个女鬼"
    } ]
  }, {
    "tStartMs": 2256433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "从头到尾都没有见过她的眼睛"
    } ]
  }, {
    "tStartMs": 2259166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "然后这边标了女鬼的位置"
    } ]
  }, {
    "tStartMs": 2262800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "但是也没有什么好办法啊"
    } ]
  }, {
    "tStartMs": 2264233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "妈妈就硬撑着，把头发吹完了"
    } ]
  }, {
    "tStartMs": 2268366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "一抬头女儿不见了"
    } ]
  }, {
    "tStartMs": 2271000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "小蓝妈妈赶紧把眼睛闭上"
    } ]
  }, {
    "tStartMs": 2272933,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "心里默念阿弥陀佛"
    } ]
  }, {
    "tStartMs": 2275133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "手里攥着脖子上的小牌牌"
    } ]
  }, {
    "tStartMs": 2278133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小蓝说，这其实是小塑料盒子"
    } ]
  }, {
    "tStartMs": 2280600,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "里面装的是金色的，缩印的楞严咒"
    } ]
  }, {
    "tStartMs": 2284733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "在庙里面也开过光的"
    } ]
  }, {
    "tStartMs": 2287600,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "这件事啊"
    } ]
  }, {
    "tStartMs": 2288933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "当晚妈妈没敢跟小蓝他们说"
    } ]
  }, {
    "tStartMs": 2291333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "第二天才告诉他们的"
    } ]
  }, {
    "tStartMs": 2293533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "结果就是，阿姨告诉妈妈"
    } ]
  }, {
    "tStartMs": 2295600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "当时小蓝妈妈站起来后"
    } ]
  }, {
    "tStartMs": 2297566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "那女的就站她身后"
    } ]
  }, {
    "tStartMs": 2299933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "就是和她一起从床上站起来"
    } ]
  }, {
    "tStartMs": 2302233,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2303000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "但是不像是肉眼看见的"
    } ]
  }, {
    "tStartMs": 2304966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "感觉是脑子里面出现的影像"
    } ]
  }, {
    "tStartMs": 2308166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "她们也太……"
    } ]
  }, {
    "tStartMs": 2309333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "三天结束啊"
    } ]
  }, {
    "tStartMs": 2311400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "小蓝回忆这几天是玩也没玩好"
    } ]
  }, {
    "tStartMs": 2314000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "住也没住"
    } ]
  }, {
    "tStartMs": 2315133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "吃也没吃好"
    } ]
  }, {
    "tStartMs": 2316900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "一行人终于呢上了返程的车"
    } ]
  }, {
    "tStartMs": 2319900,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2320533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "妈妈在车上给小蓝的爸爸、舅舅打电话"
    } ]
  }, {
    "tStartMs": 2323933,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "让他们来接站"
    } ]
  }, {
    "tStartMs": 2324933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "按小蓝的话"
    } ]
  }, {
    "tStartMs": 2327366,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "他们可以说是兴致勃勃去"
    } ]
  }, {
    "tStartMs": 2329633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "屁滚尿流的回"
    } ]
  }, {
    "tStartMs": 2331766,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "在车上呢"
    } ]
  }, {
    "tStartMs": 2332633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "是睡了这几天以来最好的一觉"
    } ]
  }, {
    "tStartMs": 2335133,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "下了车小蓝一行，把行李扔上车"
    } ]
  }, {
    "tStartMs": 2338933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "都没敢回家，直接开车去了寺庙"
    } ]
  }, {
    "tStartMs": 2341833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "师傅说问题不大"
    } ]
  }, {
    "tStartMs": 2343966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "磕几个头拜一拜烧个香，就没事了"
    } ]
  }, {
    "tStartMs": 2346366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "回家就行"
    } ]
  }, {
    "tStartMs": 2347233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "然而事情还没有结束"
    } ]
  }, {
    "tStartMs": 2349533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2350166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "是的，跟着来了。对"
    } ]
  }, {
    "tStartMs": 2352733,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "小蓝他没想到那东西一路跟回来了"
    } ]
  }, {
    "tStartMs": 2356566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "跟进了小蓝的家"
    } ]
  }, {
    "tStartMs": 2358166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "小蓝晚上睡觉时"
    } ]
  }, {
    "tStartMs": 2359933,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "一直能听见客厅里有来回走路的声音"
    } ]
  }, {
    "tStartMs": 2363766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "后面开始慢慢的听见有"
    } ]
  }, {
    "tStartMs": 2366233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "有节奏的敲门声"
    } ]
  }, {
    "tStartMs": 2368166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "声音很轻啊"
    } ]
  }, {
    "tStartMs": 2369333,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "但是明显感觉不是在正常的位置敲"
    } ]
  }, {
    "tStartMs": 2372833,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2373133,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "好像是有个人，趴在地上敲门脚的声音"
    } ]
  }, {
    "tStartMs": 2378733,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "第二天早上一起来"
    } ]
  }, {
    "tStartMs": 2380566,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "妈妈就给那个阿姨打电话"
    } ]
  }, {
    "tStartMs": 2382600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "两人第一句话都是"
    } ]
  }, {
    "tStartMs": 2384200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那女的是不是跟回家了"
    } ]
  }, {
    "tStartMs": 2386433,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "就等于说，这个女的，她在小蓝家作祟了"
    } ]
  }, {
    "tStartMs": 2389933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "不是女的，是女g啊"
    } ]
  }, {
    "tStartMs": 2391633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "又到了阿姨家。是的"
    } ]
  }, {
    "tStartMs": 2394300,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "不得已啊"
    } ]
  }, {
    "tStartMs": 2395633,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "小蓝他们又去寺庙，单独找了师傅"
    } ]
  }, {
    "tStartMs": 2398233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "这把就是"
    } ]
  }, {
    "tStartMs": 2400166,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "回来以后发生的事，又和师傅讲明了"
    } ]
  }, {
    "tStartMs": 2403033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "嗯师傅也开始重视起来"
    } ]
  }, {
    "tStartMs": 2405533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "又给三人灌了顶"
    } ]
  }, {
    "tStartMs": 2407500,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "又让他们去寺庙门口土地庙拜了一拜"
    } ]
  }, {
    "tStartMs": 2410766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "据小蓝说"
    } ]
  }, {
    "tStartMs": 2412500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "这个女人之后就再也没有跟到他们了"
    } ]
  }, {
    "tStartMs": 2415333,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "那东西似乎呢，是留在寺庙里面修行了"
    } ]
  }, {
    "tStartMs": 2419033,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2419766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "有个安身的地方"
    } ]
  }, {
    "tStartMs": 2421233,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "后来妈妈和小蓝说啊"
    } ]
  }, {
    "tStartMs": 2422900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "这个女人一开始找上他们"
    } ]
  }, {
    "tStartMs": 2425133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "嗯可能是因为妈妈"
    } ]
  }, {
    "tStartMs": 2426766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "和阿姨在宾馆里面啊"
    } ]
  }, {
    "tStartMs": 2428533,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "就是第一晚在宾馆里面诵经"
    } ]
  }, {
    "tStartMs": 2431200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "包括聊到了一些"
    } ]
  }, {
    "tStartMs": 2432500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "寺庙和灵异有关的事情"
    } ]
  }, {
    "tStartMs": 2434766,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "难怪"
    } ]
  }, {
    "tStartMs": 2435200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "这个女人可能觉得小蓝一行能看到她"
    } ]
  }, {
    "tStartMs": 2438500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "或者有能力帮她"
    } ]
  }, {
    "tStartMs": 2440533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "所以跟上来了"
    } ]
  }, {
    "tStartMs": 2441433,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "对。毕竟从头至尾她虽然是挺吓人"
    } ]
  }, {
    "tStartMs": 2444600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但是没有做出什么伤害性的举动啊"
    } ]
  }, {
    "tStartMs": 2447100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "是的，还好没做过……这个故事"
    } ]
  }, {
    "tStartMs": 2449566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "其实"
    } ]
  }, {
    "tStartMs": 2451400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我改稿子时候，最恐怖的一点就是"
    } ]
  }, {
    "tStartMs": 2455366,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "姥姥姥爷呢？"
    } ]
  }, {
    "tStartMs": 2457133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "哦！是吧！就在故事里面没出现"
    } ]
  }, {
    "tStartMs": 2459200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "对！我反应过来，我赶紧问小蓝"
    } ]
  }, {
    "tStartMs": 2460933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我说他们人呢"
    } ]
  }, {
    "tStartMs": 2462500,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "小蓝说就是，他们完全没事有影响"
    } ]
  }, {
    "tStartMs": 2464966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "几天玩的特别好啊"
    } ]
  }, {
    "tStartMs": 2466433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就没提到他们而已"
    } ]
  }, {
    "tStartMs": 2468233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "就是我给我吓坏了！我真的真的没了……"
    } ]
  }, {
    "tStartMs": 2471633,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "还好啊"
    } ]
  }, {
    "tStartMs": 2472433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那其实你记得吗，我们之前台湾的那个"
    } ]
  }, {
    "tStartMs": 2476500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "懂一些的这个大师"
    } ]
  }, {
    "tStartMs": 2477833,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "嗯也是"
    } ]
  }, {
    "tStartMs": 2478333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "鲶鱼也早，我们最早期的"
    } ]
  }, {
    "tStartMs": 2480133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这个台湾省的粉丝啊"
    } ]
  }, {
    "tStartMs": 2481433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他说"
    } ]
  }, {
    "tStartMs": 2482333,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "往往在寺庙的地方，反而会滋生这些（灵）……"
    } ]
  }, {
    "tStartMs": 2486300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "对对！我记得这些！对吧"
    } ]
  }, {
    "tStartMs": 2487966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "徘徊的灵"
    } ]
  }, {
    "tStartMs": 2489166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "他们想往生之类的。对对对"
    } ]
  }, {
    "tStartMs": 2491966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "但其实又让我想到了一个"
    } ]
  }, {
    "tStartMs": 2493533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是之前，也是咱们的这个焦大师说的"
    } ]
  }, {
    "tStartMs": 2496166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就是说"
    } ]
  }, {
    "tStartMs": 2497600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "灵啊，就这种恶L"
    } ]
  }, {
    "tStartMs": 2498833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "有一点恶的这种灵"
    } ]
  }, {
    "tStartMs": 2500300,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "或者是，不能说恶吧"
    } ]
  }, {
    "tStartMs": 2501733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "就是说，执念很强的灵"
    } ]
  }, {
    "tStartMs": 2504600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "它即便是执念很强"
    } ]
  }, {
    "tStartMs": 2505966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "它也不能离开它埋骨地太远"
    } ]
  }, {
    "tStartMs": 2509233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "有这种设定。对"
    } ]
  }, {
    "tStartMs": 2511033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "所以其实这个灵它跟小蓝来回"
    } ]
  }, {
    "tStartMs": 2514966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "返程而出现"
    } ]
  }, {
    "tStartMs": 2517433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那证明要么就是这个灵"
    } ]
  }, {
    "tStartMs": 2519166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "它的念力真的是很强"
    } ]
  }, {
    "tStartMs": 2521300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "要么就是，小蓝其实离长白山不远"
    } ]
  }, {
    "tStartMs": 2525533,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "嗯。这个我倒是没问他位置啊"
    } ]
  }, {
    "tStartMs": 2528300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小蓝应该东北人"
    } ]
  }, {
    "tStartMs": 2529566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "他的形容有些是东北语气"
    } ]
  }, {
    "tStartMs": 2533133,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这可能是我改成东北语气了"
    } ]
  }, {
    "tStartMs": 2535333,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "你应该"
    } ]
  }, {
    "tStartMs": 2535800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "不知道这个东北语气吧"
    } ]
  }, {
    "tStartMs": 2537333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "啊，是吧。这个我倒是没问啊"
    } ]
  }, {
    "tStartMs": 2539966,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "其实和之前你一个故事里面，叫刘哥的"
    } ]
  }, {
    "tStartMs": 2544033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "好像好多人叫刘哥"
    } ]
  }, {
    "tStartMs": 2545233,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "就那时候是从外地带回来的灵吧"
    } ]
  }, {
    "tStartMs": 2548133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "也是能力很强的一个灵"
    } ]
  }, {
    "tStartMs": 2551533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "你记得吧"
    } ]
  }, {
    "tStartMs": 2552166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "记得，记得，记得"
    } ]
  }, {
    "tStartMs": 2552933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "对，他们出差回来，带回来的"
    } ]
  }, {
    "tStartMs": 2554700,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "是的，是的，是的"
    } ]
  }, {
    "tStartMs": 2556433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "这小蓝跟我讲"
    } ]
  }, {
    "tStartMs": 2558200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "因为他家里面信这个也遇到不少事"
    } ]
  }, {
    "tStartMs": 2561400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "他可能之后也会投更多精彩的故事"
    } ]
  }, {
    "tStartMs": 2564566,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "期待，期待一下"
    } ]
  }, {
    "tStartMs": 2565733,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "好的好的"
    } ]
  }, {
    "tStartMs": 2566366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "反正这个故事到这边。好嘞"
    } ]
  }, {
    "tStartMs": 2572733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "好，今天的第三个故事呢"
    } ]
  }, {
    "tStartMs": 2574100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "来自于我们小红书的鱼友"
    } ]
  }, {
    "tStartMs": 2575533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "皱月"
    } ]
  }, {
    "tStartMs": 2576933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "皱纹的「皱」，月亮的「月」"
    } ]
  }, {
    "tStartMs": 2578533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我们下面称呼她为小月"
    } ]
  }, {
    "tStartMs": 2580566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "小月的故事比较短，但是细思极恐啊"
    } ]
  }, {
    "tStartMs": 2583900,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "那故事发生在去年夏天，就是22年"
    } ]
  }, {
    "tStartMs": 2587366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "大概就是中元节前后"
    } ]
  }, {
    "tStartMs": 2589400,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小月说自己呢"
    } ]
  }, {
    "tStartMs": 2590500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "偶尔会遇到一些灵异事件"
    } ]
  }, {
    "tStartMs": 2592600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "所以对这些事情还是比较在意的"
    } ]
  }, {
    "tStartMs": 2595233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "那特别像是中元节啊"
    } ]
  }, {
    "tStartMs": 2596933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "寒食节这一类的节日啊"
    } ]
  }, {
    "tStartMs": 2598833,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "她都会特别小心"
    } ]
  }, {
    "tStartMs": 2600966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "但今年，因为是她们有一个小组"
    } ]
  }, {
    "tStartMs": 2603200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "作业特别忙"
    } ]
  }, {
    "tStartMs": 2604500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "就没有像往年那么细致"
    } ]
  }, {
    "tStartMs": 2607133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那因为她的疏忽呢"
    } ]
  }, {
    "tStartMs": 2608800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她那天傍晚跟着妈妈出门了"
    } ]
  }, {
    "tStartMs": 2611566,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "小月跟妈妈是准备去姥姥姥爷家嗯"
    } ]
  }, {
    "tStartMs": 2614833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "准备去吃饭的啊"
    } ]
  }, {
    "tStartMs": 2616300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "然后那天呢，当时天色擦黑"
    } ]
  }, {
    "tStartMs": 2619233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "妈妈就骑着电动车带着她"
    } ]
  }, {
    "tStartMs": 2621433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "妈妈可能是比较急着去姥姥家"
    } ]
  }, {
    "tStartMs": 2624033,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "就抄了一条小道，平时不太走的地方"
    } ]
  }, {
    "tStartMs": 2626633,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "小月说呢，那条路啊很小很窄"
    } ]
  }, {
    "tStartMs": 2631400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "虽然谈不上逼仄"
    } ]
  }, {
    "tStartMs": 2633100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "但估计汽车通过是比较勉强的"
    } ]
  }, {
    "tStartMs": 2636300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "路的两边呢是小树林"
    } ]
  }, {
    "tStartMs": 2638700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "感觉有点阴森森的"
    } ]
  }, {
    "tStartMs": 2640300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就在小月百无聊赖的时候啊"
    } ]
  }, {
    "tStartMs": 2643000,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "她突然看到了一座"
    } ]
  }, {
    "tStartMs": 2644566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "新坟嗯"
    } ]
  }, {
    "tStartMs": 2646566,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "她给我说"
    } ]
  }, {
    "tStartMs": 2647166,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "她说"
    } ]
  }, {
    "tStartMs": 2647566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "她第一时间就意识到，那是一个新坟"
    } ]
  }, {
    "tStartMs": 2650133,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "为什么呢"
    } ]
  }, {
    "tStartMs": 2650900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "首先，这个周围一直是没有什么"
    } ]
  }, {
    "tStartMs": 2653133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "坟地或者坟堆的"
    } ]
  }, {
    "tStartMs": 2654766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那突然出现的这一个坟墓"
    } ]
  }, {
    "tStartMs": 2656533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "就显得很突兀"
    } ]
  }, {
    "tStartMs": 2658100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "而且这个坟地上的这个花圈啊"
    } ]
  }, {
    "tStartMs": 2660966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "是看上去就比较新"
    } ]
  }, {
    "tStartMs": 2663300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "那小月还没有反应过来"
    } ]
  }, {
    "tStartMs": 2665300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "又发现了哎"
    } ]
  }, {
    "tStartMs": 2666800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "这个坟边的树上缠着一些红绳"
    } ]
  }, {
    "tStartMs": 2671400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "其实，我这边先补充一下就是"
    } ]
  }, {
    "tStartMs": 2674366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "绑红绳不奇怪"
    } ]
  }, {
    "tStartMs": 2676000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "因为民间有一些说法就是说，在这个"
    } ]
  }, {
    "tStartMs": 2679333,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "祖先坟墓的这个树上绑红尘是"
    } ]
  }, {
    "tStartMs": 2682533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "寓意着把这个灾难绑在野外"
    } ]
  }, {
    "tStartMs": 2685500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "也可以保佑这个子孙后代红红火火"
    } ]
  }, {
    "tStartMs": 2688800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2690100,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那你上坟会绑红绳"
    } ]
  }, {
    "tStartMs": 2692566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我们家族好像没有这个习惯哎"
    } ]
  }, {
    "tStartMs": 2696200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我们家每年啊"
    } ]
  }, {
    "tStartMs": 2697766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "上我爷爷奶奶和外公外婆的时候"
    } ]
  }, {
    "tStartMs": 2700200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "不仅我们自己绑"
    } ]
  }, {
    "tStartMs": 2701366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "我还看到"
    } ]
  }, {
    "tStartMs": 2702400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "就是因为我们是都是南京公墓吗"
    } ]
  }, {
    "tStartMs": 2703966,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2704566,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "会有其他的树上面也会绑"
    } ]
  }, {
    "tStartMs": 2707033,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是吗？我们还真没有这个习惯"
    } ]
  }, {
    "tStartMs": 2710100,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就是可能我们看到的这个"
    } ]
  }, {
    "tStartMs": 2712433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "些许差异。对对对"
    } ]
  }, {
    "tStartMs": 2714833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我们再书归正题"
    } ]
  }, {
    "tStartMs": 2716033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我们回到小月这个故事里面"
    } ]
  }, {
    "tStartMs": 2717733,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "小月投稿里面说啊"
    } ]
  }, {
    "tStartMs": 2718800,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "她说"
    } ]
  }, {
    "tStartMs": 2719200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "其实她看到这个树上的红绳的时候"
    } ]
  }, {
    "tStartMs": 2721700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "自己并没有特别奇怪"
    } ]
  }, {
    "tStartMs": 2723633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但是奇怪的是"
    } ]
  }, {
    "tStartMs": 2725333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她发现这个墓碑上也绑着红绳"
    } ]
  }, {
    "tStartMs": 2728500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "特别是，她妈妈骑车路过的时候"
    } ]
  }, {
    "tStartMs": 2731100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "她回头还瞥了一眼"
    } ]
  }, {
    "tStartMs": 2732900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "她看到这个墓碑正面是红绳"
    } ]
  }, {
    "tStartMs": 2736033,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "背面红绳上竟然挂着几张黄符"
    } ]
  }, {
    "tStartMs": 2740533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "那因为她妈妈骑车的速度比较快"
    } ]
  }, {
    "tStartMs": 2742733,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "没有减速嘛"
    } ]
  }, {
    "tStartMs": 2743600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "嗯所以她并没有看清"
    } ]
  }, {
    "tStartMs": 2745200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "这个上面到底是什么样的符咒"
    } ]
  }, {
    "tStartMs": 2748133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "果然"
    } ]
  }, {
    "tStartMs": 2749000,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "当天晚上回家之后，小月被gyc了"
    } ]
  }, {
    "tStartMs": 2752333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "那gyc的具体的这个情况啊"
    } ]
  }, {
    "tStartMs": 2754166,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "小月也没跟我说"
    } ]
  }, {
    "tStartMs": 2755100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我们就暂时不说了"
    } ]
  }, {
    "tStartMs": 2756300,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "应该跟故事没什么关系"
    } ]
  }, {
    "tStartMs": 2757533,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2758133,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "但小月说她自己家里面是信佛"
    } ]
  }, {
    "tStartMs": 2761600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "所以跟之前都是一样啊"
    } ]
  }, {
    "tStartMs": 2763566,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "她就布置了很多礼佛用的香炉啊"
    } ]
  }, {
    "tStartMs": 2766166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "佛像什么的"
    } ]
  }, {
    "tStartMs": 2767166,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "不知道为什么这样还会被gyc"
    } ]
  }, {
    "tStartMs": 2770300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "然后我就追问她嘛"
    } ]
  }, {
    "tStartMs": 2771500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "我说gyc无所谓"
    } ]
  }, {
    "tStartMs": 2774233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "但是你告诉我大概是什么情况"
    } ]
  }, {
    "tStartMs": 2776233,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "她说自己不是特别清楚了"
    } ]
  }, {
    "tStartMs": 2778166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "细节呢"
    } ]
  }, {
    "tStartMs": 2779800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就是恐怖的细节没有忘记"
    } ]
  }, {
    "tStartMs": 2782033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "就是自己出现这个gyc的这个时间"
    } ]
  }, {
    "tStartMs": 2784966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是出现这个事情之后啊"
    } ]
  }, {
    "tStartMs": 2786900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "时间大概是凌晨3点钟"
    } ]
  }, {
    "tStartMs": 2788933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "嗯他一直试图睁开眼睛"
    } ]
  }, {
    "tStartMs": 2790900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "但是怎么睁都"
    } ]
  }, {
    "tStartMs": 2792000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "没有办法（睁眼），睁不开"
    } ]
  }, {
    "tStartMs": 2792966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2794166,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "突然呢"
    } ]
  }, {
    "tStartMs": 2794733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "她就听到有人在敲自己的卧室门"
    } ]
  }, {
    "tStartMs": 2798166,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "刚开始时「咚咚咚」的敲门声"
    } ]
  }, {
    "tStartMs": 2801333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "随着时间的推移，慢慢的变成了撞门"
    } ]
  }, {
    "tStartMs": 2804400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我靠！小月说啊"
    } ]
  }, {
    "tStartMs": 2806333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "她说自己的门上面"
    } ]
  }, {
    "tStartMs": 2808033,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "有妈妈从寺庙里面求来的开光的符咒"
    } ]
  }, {
    "tStartMs": 2811733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "因为自己之前也会做噩梦"
    } ]
  }, {
    "tStartMs": 2813766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "所以她妈就求了这个符咒"
    } ]
  }, {
    "tStartMs": 2815733,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2816400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "现在感觉这个门，被撞的「嘣嘣嘣」作响"
    } ]
  }, {
    "tStartMs": 2820233,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "她甚至能听到这个符，佛家的符"
    } ]
  }, {
    "tStartMs": 2824500,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "佛咒的这个链子撞在门上的声响"
    } ]
  }, {
    "tStartMs": 2828700,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就说这个东西（符咒）对这个撞门的（阿飘）"
    } ]
  }, {
    "tStartMs": 2830933,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "没有任何影响"
    } ]
  }, {
    "tStartMs": 2832566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "是啊"
    } ]
  }, {
    "tStartMs": 2834133,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小月说时间不知道持续了多久"
    } ]
  }, {
    "tStartMs": 2836500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "她突然就听到哎撞门声停了"
    } ]
  }, {
    "tStartMs": 2838833,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "她能动她就赶紧翻身起床"
    } ]
  }, {
    "tStartMs": 2841200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "一看时间凌晨4点"
    } ]
  }, {
    "tStartMs": 2842900,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "她这个时候就心有余悸"
    } ]
  }, {
    "tStartMs": 2844300,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "完全不敢开门嘛"
    } ]
  }, {
    "tStartMs": 2845533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "啊一直等到日出"
    } ]
  }, {
    "tStartMs": 2847333,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "她赶紧跑出去"
    } ]
  }, {
    "tStartMs": 2848900,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "跑到父母的这个房间"
    } ]
  }, {
    "tStartMs": 2850400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "把她爸妈都叫醒了"
    } ]
  }, {
    "tStartMs": 2851766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "然后就问他们有没有听到"
    } ]
  }, {
    "tStartMs": 2853333,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "昨晚有人敲门"
    } ]
  }, {
    "tStartMs": 2854566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "那爸妈都说没听到"
    } ]
  }, {
    "tStartMs": 2855800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "肯定没听到"
    } ]
  }, {
    "tStartMs": 2856833,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "对，然后故事到这边就结束了哦"
    } ]
  }, {
    "tStartMs": 2860600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "没了。就是个叫"
    } ]
  }, {
    "tStartMs": 2862133,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "这个撞门有点过分了"
    } ]
  }, {
    "tStartMs": 2864233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "是的，是的"
    } ]
  }, {
    "tStartMs": 2865300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "所以其实这个"
    } ]
  }, {
    "tStartMs": 2866366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "乍一听也是个没什么结尾的故事啊"
    } ]
  }, {
    "tStartMs": 2868333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "虎头蛇尾"
    } ]
  }, {
    "tStartMs": 2869333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "但是呢"
    } ]
  }, {
    "tStartMs": 2870300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "也挺好，证明是小月起码是平安的"
    } ]
  }, {
    "tStartMs": 2874300,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "还是我觉得加强一点"
    } ]
  }, {
    "tStartMs": 2877566,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "防御工事"
    } ]
  }, {
    "tStartMs": 2878600,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "要不再多加强点防御工事"
    } ]
  }, {
    "tStartMs": 2882033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我觉得可能是小月她（体质）比较"
    } ]
  }, {
    "tStartMs": 2884033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "敏感，在这个方面"
    } ]
  }, {
    "tStartMs": 2885333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "所以她当时去这个"
    } ]
  }, {
    "tStartMs": 2888033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "她自己平常会注意"
    } ]
  }, {
    "tStartMs": 2889600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "在7月半之前不出去"
    } ]
  }, {
    "tStartMs": 2891100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "但是她这一年，就没办法，忘了啊"
    } ]
  }, {
    "tStartMs": 2895000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就所以才也算巧了吗"
    } ]
  }, {
    "tStartMs": 2896800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "对对对"
    } ]
  }, {
    "tStartMs": 2897533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2898166,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "然后我后面，我也是"
    } ]
  }, {
    "tStartMs": 2900900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "我觉得，确实有点虎头蛇尾嘛"
    } ]
  }, {
    "tStartMs": 2902166,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "我就"
    } ]
  }, {
    "tStartMs": 2902900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "当然，我们祝小月后面也是平平安安的"
    } ]
  }, {
    "tStartMs": 2905700,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2906133,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "虎头蛇尾是好事"
    } ]
  }, {
    "tStartMs": 2907733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "然后我知道大家肯定没听过瘾"
    } ]
  }, {
    "tStartMs": 2909433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "所以我就查了一些"
    } ]
  }, {
    "tStartMs": 2910933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "这个墓碑上，这个符咒的相关的东西啊"
    } ]
  }, {
    "tStartMs": 2913800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "一些资料"
    } ]
  }, {
    "tStartMs": 2914400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "我给大家做一些，比较温柔的解释啊"
    } ]
  }, {
    "tStartMs": 2917633,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "不做这种很（生硬的）……小课堂"
    } ]
  }, {
    "tStartMs": 2920000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "哎，小课堂"
    } ]
  }, {
    "tStartMs": 2921000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "不做那种特别吓人的"
    } ]
  }, {
    "tStartMs": 2922533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我们都上些什么课呀哈哈哈"
    } ]
  }, {
    "tStartMs": 2925566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "首先呢说这个"
    } ]
  }, {
    "tStartMs": 2927300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "红绳和黄符"
    } ]
  }, {
    "tStartMs": 2928766,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "都是民间传统信仰中的东西"
    } ]
  }, {
    "tStartMs": 2931533,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "它（们）是被认为能够辟邪驱鬼的"
    } ]
  }, {
    "tStartMs": 2934833,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 2935900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "它有的时候在一些传统民俗里面"
    } ]
  }, {
    "tStartMs": 2939033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "它是会被用于墓碑之上的"
    } ]
  }, {
    "tStartMs": 2940900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "大家可以不用特别的疑问"
    } ]
  }, {
    "tStartMs": 2943733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "不一定是怪事"
    } ]
  }, {
    "tStartMs": 2945100,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 2945800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "在我们传统文化里面，红色是吉祥"
    } ]
  }, {
    "tStartMs": 2948233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "象征着好运和福气"
    } ]
  }, {
    "tStartMs": 2949966,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2950400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "而黄色则是驱邪避祸的意思"
    } ]
  }, {
    "tStartMs": 2953500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "所以当"
    } ]
  }, {
    "tStartMs": 2955166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "你把这个"
    } ]
  }, {
    "tStartMs": 2956533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "红绳和黄符绑在这个墓碑上的时候"
    } ]
  }, {
    "tStartMs": 2959833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "它是"
    } ]
  }, {
    "tStartMs": 2961400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "旨在是保护墓碑的主人的灵魂"
    } ]
  }, {
    "tStartMs": 2964133,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不受邪罪的侵害"
    } ]
  }, {
    "tStartMs": 2966100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "同时希望他们"
    } ]
  }, {
    "tStartMs": 2967200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "在来世中，获得平安和好运"
    } ]
  }, {
    "tStartMs": 2969966,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "哦！对！所以其实绑这个东西是好事"
    } ]
  }, {
    "tStartMs": 2973533,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "一种祈福"
    } ]
  }, {
    "tStartMs": 2974400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "哎，那也有一些说法，就不一样"
    } ]
  }, {
    "tStartMs": 2978400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "在一些地区呢"
    } ]
  }, {
    "tStartMs": 2979966,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "有的人，这个大家会相信啊"
    } ]
  }, {
    "tStartMs": 2982800,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "绑红绳和黄符，同时绑在墓碑上"
    } ]
  }, {
    "tStartMs": 2985766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是防止这个"
    } ]
  }, {
    "tStartMs": 2988000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "故去的这个人的，魂体离开坟墓"
    } ]
  }, {
    "tStartMs": 2991166,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "因为如果说他过于极端"
    } ]
  }, {
    "tStartMs": 2993633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "或者是生前有过一些"
    } ]
  }, {
    "tStartMs": 2995833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "做过一些不好的事情"
    } ]
  }, {
    "tStartMs": 2997133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "他死后就会变成恶g"
    } ]
  }, {
    "tStartMs": 3000033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "所以通过这个方式呢"
    } ]
  }, {
    "tStartMs": 3001633,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "把他禁锢在坟墓里。两面性"
    } ]
  }, {
    "tStartMs": 3006033,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "理解不一样"
    } ]
  }, {
    "tStartMs": 3007000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我感觉是"
    } ]
  }, {
    "tStartMs": 3008200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "每个地方差异性比较大"
    } ]
  }, {
    "tStartMs": 3011800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "其实我"
    } ]
  }, {
    "tStartMs": 3012733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我做到这，我就突然想到"
    } ]
  }, {
    "tStartMs": 3014433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "你刚才那个故事"
    } ]
  }, {
    "tStartMs": 3015333,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "我应该，以后我都点想让我们"
    } ]
  }, {
    "tStartMs": 3020166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "就是每次每期"
    } ]
  }, {
    "tStartMs": 3021200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我们其实稿子完全不互通的吗"
    } ]
  }, {
    "tStartMs": 3022800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "互通互通"
    } ]
  }, {
    "tStartMs": 3023933,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "因为什么呢"
    } ]
  }, {
    "tStartMs": 3024500,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "因为小叶碰到一个故事啊"
    } ]
  }, {
    "tStartMs": 3026566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "跟你这个特别像，就咱们"
    } ]
  }, {
    "tStartMs": 3028166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就刚才第二个故事吗"
    } ]
  }, {
    "tStartMs": 3029966,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "就咱们团队里面的小叶"
    } ]
  }, {
    "tStartMs": 3032100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "她之前，公司团建啊"
    } ]
  }, {
    "tStartMs": 3034566,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "去了南京周边的一个，我忘记是"
    } ]
  }, {
    "tStartMs": 3038366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "常州"
    } ]
  }, {
    "tStartMs": 3039733,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "还是哪边的一个，很有名的一个度假村"
    } ]
  }, {
    "tStartMs": 3043233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "她碰到这事，类似"
    } ]
  }, {
    "tStartMs": 3045566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "但没有那么邪啊"
    } ]
  }, {
    "tStartMs": 3046800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "没有那么邪，但也挺可怕的"
    } ]
  }, {
    "tStartMs": 3050133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她后来做做措施了吧"
    } ]
  }, {
    "tStartMs": 3052533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "做动作了吧"
    } ]
  }, {
    "tStartMs": 3053433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "没有没有啊……你带她回来做一下"
    } ]
  }, {
    "tStartMs": 3056233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "她回来了吗？"
    } ]
  }, {
    "tStartMs": 3057600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "回来？"
    } ]
  }, {
    "tStartMs": 3058833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "万一带回来东西了呢"
    } ]
  }, {
    "tStartMs": 3060433,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "那，还好没有"
    } ]
  }, {
    "tStartMs": 3061900,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "那还好是吧"
    } ]
  }, {
    "tStartMs": 3062633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "对，因为她（的故事）要排队嘛"
    } ]
  }, {
    "tStartMs": 3064366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "所以他的故事应该理论上也要到等到"
    } ]
  }, {
    "tStartMs": 3066533,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "七八月份"
    } ]
  }, {
    "tStartMs": 3067100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "才能讲。所以正常排队"
    } ]
  }, {
    "tStartMs": 3069533,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "是的，那我今天给大家也做个预告啊"
    } ]
  }, {
    "tStartMs": 3073033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我们后面的鲶鱼呢"
    } ]
  }, {
    "tStartMs": 3074900,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "会做一整期的城市合集"
    } ]
  }, {
    "tStartMs": 3079366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "就像我之前说过的嗯"
    } ]
  }, {
    "tStartMs": 3081000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我们这期节目应该"
    } ]
  }, {
    "tStartMs": 3082933,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是在"
    } ]
  }, {
    "tStartMs": 3084833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "6月的第三或第四"
    } ]
  }, {
    "tStartMs": 3086366,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "应该6月底吧"
    } ]
  }, {
    "tStartMs": 3087533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "6月底发这一期节目"
    } ]
  }, {
    "tStartMs": 3088900,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "大家听到的时候应该是6月底"
    } ]
  }, {
    "tStartMs": 3090366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "那7月份开始呢"
    } ]
  }, {
    "tStartMs": 3092200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我们就会从这个地域开始"
    } ]
  }, {
    "tStartMs": 3094833,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "做这个不同地域的灵异故事"
    } ]
  }, {
    "tStartMs": 3097733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但是大家有一个点我们做的不一样"
    } ]
  }, {
    "tStartMs": 3100233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "因为网上面有很多"
    } ]
  }, {
    "tStartMs": 3102766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "做这个地域灵异的，他们讲的也很传统"
    } ]
  }, {
    "tStartMs": 3105633,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我们就不讲，因为这些都讲过了"
    } ]
  }, {
    "tStartMs": 3107633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我们不讲传统的"
    } ]
  }, {
    "tStartMs": 3109100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我们还是按鲶鱼的风格，我们就用投稿"
    } ]
  }, {
    "tStartMs": 3111900,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 3112500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "那投稿的话呢"
    } ]
  }, {
    "tStartMs": 3113333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "可能它（稿件）的地域色彩没有那么的"
    } ]
  }, {
    "tStartMs": 3116600,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "怎么样……丰满"
    } ]
  }, {
    "tStartMs": 3117733,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "没有那么的，风情（特色）"
    } ]
  }, {
    "tStartMs": 3120633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "对吧，没有那么像那个地方的"
    } ]
  }, {
    "tStartMs": 3122600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "但是呢，贵在一个真实"
    } ]
  }, {
    "tStartMs": 3124833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "对啊，所以给大家预告一下"
    } ]
  }, {
    "tStartMs": 3126966,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "我们第一期就是乌克兰的灵异故事"
    } ]
  }, {
    "tStartMs": 3132366,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "之后呢"
    } ]
  }, {
    "tStartMs": 3133033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你让我怎么做"
    } ]
  }, {
    "tStartMs": 3134733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "你想办法啊"
    } ]
  }, {
    "tStartMs": 3136100,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "哈哈哈？我去哪找乌克兰的？怎么搞"
    } ]
  }, {
    "tStartMs": 3138633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是你"
    } ]
  }, {
    "tStartMs": 3139633,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你可以去乌克兰吗"
    } ]
  }, {
    "tStartMs": 3141100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "现在我不正好吗"
    } ]
  }, {
    "tStartMs": 3142133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "过分了啊"
    } ]
  }, {
    "tStartMs": 3143533,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "那第二期，是广西的鬼故事"
    } ]
  }, {
    "tStartMs": 3146433,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "再往后一期呢是四川的鬼故事"
    } ]
  }, {
    "tStartMs": 3149766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "嗯啊然后再往后就是我们按顺序吧"
    } ]
  }, {
    "tStartMs": 3152800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "一直到新疆西藏我们都准备好了"
    } ]
  }, {
    "tStartMs": 3154800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "嗯好也希望大家期待一下"
    } ]
  }, {
    "tStartMs": 3157133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "那我呢？那我乌克兰怎么办"
    } ]
  }, {
    "tStartMs": 3159166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "哈哈哈你实在不行就算了"
    } ]
  }, {
    "tStartMs": 3160833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "哈哈哈！好好好"
    } ]
  }, {
    "tStartMs": 3162366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "行，好。那今天的故事到这边就结束了"
    } ]
  }, {
    "tStartMs": 3164800,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "如果你有些适合在夜里说的奇事"
    } ]
  }, {
    "tStartMs": 3166633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "和怪事以及邪事"
    } ]
  }, {
    "tStartMs": 3168933,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 3169600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "还有那个乌克兰鱼友记得联系我一下"
    } ]
  }, {
    "tStartMs": 3172433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "就是说，我这边缺篇乌克兰的稿子！哈哈"
    } ]
  }, {
    "tStartMs": 3174966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "好的，好的"
    } ]
  }, {
    "tStartMs": 3175600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "好，那这边就到这边结束了"
    } ]
  }, {
    "tStartMs": 3177166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "如果说你有些适合在夜里说的奇事、"
    } ]
  }, {
    "tStartMs": 3178966,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "怪事、邪事"
    } ]
  }, {
    "tStartMs": 3179566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "欢迎给我们投稿！"
    } ]
  }, {
    "tStartMs": 3180566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "拜拜！拜拜！"
    } ]
  } ]
}
