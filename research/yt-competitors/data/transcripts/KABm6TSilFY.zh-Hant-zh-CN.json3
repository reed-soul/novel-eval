{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 3333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "請大家在看影片之前點讚護體"
    } ]
  }, {
    "tStartMs": 15300,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "歡迎收聽"
    } ]
  }, {
    "tStartMs": 15933,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "由鯰魚誌為您帶來的鯰魚夜話節目"
    } ]
  }, {
    "tStartMs": 18500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "如果您有一些適合在夜裡說的奇事"
    } ]
  }, {
    "tStartMs": 20900,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "怪事、邪事"
    } ]
  }, {
    "tStartMs": 22200,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "歡迎投給小編"
    } ]
  }, {
    "tStartMs": 23433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我是鯰魚夜話的老於"
    } ]
  }, {
    "tStartMs": 25000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "我是妙"
    } ]
  }, {
    "tStartMs": 26033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "下面開始今天的夜話"
    } ]
  }, {
    "tStartMs": 28300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "好，歡迎收聽本期的鯰魚夜話"
    } ]
  }, {
    "tStartMs": 30033,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "歡迎回來"
    } ]
  }, {
    "tStartMs": 31166,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "哎，妙老師"
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你記得我們之前講過一期知乎的"
    } ]
  }, {
    "tStartMs": 34400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "「陰宅」的一個故事嗎"
    } ]
  }, {
    "tStartMs": 36700,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "就很火嗎"
    } ]
  }, {
    "tStartMs": 37233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "節目裡面的嗎"
    } ]
  }, {
    "tStartMs": 38033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "對對對。完了，我陽過記憶不行啊……是吧"
    } ]
  }, {
    "tStartMs": 41400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "就是講的一個"
    } ]
  }, {
    "tStartMs": 42766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "一個x乎上面很有名的帖子"
    } ]
  }, {
    "tStartMs": 44600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "就是這個答主呢"
    } ]
  }, {
    "tStartMs": 45966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "他在這個"
    } ]
  }, {
    "tStartMs": 47633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "租的這個房子裡面出現怪事了"
    } ]
  }, {
    "tStartMs": 49500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "主要我們其實做了很多"
    } ]
  }, {
    "tStartMs": 52000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就是房子裡面出事的"
    } ]
  }, {
    "tStartMs": 54433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "對對對。然後他出現的怪事"
    } ]
  }, {
    "tStartMs": 55633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "就是他在那個監視器裡看到很多人臉"
    } ]
  }, {
    "tStartMs": 58433,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "哦！那個我記得"
    } ]
  }, {
    "tStartMs": 60100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那那……那個印象太深"
    } ]
  }, {
    "tStartMs": 61533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "很多魚友在後台就是講"
    } ]
  }, {
    "tStartMs": 63533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你怎麼可以這樣對待你的狗和貓"
    } ]
  }, {
    "tStartMs": 65533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "他不是出了問題就把貓…"
    } ]
  }, {
    "tStartMs": 66966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "對對對對"
    } ]
  }, {
    "tStartMs": 67933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就留那了對吧"
    } ]
  }, {
    "tStartMs": 69500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "很有問題對吧"
    } ]
  }, {
    "tStartMs": 71366,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "對。我們這種養貓養狗的人真看不下去"
    } ]
  }, {
    "tStartMs": 74233,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 74566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "感覺應該比自己的命還要重要才對"
    } ]
  }, {
    "tStartMs": 77566,
    "dDurationMs": 234,
    "segs": [ {
      "utf8": "對吧"
    } ]
  }, {
    "tStartMs": 77800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "是啊。所以"
    } ]
  }, {
    "tStartMs": 79566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "他住的宅子為什麼會出現這種狀況"
    } ]
  }, {
    "tStartMs": 82033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "老於查過後啊"
    } ]
  }, {
    "tStartMs": 83833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "有一個說法叫做y宅你有聽過嗎"
    } ]
  }, {
    "tStartMs": 86900,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "「y宅」就是顧名思義不好的宅子嗆"
    } ]
  }, {
    "tStartMs": 90133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "哎對吧。這很簡單吧"
    } ]
  }, {
    "tStartMs": 91933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "所以我想問你的問題是"
    } ]
  }, {
    "tStartMs": 93733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果你碰到這個宅子，你怎麼辦"
    } ]
  }, {
    "tStartMs": 96433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我其實我在早期節目"
    } ]
  }, {
    "tStartMs": 99433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我就講過我的處理方法"
    } ]
  }, {
    "tStartMs": 101400,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "嗯？就是走掉，就走掉嘛"
    } ]
  }, {
    "tStartMs": 103566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "你不要想到什麼停損不止損啊"
    } ]
  }, {
    "tStartMs": 105500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你自己命最重要"
    } ]
  }, {
    "tStartMs": 106966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "其實實現在是這麼想的"
    } ]
  }, {
    "tStartMs": 108166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "多了一個新的方法啊"
    } ]
  }, {
    "tStartMs": 109500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "就是你想辦法把旭仔請過來讓"
    } ]
  }, {
    "tStartMs": 112800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "他鎮一鎮"
    } ]
  }, {
    "tStartMs": 114033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "猛男！對"
    } ]
  }, {
    "tStartMs": 115433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我們的前特警猛男，讓他陪住兩天"
    } ]
  }, {
    "tStartMs": 118000,
    "dDurationMs": 566,
    "segs": [ {
      "utf8": "鎮一鎮"
    } ]
  }, {
    "tStartMs": 118566,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "可以，可以"
    } ]
  }, {
    "tStartMs": 119333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "好，今天我們的第一個故事呢"
    } ]
  }, {
    "tStartMs": 121000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "是y宅發生的故事"
    } ]
  }, {
    "tStartMs": 123766,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "而且更恐怖的是呢"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "還有一個概念叫陰伶"
    } ]
  }, {
    "tStartMs": 127366,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "陰伶這個“伶”，它不是靈魂的“靈”"
    } ]
  }, {
    "tStartMs": 130833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "它是單人旁，一個命令的“令”"
    } ]
  }, {
    "tStartMs": 135200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "“亻”，一個命“令”…"
    } ]
  }, {
    "tStartMs": 137833,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "孤苦伶仃的那個“伶”"
    } ]
  }, {
    "tStartMs": 139833,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "看過。就是聽過戲的人可能會對這個詞"
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "比較熟悉啊"
    } ]
  }, {
    "tStartMs": 144966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "但如果說沒有接觸過戲曲的"
    } ]
  }, {
    "tStartMs": 148000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能會對這個事情"
    } ]
  }, {
    "tStartMs": 150000,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "對這個詞呢"
    } ]
  }, {
    "tStartMs": 151200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "要弱一些啊"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "因為有一種說法是"
    } ]
  }, {
    "tStartMs": 154766,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "陰伶就是為過去的亡魂"
    } ]
  }, {
    "tStartMs": 158733,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "唱戲、哭泣、唱挽的這種人"
    } ]
  }, {
    "tStartMs": 162633,
    "dDurationMs": 167,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 162800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "也有說法呢是"
    } ]
  }, {
    "tStartMs": 164733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "陰伶是專門為鬼唱戲的旦角兒"
    } ]
  }, {
    "tStartMs": 168800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "旦角啊"
    } ]
  }, {
    "tStartMs": 171900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "那通常呢"
    } ]
  }, {
    "tStartMs": 173633,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "是這種八字極陰的女性，來從事這個"
    } ]
  }, {
    "tStartMs": 178800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "角色或者說這個職業啊"
    } ]
  }, {
    "tStartMs": 181633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那在某種玄學中解釋呢"
    } ]
  }, {
    "tStartMs": 184100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "陰伶不僅具備溝通陰陽的能力"
    } ]
  }, {
    "tStartMs": 186766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "她還甚至可以啊"
    } ]
  }, {
    "tStartMs": 188133,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "透過通靈的方式，來預知未來"
    } ]
  }, {
    "tStartMs": 192700,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "是能力很強啊"
    } ]
  }, {
    "tStartMs": 194300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但這樣一講，就給我感覺中西合璧了"
    } ]
  }, {
    "tStartMs": 197133,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "對吧"
    } ]
  }, {
    "tStartMs": 197400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "「預知未來」這幾個字……對對對，有點齣戲"
    } ]
  }, {
    "tStartMs": 199966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "有點西方的感覺啊"
    } ]
  }, {
    "tStartMs": 202566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "好，那我們的今天的第一個故事呢"
    } ]
  }, {
    "tStartMs": 204500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "來自於我們b站的魚友小q"
    } ]
  }, {
    "tStartMs": 207300,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "那不僅她遇到了類似陰伶的人"
    } ]
  }, {
    "tStartMs": 211166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "而且"
    } ]
  }, {
    "tStartMs": 211933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她還發現，自己住了很多年的房子啊"
    } ]
  }, {
    "tStartMs": 214900,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "風水不佳"
    } ]
  }, {
    "tStartMs": 215933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "有點像y宅的這種狀況哦"
    } ]
  }, {
    "tStartMs": 218833,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "好在是"
    } ]
  }, {
    "tStartMs": 220200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "整體是沒有發生太多的危險啊"
    } ]
  }, {
    "tStartMs": 222566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "請聽我說啊"
    } ]
  }, {
    "tStartMs": 224033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "加上客服微信之後"
    } ]
  }, {
    "tStartMs": 225433,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小q特別有禮貌就跟我打招呼"
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "然後開門見山的說了自己這個故事"
    } ]
  }, {
    "tStartMs": 231033,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "不知道算不算得上靈異"
    } ]
  }, {
    "tStartMs": 233566,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "但是她是說自己啊"
    } ]
  }, {
    "tStartMs": 235400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "是整理了很久，才給我們做的投稿"
    } ]
  }, {
    "tStartMs": 238533,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "事情發生在2018年"
    } ]
  }, {
    "tStartMs": 240533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "那時候小q才剛上高中"
    } ]
  }, {
    "tStartMs": 242900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "因為上學的原因她搬家了"
    } ]
  }, {
    "tStartMs": 245366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "小q說也就是這次搬家"
    } ]
  }, {
    "tStartMs": 247533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "成為了自己人生的重要轉捩點"
    } ]
  }, {
    "tStartMs": 250533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "因為搬進新房子之後啊"
    } ]
  }, {
    "tStartMs": 253100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "不僅小q受到了影響"
    } ]
  }, {
    "tStartMs": 255000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "連帶著家人一起受到了影響"
    } ]
  }, {
    "tStartMs": 258533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "小q住進新房之後啊"
    } ]
  }, {
    "tStartMs": 260233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "一開始是頻繁的出現g壓床的事情"
    } ]
  }, {
    "tStartMs": 263300,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "包括她弟弟啊，親弟弟也說"
    } ]
  }, {
    "tStartMs": 266600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "會夢到女鬼來追自己"
    } ]
  }, {
    "tStartMs": 268433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那後來呢"
    } ]
  }, {
    "tStartMs": 269966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "小q發現"
    } ]
  }, {
    "tStartMs": 271033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "媽媽身上還出現了各種小毛病啊"
    } ]
  }, {
    "tStartMs": 273700,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "就是這種生理性的病。生病"
    } ]
  }, {
    "tStartMs": 276166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那父母呢"
    } ]
  }, {
    "tStartMs": 278000,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "也開始因為一些小事"
    } ]
  }, {
    "tStartMs": 280366,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "就爆發出很大的矛盾"
    } ]
  }, {
    "tStartMs": 282766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "經常一直炸大吵大鬧"
    } ]
  }, {
    "tStartMs": 284800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "好像很常會有這種情況就是"
    } ]
  }, {
    "tStartMs": 288600,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "容易暴怒吵架，就是如果在y宅裡面"
    } ]
  }, {
    "tStartMs": 292033,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "對！而且就是身邊如果有"
    } ]
  }, {
    "tStartMs": 293533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "被這種東西影響到"
    } ]
  }, {
    "tStartMs": 295433,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "人的情緒是不對"
    } ]
  }, {
    "tStartMs": 296566,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "情緒波動很大"
    } ]
  }, {
    "tStartMs": 297966,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "是的，是的"
    } ]
  }, {
    "tStartMs": 298733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "不正常。對"
    } ]
  }, {
    "tStartMs": 300233,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "而且她說啊"
    } ]
  }, {
    "tStartMs": 301166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "他們就是嚴重到常常是半夜都在"
    } ]
  }, {
    "tStartMs": 304333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "大吵大鬧"
    } ]
  }, {
    "tStartMs": 305166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "把小q和弟弟嚇得呢"
    } ]
  }, {
    "tStartMs": 307166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就只敢躲在房間裡面不敢出聲"
    } ]
  }, {
    "tStartMs": 309966,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "那時間久了之後"
    } ]
  }, {
    "tStartMs": 310800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "小q覺得很奇怪嘛，這種狀況"
    } ]
  }, {
    "tStartMs": 313333,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就上網找了些資訊"
    } ]
  }, {
    "tStartMs": 315400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "也和周圍的這些鄰居大媽聊了聊"
    } ]
  }, {
    "tStartMs": 319100,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "你看小q這邊的這個操作"
    } ]
  }, {
    "tStartMs": 320833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "給我們一個新的方式"
    } ]
  }, {
    "tStartMs": 322633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "跟鄰居大媽們聊一聊"
    } ]
  }, {
    "tStartMs": 324333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "對。你如果住的新的地方"
    } ]
  }, {
    "tStartMs": 326333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "因為你過來之後，你產生什麼狀況啊"
    } ]
  }, {
    "tStartMs": 329166,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "你完全可以跟這種大媽們（聊聊）還真是"
    } ]
  }, {
    "tStartMs": 332600,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "對吧"
    } ]
  }, {
    "tStartMs": 333133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "嚼舌根子"
    } ]
  }, {
    "tStartMs": 334166,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "對她們肯定大部分情況都了解"
    } ]
  }, {
    "tStartMs": 337533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "對，是的"
    } ]
  }, {
    "tStartMs": 339333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "小q聊完之後"
    } ]
  }, {
    "tStartMs": 341033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "大致知道了一些資訊啊"
    } ]
  }, {
    "tStartMs": 342800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "首先上一任的屋主跟小q他們家一樣"
    } ]
  }, {
    "tStartMs": 345800,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "是為了學區買的這個房子"
    } ]
  }, {
    "tStartMs": 348566,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "但是，這個屋主住進房子之後啊"
    } ]
  }, {
    "tStartMs": 350800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "也是碰到各種奇怪的問題"
    } ]
  }, {
    "tStartMs": 352933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "最後好像是因為生病"
    } ]
  }, {
    "tStartMs": 354933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "生了重病，才把這房子轉賣了"
    } ]
  }, {
    "tStartMs": 358400,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "小q一開始覺得"
    } ]
  }, {
    "tStartMs": 359333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "可能是這房子的這個光照不夠"
    } ]
  }, {
    "tStartMs": 362333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "就陽光照進來"
    } ]
  }, {
    "tStartMs": 363333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "很少陰冷"
    } ]
  }, {
    "tStartMs": 364366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "所以才會有這種情況"
    } ]
  }, {
    "tStartMs": 366200,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那直到"
    } ]
  }, {
    "tStartMs": 367566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "這個事後面的事情發生之後啊"
    } ]
  }, {
    "tStartMs": 369566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "她才明白遠遠沒有自己想的這麼簡單"
    } ]
  }, {
    "tStartMs": 372966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "說到這裡呢"
    } ]
  }, {
    "tStartMs": 373600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "小q就給我"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "把這個房子的這個狀況描述了一下"
    } ]
  }, {
    "tStartMs": 377933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "首先這個房子呢"
    } ]
  }, {
    "tStartMs": 378900,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "也是早期的公轉私的房子"
    } ]
  }, {
    "tStartMs": 381400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "就是單位分配的樓房"
    } ]
  }, {
    "tStartMs": 382933,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就跟阿偉之前的那個朋友"
    } ]
  }, {
    "tStartMs": 385133,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "就是"
    } ]
  }, {
    "tStartMs": 385766,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "詭異錄音帶的那個，錄影帶的那個朋友"
    } ]
  }, {
    "tStartMs": 388300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "是一樣的啊"
    } ]
  }, {
    "tStartMs": 390500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那轉成這個私有之後啊"
    } ]
  }, {
    "tStartMs": 392133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "這個房子就正式流通"
    } ]
  }, {
    "tStartMs": 393766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "在市面上流通了嘛"
    } ]
  }, {
    "tStartMs": 395133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "房子這個構造呢比較老式"
    } ]
  }, {
    "tStartMs": 397766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "這一點啊"
    } ]
  }, {
    "tStartMs": 398900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我希望咱們廣東的魚友"
    } ]
  }, {
    "tStartMs": 400633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "可以出來幫我們鑑定一下啊"
    } ]
  }, {
    "tStartMs": 403033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "是不是廣東的房子"
    } ]
  }, {
    "tStartMs": 404366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "這種構造比較普遍啊"
    } ]
  }, {
    "tStartMs": 406000,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "小q說它的具體構造是"
    } ]
  }, {
    "tStartMs": 408233,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "房門進門就是榻榻米"
    } ]
  }, {
    "tStartMs": 410566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "那不遠處呢，大概有兩公尺的距離就是床"
    } ]
  }, {
    "tStartMs": 413900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "再往前呢就是窗"
    } ]
  }, {
    "tStartMs": 415966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "就等於床是放中間的啊"
    } ]
  }, {
    "tStartMs": 418800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她雖然說這扇窗戶很大"
    } ]
  }, {
    "tStartMs": 421766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "但是因為房屋的這個結構原因"
    } ]
  }, {
    "tStartMs": 424566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "也可能是因為朝向原因"
    } ]
  }, {
    "tStartMs": 426500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "基本上是沒什麼陽光照進來的"
    } ]
  }, {
    "tStartMs": 429166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "那回到這個房間門口啊"
    } ]
  }, {
    "tStartMs": 431033,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "左手邊就是廁所"
    } ]
  }, {
    "tStartMs": 433233,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "右手邊是書櫃和書桌"
    } ]
  }, {
    "tStartMs": 435733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "嗯那小q還補充說啊"
    } ]
  }, {
    "tStartMs": 437733,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她說床尾是對著廁所"
    } ]
  }, {
    "tStartMs": 440933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "也就是說如果她睡在這個床上"
    } ]
  }, {
    "tStartMs": 444366,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她其實是看不見廁所的"
    } ]
  }, {
    "tStartMs": 447333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 448433,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "然後我就問她"
    } ]
  }, {
    "tStartMs": 448966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我說這個為什麼窗戶那麼大"
    } ]
  }, {
    "tStartMs": 451933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "就還沒有太陽照進來"
    } ]
  }, {
    "tStartMs": 453166,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "是因為是西曬房嗎"
    } ]
  }, {
    "tStartMs": 455800,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "就是有很多房子，它不是南北通透的嘛"
    } ]
  }, {
    "tStartMs": 458166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "小q說不是"
    } ]
  }, {
    "tStartMs": 459366,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "她說因為窗戶外面有另外一棟住戶"
    } ]
  }, {
    "tStartMs": 463400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "但肯定是因為"
    } ]
  }, {
    "tStartMs": 464600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "早期的這個建房子的原因"
    } ]
  }, {
    "tStartMs": 466400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "他沒有規劃好啊"
    } ]
  }, {
    "tStartMs": 468233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他離得很近"
    } ]
  }, {
    "tStartMs": 469033,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "全擋住"
    } ]
  }, {
    "tStartMs": 469700,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "哎，把陽光都擋住了"
    } ]
  }, {
    "tStartMs": 471366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "嗯小q還說呢"
    } ]
  }, {
    "tStartMs": 473233,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "也可能是因為"
    } ]
  }, {
    "tStartMs": 474766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "就是因為這個陽光啊"
    } ]
  }, {
    "tStartMs": 476500,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "射不進來的原因"
    } ]
  }, {
    "tStartMs": 477733,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "所以廁所呢"
    } ]
  }, {
    "tStartMs": 478566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "總給她一種特別陰冷的感覺"
    } ]
  }, {
    "tStartMs": 481733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她基本上晚上去廁所之後啊"
    } ]
  }, {
    "tStartMs": 484433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "都有一種不知道從哪邊吹出來的冷風"
    } ]
  }, {
    "tStartMs": 487500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我靠！吹的她陣陣發冷"
    } ]
  }, {
    "tStartMs": 489600,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "關鍵是她的廁所還特別大"
    } ]
  }, {
    "tStartMs": 494133,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "就一般來說啊"
    } ]
  }, {
    "tStartMs": 495900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "一般人不都會把廁所"
    } ]
  }, {
    "tStartMs": 497633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "進家裡面的廁所"
    } ]
  }, {
    "tStartMs": 498633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "盡量打掃的比較乾淨嘛"
    } ]
  }, {
    "tStartMs": 500200,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 500733,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "因為它（廁所）這邊本身就是一種污穢之地嘛"
    } ]
  }, {
    "tStartMs": 503400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "對吧"
    } ]
  }, {
    "tStartMs": 504600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "所以呢她這個廁所啊"
    } ]
  }, {
    "tStartMs": 507366,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "老會刮冷風"
    } ]
  }, {
    "tStartMs": 509100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "又很陰冷"
    } ]
  }, {
    "tStartMs": 510600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "就真的不是什麼好事啊"
    } ]
  }, {
    "tStartMs": 512433,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 512633,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "這是我聽完之後，我自己的一個看法"
    } ]
  }, {
    "tStartMs": 516500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "那因為這裡是學區房"
    } ]
  }, {
    "tStartMs": 518166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "所以小q呢沒辦法"
    } ]
  }, {
    "tStartMs": 519966,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "她只能硬著頭皮住"
    } ]
  }, {
    "tStartMs": 522033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "一年之後呢，也就是2019年的時候"
    } ]
  }, {
    "tStartMs": 524833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "小q高中就強制住校了"
    } ]
  }, {
    "tStartMs": 526633,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "她就只能去學校住了"
    } ]
  }, {
    "tStartMs": 529300,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "小q說一開始以為"
    } ]
  }, {
    "tStartMs": 530833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "只要離開這個奇怪的房子啊"
    } ]
  }, {
    "tStartMs": 532633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "情況就能有所好轉"
    } ]
  }, {
    "tStartMs": 534833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "但沒想到的是"
    } ]
  }, {
    "tStartMs": 536133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小q整個人的狀態每況愈下"
    } ]
  }, {
    "tStartMs": 539366,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "用她自己的話來說"
    } ]
  }, {
    "tStartMs": 540400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "是肉眼可見的變得憔悴"
    } ]
  }, {
    "tStartMs": 542433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 543633,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那開學的時候呢"
    } ]
  }, {
    "tStartMs": 544800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "小q要重新辦一張校園卡"
    } ]
  }, {
    "tStartMs": 546933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "就去拍了個證件照"
    } ]
  }, {
    "tStartMs": 548633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "但是照片洗出來"
    } ]
  }, {
    "tStartMs": 550033,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "她自己都嚇到了"
    } ]
  }, {
    "tStartMs": 551333,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "她形容說是照片裡的自己，眼神凶狠"
    } ]
  }, {
    "tStartMs": 554600,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "就像那種殺人犯，入獄前拍的照片一樣"
    } ]
  }, {
    "tStartMs": 558200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "印堂發黑的那種是吧"
    } ]
  }, {
    "tStartMs": 560000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就眼神反正很狠的那種"
    } ]
  }, {
    "tStartMs": 561766,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那高二開始呢"
    } ]
  }, {
    "tStartMs": 563366,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "小q就越發的形單影只了"
    } ]
  }, {
    "tStartMs": 565800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "做什麼事情都獨來獨往"
    } ]
  }, {
    "tStartMs": 567933,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "她自己都沒有意識到"
    } ]
  }, {
    "tStartMs": 569300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "這種變化是什麼時候開始的"
    } ]
  }, {
    "tStartMs": 571533,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "而且小q啊"
    } ]
  }, {
    "tStartMs": 572366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "她現在是沒有跟人交流的慾望"
    } ]
  }, {
    "tStartMs": 575000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "也沒有任何活力"
    } ]
  }, {
    "tStartMs": 577566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "具體的話，就是有一天啊"
    } ]
  }, {
    "tStartMs": 580833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "小q上課教室在5樓"
    } ]
  }, {
    "tStartMs": 583033,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "她突然萌生出了一個想法"
    } ]
  }, {
    "tStartMs": 585166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "就是：不然我從5樓跳下去吧"
    } ]
  }, {
    "tStartMs": 587400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我靠！就我覺得這是有點憂鬱症"
    } ]
  }, {
    "tStartMs": 590566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 591800,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "那小q在投稿裡面說呢"
    } ]
  }, {
    "tStartMs": 593166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "自從這個念頭出現之後啊"
    } ]
  }, {
    "tStartMs": 595000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "就在她裡面心裡不斷的滋生"
    } ]
  }, {
    "tStartMs": 598100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "就像一個吞噬內心的怪物"
    } ]
  }, {
    "tStartMs": 600200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "靠著這個迷惘跟孤獨的這個力量"
    } ]
  }, {
    "tStartMs": 603000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "不斷變大"
    } ]
  }, {
    "tStartMs": 604000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "不停的去撩撥自己：zs吧，zs吧"
    } ]
  }, {
    "tStartMs": 607733,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "小q說她那段時間"
    } ]
  }, {
    "tStartMs": 609500,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "每天說話可能都不超過10句"
    } ]
  }, {
    "tStartMs": 612033,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "而且她給自己訂了一個計劃"
    } ]
  }, {
    "tStartMs": 614100,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "下學期前，我一定要死掉"
    } ]
  }, {
    "tStartMs": 618133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我估計真的就是…有點可怕"
    } ]
  }, {
    "tStartMs": 620300,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "這個"
    } ]
  }, {
    "tStartMs": 620700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "對對對"
    } ]
  }, {
    "tStartMs": 622366,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "這時候呢"
    } ]
  }, {
    "tStartMs": 623533,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "她的投稿是聊天的（語音投稿）"
    } ]
  }, {
    "tStartMs": 626333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "她不是那種寫好的"
    } ]
  }, {
    "tStartMs": 628833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我還在措詞怎麼去勸她的時候"
    } ]
  }, {
    "tStartMs": 631166,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "她就投了下面新的內容"
    } ]
  }, {
    "tStartMs": 634000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "嗯就好在是呢"
    } ]
  }, {
    "tStartMs": 635933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小q她有幾個比較正面陽光的朋友啊"
    } ]
  }, {
    "tStartMs": 638400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "所以她這個計劃，遲遲沒有推進"
    } ]
  }, {
    "tStartMs": 640933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "那精神狀態反轉是有所好轉"
    } ]
  }, {
    "tStartMs": 644300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "所有的事情貌似都在往好的方面發展"
    } ]
  }, {
    "tStartMs": 647366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "但是她遇到了一個朋友叫L"
    } ]
  }, {
    "tStartMs": 650000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我們簡稱他為L"
    } ]
  }, {
    "tStartMs": 651100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "L算是小q的半個"
    } ]
  }, {
    "tStartMs": 653900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "同鄉"
    } ]
  }, {
    "tStartMs": 655133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "之前一起上課下課"
    } ]
  }, {
    "tStartMs": 657700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "偶爾呢回家的時候啊"
    } ]
  }, {
    "tStartMs": 659100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "她們會共同搭乘一班車"
    } ]
  }, {
    "tStartMs": 662700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "但小q說啊"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "L給她的感覺就是有一點陰森森的"
    } ]
  }, {
    "tStartMs": 666433,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "陰冷的感覺"
    } ]
  }, {
    "tStartMs": 667566,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "她形容，L是眼神空洞"
    } ]
  }, {
    "tStartMs": 670833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "神情疲憊"
    } ]
  }, {
    "tStartMs": 672433,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "甚至在說，就是互相聊天的時候啊"
    } ]
  }, {
    "tStartMs": 676033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "她（L）會突然出現一段沉默"
    } ]
  }, {
    "tStartMs": 679100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就聊到一半，突然就不說話了"
    } ]
  }, {
    "tStartMs": 680700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "就很沉默"
    } ]
  }, {
    "tStartMs": 682600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "而且呢在這個時候"
    } ]
  }, {
    "tStartMs": 684133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "L會用一種特別"
    } ]
  }, {
    "tStartMs": 685500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "瘆人的表情去看著對方"
    } ]
  }, {
    "tStartMs": 688500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 689500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "還挺嚇人的這種"
    } ]
  }, {
    "tStartMs": 691633,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那小q開始覺得啊"
    } ]
  }, {
    "tStartMs": 692800,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "可能是她們高中課業負擔比較大"
    } ]
  }, {
    "tStartMs": 695933,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "伙食也不太好，才造成了L的這種狀況"
    } ]
  }, {
    "tStartMs": 699966,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "但是她在強制住校之後"
    } ]
  }, {
    "tStartMs": 703400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "她發現L同寢的女孩都說害怕她"
    } ]
  }, {
    "tStartMs": 707133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就害怕L"
    } ]
  }, {
    "tStartMs": 708633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "甚至有的女孩說啊"
    } ]
  }, {
    "tStartMs": 710166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "自己都不敢直視（L）"
    } ]
  }, {
    "tStartMs": 712966,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "補充一下"
    } ]
  }, {
    "tStartMs": 713966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "L跟小q是同一個寢室的啊"
    } ]
  }, {
    "tStartMs": 716366,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "呃"
    } ]
  }, {
    "tStartMs": 716566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "小q這個時候，也逐漸有點害怕L了"
    } ]
  }, {
    "tStartMs": 719900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "在投稿裡面說呢"
    } ]
  }, {
    "tStartMs": 720900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "自己在上洗手間的時候"
    } ]
  }, {
    "tStartMs": 722833,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "總覺得L會透過廁所的門"
    } ]
  }, {
    "tStartMs": 726100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "上面的這個玻璃來"
    } ]
  }, {
    "tStartMs": 728400,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "窺探自己"
    } ]
  }, {
    "tStartMs": 729566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "啊嗯"
    } ]
  }, {
    "tStartMs": 730933,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "就是真的挺詭異的……這種感覺我覺得"
    } ]
  }, {
    "tStartMs": 735600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "那與此同時啊"
    } ]
  }, {
    "tStartMs": 736600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "小q其實沒有放棄zs的計劃"
    } ]
  }, {
    "tStartMs": 739766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "她心裡還是打算，等放假後就去zs"
    } ]
  }, {
    "tStartMs": 743133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "但改變這一切的"
    } ]
  }, {
    "tStartMs": 744933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "L把小q約出去玩那件事"
    } ]
  }, {
    "tStartMs": 747533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 748766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那放假的時候呢"
    } ]
  }, {
    "tStartMs": 749966,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "L突然找到小q問她說"
    } ]
  }, {
    "tStartMs": 752166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "你有沒有覺得"
    } ]
  }, {
    "tStartMs": 753400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我放假前，我的眼神特別空洞"
    } ]
  }, {
    "tStartMs": 756600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "整個人像丟了魂一樣"
    } ]
  }, {
    "tStartMs": 758633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小q就點點頭說：是是是"
    } ]
  }, {
    "tStartMs": 760200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "確實是，是吧。對"
    } ]
  }, {
    "tStartMs": 762233,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我覺得L突然問這個問題"
    } ]
  }, {
    "tStartMs": 763566,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "可能他人"
    } ]
  }, {
    "tStartMs": 764633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "緩過來了。她緩過來了，她緩緩過來了"
    } ]
  }, {
    "tStartMs": 766600,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "那L說呢"
    } ]
  }, {
    "tStartMs": 767800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "那段時間啊"
    } ]
  }, {
    "tStartMs": 768933,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "她不僅精神上面有各種問題"
    } ]
  }, {
    "tStartMs": 771200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "她自己也常生病"
    } ]
  }, {
    "tStartMs": 772633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "然後看了各種醫生也沒用"
    } ]
  }, {
    "tStartMs": 774933,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "之後啊家裡面人給他找了師傅看"
    } ]
  }, {
    "tStartMs": 777400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "師傅說L有兩個問題"
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "第一，她被學校裡面往死的阿飄盯上"
    } ]
  }, {
    "tStartMs": 783500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "那這個阿飄呢"
    } ]
  }, {
    "tStartMs": 785100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "是想求助於她"
    } ]
  }, {
    "tStartMs": 786933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就是想讓L替它辦事"
    } ]
  }, {
    "tStartMs": 789600,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "然後她的下一句話，把小q直接嚇傻了"
    } ]
  }, {
    "tStartMs": 792800,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "她說這阿飄一直跟著她們"
    } ]
  }, {
    "tStartMs": 795733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就跟著L和小q"
    } ]
  }, {
    "tStartMs": 797566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 798733,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "說在她們吃飯、上課、回宿舍、睡覺、"
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "上廁所、說話…"
    } ]
  }, {
    "tStartMs": 805333,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "所有的時候都盯著自己啊"
    } ]
  }, {
    "tStartMs": 808366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "也是從L的背後，盯著她們兩個"
    } ]
  }, {
    "tStartMs": 811633,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "所以…"
    } ]
  }, {
    "tStartMs": 812700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "所以在廁所裡面可能是"
    } ]
  }, {
    "tStartMs": 816033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "可能是那個g"
    } ]
  }, {
    "tStartMs": 817933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "而且L的那個狀態，對吧"
    } ]
  }, {
    "tStartMs": 820200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "對。而且L的那個狀態啊"
    } ]
  }, {
    "tStartMs": 822033,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "可能是因為被這個g黏住了"
    } ]
  }, {
    "tStartMs": 824700,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "對啊"
    } ]
  }, {
    "tStartMs": 826166,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "就所以這個"
    } ]
  }, {
    "tStartMs": 827833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我覺得這個小q"
    } ]
  }, {
    "tStartMs": 829166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "她對L的這個所有看法啊"
    } ]
  }, {
    "tStartMs": 830900,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "不光是小q"
    } ]
  }, {
    "tStartMs": 831533,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "其實是所有人對L的看法，可能是"
    } ]
  }, {
    "tStartMs": 834766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "被這個阿飄影響了。對啊，對"
    } ]
  }, {
    "tStartMs": 837366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "光環一樣"
    } ]
  }, {
    "tStartMs": 839100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "然後L就說，為什麼這個阿飄啊"
    } ]
  }, {
    "tStartMs": 841900,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "不找別人找我呢"
    } ]
  }, {
    "tStartMs": 843966,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "師傅說L的命格極陰"
    } ]
  }, {
    "tStartMs": 846300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "放在古代，就是陰伶的命啊"
    } ]
  }, {
    "tStartMs": 849366,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "喔……就是你開頭講。"
    } ]
  }, {
    "tStartMs": 851766,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "當時L和家裡面人並不理解"
    } ]
  }, {
    "tStartMs": 854633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "什麼叫陰伶的命"
    } ]
  }, {
    "tStartMs": 856433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "師傅也沒有做過太多的解釋"
    } ]
  }, {
    "tStartMs": 858966,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "就是做法，替L把這個問題解決了"
    } ]
  }, {
    "tStartMs": 862300,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "後來，他們家裡面人又背著這個"
    } ]
  }, {
    "tStartMs": 866233,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "就是他們不太方便去…背這個大師"
    } ]
  }, {
    "tStartMs": 869600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "找這個其他師傅"
    } ]
  }, {
    "tStartMs": 872300,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "但是呢"
    } ]
  }, {
    "tStartMs": 872766,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "他們還是想辦法，去找了一些懂的"
    } ]
  }, {
    "tStartMs": 875400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就他們想知道這個原因嘛"
    } ]
  }, {
    "tStartMs": 877600,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "但沒有說L的任何事情"
    } ]
  }, {
    "tStartMs": 880366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "沒有說，哎，我女兒怎麼怎麼怎麼"
    } ]
  }, {
    "tStartMs": 882200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "就直接問什麼叫陰伶命"
    } ]
  }, {
    "tStartMs": 884700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "然後有的師傅，給咱們解釋啊"
    } ]
  }, {
    "tStartMs": 886600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "說大概意思是：命格極陰"
    } ]
  }, {
    "tStartMs": 889000,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "理論上，要嘛就是跟他們當同行"
    } ]
  }, {
    "tStartMs": 891933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "要嘛就是去做陰伶"
    } ]
  }, {
    "tStartMs": 893700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "因為這種人呢"
    } ]
  }, {
    "tStartMs": 895100,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "容易被往生的這種靈纏上"
    } ]
  }, {
    "tStartMs": 898200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "所以他們必須要靠修行來保護自己"
    } ]
  }, {
    "tStartMs": 901933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "那最早的師傅不給他們說的原因呢"
    } ]
  }, {
    "tStartMs": 904933,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "可能也是因為覺得，這個事情比較棘手"
    } ]
  }, {
    "tStartMs": 908000,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "那小q補充說"
    } ]
  }, {
    "tStartMs": 909133,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "L給自己說這件事的時候啊"
    } ]
  }, {
    "tStartMs": 911300,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "廣東是夏天"
    } ]
  }, {
    "tStartMs": 912933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "是那種穿短袖短褲的季節"
    } ]
  }, {
    "tStartMs": 914900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "而且廣東很熱嘛"
    } ]
  }, {
    "tStartMs": 916800,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "但她當時覺得格外的陰冷"
    } ]
  }, {
    "tStartMs": 919366,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "甚至想找一件外套披上"
    } ]
  }, {
    "tStartMs": 921700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "但是，她看到L的狀態確實已經變好了"
    } ]
  }, {
    "tStartMs": 924366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "她還是為L感到高興啊"
    } ]
  }, {
    "tStartMs": 927566,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "但是L雖然是轉好了"
    } ]
  }, {
    "tStartMs": 929700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "小q還是越發糟糕"
    } ]
  }, {
    "tStartMs": 932566,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "最明顯的呢，就是她覺得自己"
    } ]
  }, {
    "tStartMs": 935366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "被人盯著的感覺"
    } ]
  }, {
    "tStartMs": 937000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "沒有因為L把這件事解決掉，消失了"
    } ]
  }, {
    "tStartMs": 940000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "而是越發強烈了"
    } ]
  }, {
    "tStartMs": 943100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "那回到小q最早這個住的房子的問題"
    } ]
  }, {
    "tStartMs": 946600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "她說自己的這個客廳裡面，有個酒櫃"
    } ]
  }, {
    "tStartMs": 949300,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "她聽完L說到這個事情之後啊"
    } ]
  }, {
    "tStartMs": 951900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "她回到家"
    } ]
  }, {
    "tStartMs": 952933,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "常常會時不時的看到這個"
    } ]
  }, {
    "tStartMs": 955500,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "酒櫃的玻璃上有影子劃過"
    } ]
  }, {
    "tStartMs": 958033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "讓她感覺到非常的害怕"
    } ]
  }, {
    "tStartMs": 960633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "但小q還是覺得這可能是巧合"
    } ]
  }, {
    "tStartMs": 962733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "或者是光線的錯覺啊"
    } ]
  }, {
    "tStartMs": 964000,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 964533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "她就用這種科學的解釋來安慰自己"
    } ]
  }, {
    "tStartMs": 967433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "直到某一天"
    } ]
  }, {
    "tStartMs": 968700,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "小q背對著窗側躺在床上睡午覺"
    } ]
  }, {
    "tStartMs": 971566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "突然她醒了"
    } ]
  }, {
    "tStartMs": 973100,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "緊接著呢"
    } ]
  }, {
    "tStartMs": 973733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "她就感覺到，有人在他耳邊吹了一口氣"
    } ]
  }, {
    "tStartMs": 977800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小q在投稿裡面說啊"
    } ]
  }, {
    "tStartMs": 978900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "說這種感覺特別真切"
    } ]
  }, {
    "tStartMs": 980566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "她一開始以為是弟弟惡作劇"
    } ]
  }, {
    "tStartMs": 982600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "心裡特別氣"
    } ]
  }, {
    "tStartMs": 983966,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "想翻過身去罵人"
    } ]
  }, {
    "tStartMs": 985366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "這時候她才意識到動不了了"
    } ]
  }, {
    "tStartMs": 988133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "被gyc了"
    } ]
  }, {
    "tStartMs": 989333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 990433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "小q說自己此時整個人都麻了"
    } ]
  }, {
    "tStartMs": 993133,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "像被重物壓的感覺一樣"
    } ]
  }, {
    "tStartMs": 995166,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "她在心理上就是，心裡就破口大罵"
    } ]
  }, {
    "tStartMs": 997600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "罵了好一陣她才能動"
    } ]
  }, {
    "tStartMs": 999300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "然後頓時，她趕緊翻身起床"
    } ]
  }, {
    "tStartMs": 1001900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "整個人特別清醒"
    } ]
  }, {
    "tStartMs": 1003500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "小q這個時候"
    } ]
  }, {
    "tStartMs": 1004333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "還是覺得"
    } ]
  }, {
    "tStartMs": 1005833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "是不是弟弟在惡作劇什麼的"
    } ]
  }, {
    "tStartMs": 1007366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "因為她要找一個理由說服自己嘛"
    } ]
  }, {
    "tStartMs": 1010200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "她就想去罵弟弟"
    } ]
  }, {
    "tStartMs": 1012366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "但她發現啊"
    } ]
  }, {
    "tStartMs": 1013333,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "弟弟一直在安靜的睡午覺"
    } ]
  }, {
    "tStartMs": 1015600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "根本沒有醒來的跡象"
    } ]
  }, {
    "tStartMs": 1017033,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "那小q就坐回沙發上面去"
    } ]
  }, {
    "tStartMs": 1019700,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "思考這個事情"
    } ]
  }, {
    "tStartMs": 1020766,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "她越想越不對，越想越害怕"
    } ]
  }, {
    "tStartMs": 1022900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "有些細節就慢慢浮現了"
    } ]
  }, {
    "tStartMs": 1025433,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "她說當時自己能動之後啊"
    } ]
  }, {
    "tStartMs": 1027800,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "第一反應是翻身"
    } ]
  }, {
    "tStartMs": 1029733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "小q說自己平躺在床上的姿勢啊"
    } ]
  }, {
    "tStartMs": 1032433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "可能她只有一兩秒鐘的這種感覺"
    } ]
  }, {
    "tStartMs": 1035033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "她就清晰的感覺到"
    } ]
  }, {
    "tStartMs": 1036700,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "有東西垂在自己身上"
    } ]
  }, {
    "tStartMs": 1039166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "在來回掃動"
    } ]
  }, {
    "tStartMs": 1040566,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "現在這麼一想啊…可能是頭髮絲"
    } ]
  }, {
    "tStartMs": 1044833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "他腦補出一個畫面"
    } ]
  }, {
    "tStartMs": 1045966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "就是有一個人倒吊在天花板上面"
    } ]
  }, {
    "tStartMs": 1048633,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "然後倒吊著"
    } ]
  }, {
    "tStartMs": 1050133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "對，倒吊著"
    } ]
  }, {
    "tStartMs": 1051800,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然後，詭異這個姿勢"
    } ]
  }, {
    "tStartMs": 1053966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "是啊"
    } ]
  }, {
    "tStartMs": 1054833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "而且這個“人”，我估計是打引號，對吧"
    } ]
  }, {
    "tStartMs": 1056800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "對啊"
    } ]
  }, {
    "tStartMs": 1057400,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "然後用這個長長的頭髮絲"
    } ]
  }, {
    "tStartMs": 1059966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "撩她"
    } ]
  }, {
    "tStartMs": 1061300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 1062600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那個小q只能安慰自己"
    } ]
  }, {
    "tStartMs": 1064100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "不要多想…不要多想…"
    } ]
  }, {
    "tStartMs": 1065133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "畢竟她也沒辦法，她也搬不了家"
    } ]
  }, {
    "tStartMs": 1068100,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "但之後呢"
    } ]
  }, {
    "tStartMs": 1068733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "她就更頻繁的感覺"
    } ]
  }, {
    "tStartMs": 1070433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "有一雙眼睛在背後盯著自己"
    } ]
  }, {
    "tStartMs": 1072600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "無論自己做什麼，只要是在家裡面"
    } ]
  }, {
    "tStartMs": 1075133,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "她就有這種被"
    } ]
  }, {
    "tStartMs": 1076166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "窺探的感覺"
    } ]
  }, {
    "tStartMs": 1078300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那時間在繼續啊"
    } ]
  }, {
    "tStartMs": 1079733,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "沒有任何人，能夠阻止時間的推移"
    } ]
  }, {
    "tStartMs": 1083433,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "小q說"
    } ]
  }, {
    "tStartMs": 1084300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "時間到了她打算結束生命的那一天"
    } ]
  }, {
    "tStartMs": 1087600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她那天呢就把自己打扮了一番"
    } ]
  }, {
    "tStartMs": 1089833,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "整夜沒睡，坐在客廳裡面"
    } ]
  }, {
    "tStartMs": 1091533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "一直坐到了將近天亮"
    } ]
  }, {
    "tStartMs": 1093966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "應該是5點或6點的樣子"
    } ]
  }, {
    "tStartMs": 1095766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "她就走上天台準備跳下去了"
    } ]
  }, {
    "tStartMs": 1098500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那這段投稿"
    } ]
  }, {
    "tStartMs": 1099600,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "小q就是用這個語音投的"
    } ]
  }, {
    "tStartMs": 1101966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我明顯聽出語音裡面有哽咽感"
    } ]
  }, {
    "tStartMs": 1105566,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "小q說自己走上天台的整個階段啊"
    } ]
  }, {
    "tStartMs": 1108166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "有一種被什麼人操縱和支配的感覺"
    } ]
  }, {
    "tStartMs": 1111166,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "當她走到天台的時候啊"
    } ]
  }, {
    "tStartMs": 1113633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "心裡有個聲音"
    } ]
  }, {
    "tStartMs": 1115966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "就不停的告訴她說"
    } ]
  }, {
    "tStartMs": 1117833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "哎，你可以給家裡面人打電話"
    } ]
  }, {
    "tStartMs": 1120800,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "那小q說可能是因為"
    } ]
  }, {
    "tStartMs": 1122733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "人類的生存本能吧"
    } ]
  }, {
    "tStartMs": 1124333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "這種動物性"
    } ]
  }, {
    "tStartMs": 1125700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "她就掙扎著"
    } ]
  }, {
    "tStartMs": 1127200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "聽從了自己心裡的這個聲音"
    } ]
  }, {
    "tStartMs": 1129566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "還好她還來不及做什麼"
    } ]
  }, {
    "tStartMs": 1133933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "她也來不及跳，也沒來得及打電話"
    } ]
  }, {
    "tStartMs": 1136133,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "家裡面人及時趕到，把她給攔住"
    } ]
  }, {
    "tStartMs": 1139133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦！"
    } ]
  }, {
    "tStartMs": 1140433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "對，就把她攔下來了"
    } ]
  }, {
    "tStartMs": 1141933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但這事情呢，並沒有因此而結束"
    } ]
  }, {
    "tStartMs": 1145033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "家裡面發現這個狀況之後啊"
    } ]
  }, {
    "tStartMs": 1147366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "也帶著小q去找師傅"
    } ]
  }, {
    "tStartMs": 1149533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "師傅說小q丟了魂魄"
    } ]
  }, {
    "tStartMs": 1151566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "所以才會被這個g附身操作的"
    } ]
  }, {
    "tStartMs": 1154233,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "那關鍵呢這個師傅的說法"
    } ]
  }, {
    "tStartMs": 1157133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他找的這個師傅"
    } ]
  }, {
    "tStartMs": 1157933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "跟L的那個，不是一個師傅啊"
    } ]
  }, {
    "tStartMs": 1159533,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "哦，知道啊"
    } ]
  }, {
    "tStartMs": 1160800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "她這個師傅"
    } ]
  }, {
    "tStartMs": 1161533,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "跟L的那個師傅說的是一樣的"
    } ]
  }, {
    "tStartMs": 1163366,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "說她是被學校裡面的枉死g盯上了"
    } ]
  }, {
    "tStartMs": 1166333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1167333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那小q就很疑惑啊說"
    } ]
  }, {
    "tStartMs": 1169966,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "當時L說"
    } ]
  }, {
    "tStartMs": 1171700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "這個阿飄不是已經給超度了嘛"
    } ]
  }, {
    "tStartMs": 1174100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "對吧，已經給她的那個師傅超度了"
    } ]
  }, {
    "tStartMs": 1176600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "難道是有新的阿飄"
    } ]
  }, {
    "tStartMs": 1178366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "或者是學校就這麼邪"
    } ]
  }, {
    "tStartMs": 1180300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "能有這麼多阿飄"
    } ]
  }, {
    "tStartMs": 1181366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那小q說"
    } ]
  }, {
    "tStartMs": 1183033,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她說因為家裡面人很篤信這些東西"
    } ]
  }, {
    "tStartMs": 1185900,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "就所以一連做了兩三場法事"
    } ]
  }, {
    "tStartMs": 1189566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那每次做法事"
    } ]
  }, {
    "tStartMs": 1190966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "小q就會莫名其妙的煩躁"
    } ]
  }, {
    "tStartMs": 1193366,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "雖然在這個過程中"
    } ]
  }, {
    "tStartMs": 1194600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "她沒有看到任何的阿飄的這種"
    } ]
  }, {
    "tStartMs": 1196700,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "g影什麼的"
    } ]
  }, {
    "tStartMs": 1198166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "師傅呢也沒有給小q多做解釋"
    } ]
  }, {
    "tStartMs": 1201766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "所以她不知道"
    } ]
  }, {
    "tStartMs": 1202966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "這個阿飄是為什麼跟著她"
    } ]
  }, {
    "tStartMs": 1205000,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "以及是怎麼盯上她的"
    } ]
  }, {
    "tStartMs": 1207300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "還好呢，估計是這個師傅真的是有本事"
    } ]
  }, {
    "tStartMs": 1210333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "做法事之前呢"
    } ]
  }, {
    "tStartMs": 1211833,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "也就是小q她消沉的那段時間"
    } ]
  }, {
    "tStartMs": 1214833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "她照鏡子的時候"
    } ]
  }, {
    "tStartMs": 1216433,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "她感覺鏡子裡面出現的，不是自己"
    } ]
  }, {
    "tStartMs": 1220133,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "或者說不只自己，還有一個中年阿姨"
    } ]
  }, {
    "tStartMs": 1223000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但是法事做完之後啊"
    } ]
  }, {
    "tStartMs": 1224733,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "就消失了"
    } ]
  }, {
    "tStartMs": 1225900,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "就消失了"
    } ]
  }, {
    "tStartMs": 1227500,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "之後，小q就高中畢業了"
    } ]
  }, {
    "tStartMs": 1230366,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "她家裡面就趕緊把這棟房子賣掉了"
    } ]
  }, {
    "tStartMs": 1232600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那一切呢就回歸到了正軌"
    } ]
  }, {
    "tStartMs": 1235033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小q也就逐漸恢復如初了啊"
    } ]
  }, {
    "tStartMs": 1238000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "但是，她說不知道什麼原因呢"
    } ]
  }, {
    "tStartMs": 1240133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "她有一次回到那個房子就看了一眼"
    } ]
  }, {
    "tStartMs": 1242300,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "就發現啊"
    } ]
  }, {
    "tStartMs": 1243300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "第三任的房主，在房門外貼滿了黃符"
    } ]
  }, {
    "tStartMs": 1247966,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "啊嗯"
    } ]
  }, {
    "tStartMs": 1248800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "這個整個故事"
    } ]
  }, {
    "tStartMs": 1251000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "它的整個故事呢到這邊就結束了啊"
    } ]
  }, {
    "tStartMs": 1253933,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "那就是這個宅子的問題吧，對吧"
    } ]
  }, {
    "tStartMs": 1256966,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "對。我覺得就是因為這個宅子是y宅"
    } ]
  }, {
    "tStartMs": 1260100,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "所以才把"
    } ]
  }, {
    "tStartMs": 1261966,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "學校裡面的這個阿飄吸引到了"
    } ]
  }, {
    "tStartMs": 1264600,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "小q身上"
    } ]
  }, {
    "tStartMs": 1265300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她現在好了，對吧？"
    } ]
  }, {
    "tStartMs": 1268000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "已經好了，已經好了"
    } ]
  }, {
    "tStartMs": 1268766,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "那太好了。對！那就好，那就好！"
    } ]
  }, {
    "tStartMs": 1272100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "而且這個學校裡面的這個阿飄"
    } ]
  }, {
    "tStartMs": 1274233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我覺得就是不是看上了這個（y宅）"
    } ]
  }, {
    "tStartMs": 1275900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1276833,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "宅子嘛，我估計可以養（g）"
    } ]
  }, {
    "tStartMs": 1279366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "甚至有的宅子啊"
    } ]
  }, {
    "tStartMs": 1281366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "出現這種情況最嚴重的時候"
    } ]
  }, {
    "tStartMs": 1283333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "可以把一些"
    } ]
  }, {
    "tStartMs": 1285166,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "來往過路的靈體吸進來啊"
    } ]
  }, {
    "tStartMs": 1288133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "那這種房子，容易滋養養邪"
    } ]
  }, {
    "tStartMs": 1290800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "有些小g在裡面待久了"
    } ]
  }, {
    "tStartMs": 1293133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "怨念會越來越深"
    } ]
  }, {
    "tStartMs": 1295200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "嗯所以她（小q）給我們的建議是"
    } ]
  }, {
    "tStartMs": 1297700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我們無論是在買房還是在租房的時候"
    } ]
  }, {
    "tStartMs": 1300433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "可以去"
    } ]
  }, {
    "tStartMs": 1302033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "多聽聽自己的心聲"
    } ]
  }, {
    "tStartMs": 1304133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "如果你進入這個房子"
    } ]
  }, {
    "tStartMs": 1305633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "剛進去，你就覺得不好"
    } ]
  }, {
    "tStartMs": 1307600,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "感覺很不對"
    } ]
  }, {
    "tStartMs": 1309166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "那你就相信自己第六感情"
    } ]
  }, {
    "tStartMs": 1309933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "就不要這個吧"
    } ]
  }, {
    "tStartMs": 1311366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "是，對"
    } ]
  }, {
    "tStartMs": 1313133,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "所以最後……還好就是都解決了嘛"
    } ]
  }, {
    "tStartMs": 1316100,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "我們還是祝這個"
    } ]
  }, {
    "tStartMs": 1317900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是的是的是的"
    } ]
  }, {
    "tStartMs": 1318933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "這個解決太好了"
    } ]
  }, {
    "tStartMs": 1320200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "對，還是祝咱們小q，一切都好"
    } ]
  }, {
    "tStartMs": 1322766,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "平平安安"
    } ]
  }, {
    "tStartMs": 1323333,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "對好"
    } ]
  }, {
    "tStartMs": 1324100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "第一故事到這邊"
    } ]
  }, {
    "tStartMs": 1328533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "好，第二故事還是來自b站的魚友啊"
    } ]
  }, {
    "tStartMs": 1332000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "叫：湛藍。我們喊他"
    } ]
  }, {
    "tStartMs": 1334633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "小藍（​​是女孩子）"
    } ]
  }, {
    "tStartMs": 1335600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小藍說"
    } ]
  }, {
    "tStartMs": 1337600,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "自己發生故事大概是上初一的時候啊"
    } ]
  }, {
    "tStartMs": 1341766,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "自己呢"
    } ]
  }, {
    "tStartMs": 1343366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "一直是"
    } ]
  }, {
    "tStartMs": 1344733,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "比較喜歡盜墓筆記，這系列的書"
    } ]
  }, {
    "tStartMs": 1347633,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "嗯。你看過嗎"
    } ]
  }, {
    "tStartMs": 1349133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我還真不喜歡"
    } ]
  }, {
    "tStartMs": 1350600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊，你看過"
    } ]
  }, {
    "tStartMs": 1351400,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "你不喜歡是吧"
    } ]
  }, {
    "tStartMs": 1352400,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我沒看過書，我看過電影的片段吧"
    } ]
  }, {
    "tStartMs": 1355733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "書，其實還行"
    } ]
  }, {
    "tStartMs": 1356733,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "書我看過大概兩三冊，我覺得還行"
    } ]
  }, {
    "tStartMs": 1359800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1360400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1361500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "他（小藍）特別喜歡這系列書"
    } ]
  }, {
    "tStartMs": 1363366,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "然後正好那年是八月十七日"
    } ]
  }, {
    "tStartMs": 1367300,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我一開始以為是中元節前後嘛"
    } ]
  }, {
    "tStartMs": 1370033,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然後就問他"
    } ]
  }, {
    "tStartMs": 1370933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "就八月十七日那年到底有什麼特別的"
    } ]
  }, {
    "tStartMs": 1373733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "後來他跟我講啊"
    } ]
  }, {
    "tStartMs": 1376033,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "這個是盜墓筆記"
    } ]
  }, {
    "tStartMs": 1377800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "粉絲們約定俗成的"
    } ]
  }, {
    "tStartMs": 1379733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "就是可能跟故事裡面有關的"
    } ]
  }, {
    "tStartMs": 1382133,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是八月十七日叫稻米節"
    } ]
  }, {
    "tStartMs": 1384766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "哦，對。然後因為小藍是粉絲嘛"
    } ]
  }, {
    "tStartMs": 1387733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "然後就準備和媽媽"
    } ]
  }, {
    "tStartMs": 1389400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "還有一位阿姨準備去……盜墓？"
    } ]
  }, {
    "tStartMs": 1392166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 1392933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "過分了啊！盜墓是犯法的啊"
    } ]
  }, {
    "tStartMs": 1394800,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "是的，是的，不能多說"
    } ]
  }, {
    "tStartMs": 1395933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "準備去長白山玩去"
    } ]
  }, {
    "tStartMs": 1397966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "哦！就是那個發生的地是吧"
    } ]
  }, {
    "tStartMs": 1400333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "對對對"
    } ]
  }, {
    "tStartMs": 1401566,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "行程定在8月17日的前幾天"
    } ]
  }, {
    "tStartMs": 1404500,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "嗯小藍說，他們一行人玩完了黑龍潭漂流等項目"
    } ]
  }, {
    "tStartMs": 1408800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "其他的不記得了"
    } ]
  }, {
    "tStartMs": 1411400,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "因為回憶實在不太美好"
    } ]
  }, {
    "tStartMs": 1413766,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "所以自己已經記不清去哪裡玩了嗯"
    } ]
  }, {
    "tStartMs": 1417000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "小藍說，當時不光有媽媽、阿姨"
    } ]
  }, {
    "tStartMs": 1419566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "還有姥姥姥爺"
    } ]
  }, {
    "tStartMs": 1421133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "也一起去了"
    } ]
  }, {
    "tStartMs": 1422133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "嗯小藍回憶到，特別奇怪的一點是"
    } ]
  }, {
    "tStartMs": 1425500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "他們從頭到尾碰到了很多事情"
    } ]
  }, {
    "tStartMs": 1428233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "嚇成那樣"
    } ]
  }, {
    "tStartMs": 1430033,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "但是好像被隔離在"
    } ]
  }, {
    "tStartMs": 1433166,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "自己那間出事的賓館一樣"
    } ]
  }, {
    "tStartMs": 1434600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就感覺好像只有"
    } ]
  }, {
    "tStartMs": 1437100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "小藍、媽媽還有阿姨這三個人來旅遊了"
    } ]
  }, {
    "tStartMs": 1440000,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "根本沒有姥姥姥爺一起來"
    } ]
  }, {
    "tStartMs": 1442833,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "所以姥姥姥​​爺是沒有發生這個事是吧"
    } ]
  }, {
    "tStartMs": 1445333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "對！他們在一起玩了"
    } ]
  }, {
    "tStartMs": 1447400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "但是沒有遇到怪事"
    } ]
  }, {
    "tStartMs": 1449500,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1450166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "是的。小藍這裡補充啊"
    } ]
  }, {
    "tStartMs": 1452100,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "自己家裡面比較信這些"
    } ]
  }, {
    "tStartMs": 1454733,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以也常常能碰到靈異事件"
    } ]
  }, {
    "tStartMs": 1457766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "包括自己和媽媽"
    } ]
  }, {
    "tStartMs": 1459400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "從小就能看見遇見這些事情"
    } ]
  }, {
    "tStartMs": 1462533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "然後小藍說啊"
    } ]
  }, {
    "tStartMs": 1464966,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "媽媽和同行的阿姨都已經皈依了"
    } ]
  }, {
    "tStartMs": 1468333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "會經常去寺廟裡面做法事"
    } ]
  }, {
    "tStartMs": 1471000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也捐了不少香火錢，很虔誠"
    } ]
  }, {
    "tStartMs": 1473733,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "並且啊每天都會誦經"
    } ]
  }, {
    "tStartMs": 1476833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "小藍小時候呢"
    } ]
  }, {
    "tStartMs": 1477900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "也常跟著家人去寺廟裡面玩"
    } ]
  }, {
    "tStartMs": 1480933,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "可以說呢"
    } ]
  }, {
    "tStartMs": 1481600,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "他們一家子呢"
    } ]
  }, {
    "tStartMs": 1482500,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "都是那種靈感比較強的人"
    } ]
  }, {
    "tStartMs": 1484633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "下面進入正題"
    } ]
  }, {
    "tStartMs": 1487233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "小藍一行人大概晚上8點多吃完團餐"
    } ]
  }, {
    "tStartMs": 1491000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "買了點啤酒鴨貨什麼的"
    } ]
  }, {
    "tStartMs": 1493100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "就準備回屋邊聊天邊吃"
    } ]
  }, {
    "tStartMs": 1496100,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "小藍說"
    } ]
  }, {
    "tStartMs": 1496600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "他們第一天晚上住的那間飯店啊"
    } ]
  }, {
    "tStartMs": 1499733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "一進房間門"
    } ]
  }, {
    "tStartMs": 1501366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "小藍覺得有點害怕"
    } ]
  }, {
    "tStartMs": 1504400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "瘆得慌。但當時沒多想"
    } ]
  }, {
    "tStartMs": 1506800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "覺得可能就是自己恐怖故事"
    } ]
  }, {
    "tStartMs": 1509166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "恐怖電影看多了"
    } ]
  }, {
    "tStartMs": 1511200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "加上晚上入住飯店，就自己嚇自己"
    } ]
  }, {
    "tStartMs": 1514633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "小藍說自己是個"
    } ]
  }, {
    "tStartMs": 1516766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "重度恐怖愛好者啊"
    } ]
  }, {
    "tStartMs": 1518100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是小說電影什麼都看"
    } ]
  }, {
    "tStartMs": 1520400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "甚至這個行程裡面啊"
    } ]
  }, {
    "tStartMs": 1522800,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "自己還帶了一本恐怖小說在身上"
    } ]
  }, {
    "tStartMs": 1525600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "那真的是重度愛好者對"
    } ]
  }, {
    "tStartMs": 1528033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "收拾了一下行李"
    } ]
  }, {
    "tStartMs": 1529700,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "媽媽和阿姨就坐在右邊的靠窗戶的"
    } ]
  }, {
    "tStartMs": 1533766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "床上聊天"
    } ]
  }, {
    "tStartMs": 1534700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "小藍跟我說，媽媽其實呢"
    } ]
  }, {
    "tStartMs": 1537433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "她自己也會看一些這些事情"
    } ]
  }, {
    "tStartMs": 1540000,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "所以她和阿姨兩人聊著"
    } ]
  }, {
    "tStartMs": 1543133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "話題就偏向了那個方向啊"
    } ]
  }, {
    "tStartMs": 1545900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "對啊，就跟我們兩個一樣"
    } ]
  }, {
    "tStartMs": 1548366,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但我覺得好像長輩通常都不太喜歡"
    } ]
  }, {
    "tStartMs": 1550833,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "但他們相信這個"
    } ]
  }, {
    "tStartMs": 1552566,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "而且可能自身也有懂一點這個"
    } ]
  }, {
    "tStartMs": 1556100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "了解"
    } ]
  }, {
    "tStartMs": 1557000,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "主要阿姨就問嘛，就問媽媽說"
    } ]
  }, {
    "tStartMs": 1561200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "阿姨的爸爸最近身體各方面有點不好"
    } ]
  }, {
    "tStartMs": 1565533,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "而且也不順"
    } ]
  }, {
    "tStartMs": 1566766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是不是招惹了一些不乾淨的東西啊"
    } ]
  }, {
    "tStartMs": 1569766,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "小藍媽媽就跟阿姨就分析了一陣子啊"
    } ]
  }, {
    "tStartMs": 1573200,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "就說，確實可能有東西纏著他爸爸了"
    } ]
  }, {
    "tStartMs": 1576366,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "嗯可以去廟裡面做一下法事什麼的"
    } ]
  }, {
    "tStartMs": 1579100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "嗯兩人聊著聊著也很開心"
    } ]
  }, {
    "tStartMs": 1582033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就舉起酒杯碰了一下"
    } ]
  }, {
    "tStartMs": 1583833,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "小藍媽媽在仰頭喝酒的時候"
    } ]
  }, {
    "tStartMs": 1586700,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "余光往下掃了一下"
    } ]
  }, {
    "tStartMs": 1589100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "發現有女的趴在她的腳邊"
    } ]
  }, {
    "tStartMs": 1591500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "就在兩床之間走道裡面"
    } ]
  }, {
    "tStartMs": 1595133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "據他媽媽後來說啊"
    } ]
  }, {
    "tStartMs": 1596633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "也不是一個傳統的貞子形象"
    } ]
  }, {
    "tStartMs": 1599366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是個短髮啊"
    } ]
  }, {
    "tStartMs": 1601166,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "頭髮呢垂到耳朵下面，有很小很小的捲"
    } ]
  }, {
    "tStartMs": 1605166,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "頭髮是濕的還滴著水"
    } ]
  }, {
    "tStartMs": 1607833,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1609333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "身上穿的是那種白色的睡裙啊"
    } ]
  }, {
    "tStartMs": 1612033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "朝著小藍的媽媽咧嘴笑"
    } ]
  }, {
    "tStartMs": 1615300,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1615933,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "嘴裡佈滿了細細密密的小尖牙"
    } ]
  }, {
    "tStartMs": 1619166,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "特別特別尖"
    } ]
  }, {
    "tStartMs": 1620600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "描述的好細啊"
    } ]
  }, {
    "tStartMs": 1622400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "對！滿嘴都是黑色的"
    } ]
  }, {
    "tStartMs": 1624900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "後面小藍媽媽猜測啊"
    } ]
  }, {
    "tStartMs": 1627100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "就可能是乾掉的x液…就變黑了"
    } ]
  }, {
    "tStartMs": 1629800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1631033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小藍他媽媽很…"
    } ]
  }, {
    "tStartMs": 1633533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "這個，這個實在是太頂了"
    } ]
  }, {
    "tStartMs": 1636233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "是的。接著小藍媽媽呢就看向阿姨了"
    } ]
  }, {
    "tStartMs": 1639900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就心裡琢磨說"
    } ]
  }, {
    "tStartMs": 1642033,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "是不是阿姨也能看見"
    } ]
  }, {
    "tStartMs": 1644766,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "阿姨看見小藍媽媽僵在那裡了"
    } ]
  }, {
    "tStartMs": 1647433,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1648000,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "自己也可能覺得不對勁，也不敢動了"
    } ]
  }, {
    "tStartMs": 1650833,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "媽媽呢就一直盯在下面"
    } ]
  }, {
    "tStartMs": 1653200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "足足盯了兩分鐘"
    } ]
  }, {
    "tStartMs": 1655200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "阿姨一直問小藍媽媽：怎麼了怎麼了"
    } ]
  }, {
    "tStartMs": 1657700,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "媽媽就用眼神示意阿姨，你看床下沒"
    } ]
  }, {
    "tStartMs": 1660633,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "阿姨不敢說話"
    } ]
  }, {
    "tStartMs": 1661400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "媽媽也不敢說話。對"
    } ]
  }, {
    "tStartMs": 1663700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "阿姨雖然看不見啊"
    } ]
  }, {
    "tStartMs": 1665000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "但是這時候已經完全懂了"
    } ]
  }, {
    "tStartMs": 1667900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "兩個人也不敢繼續喝酒了"
    } ]
  }, {
    "tStartMs": 1669933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "嗯轉頭趕緊起來收拾東西"
    } ]
  }, {
    "tStartMs": 1672300,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "再一看呢"
    } ]
  }, {
    "tStartMs": 1673366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "幸好這女的是不見了啊"
    } ]
  }, {
    "tStartMs": 1675300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1676833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "接著呢"
    } ]
  }, {
    "tStartMs": 1677833,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "趕緊把今天數量的經文，給述掉了"
    } ]
  }, {
    "tStartMs": 1681100,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1681766,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "小藍則在左邊靠廁所床上，看著自己的"
    } ]
  }, {
    "tStartMs": 1685100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "恐怖小說"
    } ]
  }, {
    "tStartMs": 1686433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "等於小藍全程就沒有參與進來"
    } ]
  }, {
    "tStartMs": 1689733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "後面是被媽媽…應該是被媽媽告訴的"
    } ]
  }, {
    "tStartMs": 1692500,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "告訴他了"
    } ]
  }, {
    "tStartMs": 1694300,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "小藍說呢"
    } ]
  }, {
    "tStartMs": 1695333,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "當時自己看不見那東西啊"
    } ]
  }, {
    "tStartMs": 1697566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "也沒注意到她倆剛剛發生了什麼"
    } ]
  }, {
    "tStartMs": 1700900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "但是，心裡是有一點毛毛的"
    } ]
  }, {
    "tStartMs": 1704000,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "不知道怎麼形容"
    } ]
  }, {
    "tStartMs": 1705400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "感覺自己的汗毛，都豎起來了"
    } ]
  }, {
    "tStartMs": 1709333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "但是那會"
    } ]
  }, {
    "tStartMs": 1710133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "小藍覺得，可能是自己看小說看的"
    } ]
  }, {
    "tStartMs": 1712700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "然後自己嚇自己"
    } ]
  }, {
    "tStartMs": 1714333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "轉頭就爬向媽媽她們床上去了"
    } ]
  }, {
    "tStartMs": 1717133,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1717833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "11點多小藍準備去洗澡了"
    } ]
  }, {
    "tStartMs": 1720433,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "突然一股莫名的恐​​懼湧上來了"
    } ]
  }, {
    "tStartMs": 1724566,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "就喊媽媽陪自己"
    } ]
  }, {
    "tStartMs": 1727300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "小藍跟我說啊，他自己膽子"
    } ]
  }, {
    "tStartMs": 1729800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "因為剛才不是說他喜歡這些東西嗎"
    } ]
  }, {
    "tStartMs": 1732300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "然後他膽子也很大"
    } ]
  }, {
    "tStartMs": 1734900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "玩鬼屋都是坦克車位的"
    } ]
  }, {
    "tStartMs": 1736600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1738100,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "然後他就跟媽媽兩人擠進廁所裡"
    } ]
  }, {
    "tStartMs": 1740633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "準備洗漱了嘛"
    } ]
  }, {
    "tStartMs": 1741600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "嗯讓媽媽陪"
    } ]
  }, {
    "tStartMs": 1742833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "結果阿姨也跟進來了"
    } ]
  }, {
    "tStartMs": 1744500,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "說我自己不敢一個人在外面"
    } ]
  }, {
    "tStartMs": 1746766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "呆著"
    } ]
  }, {
    "tStartMs": 1747700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就三個人在一個小廁所裡面，開始洗漱"
    } ]
  }, {
    "tStartMs": 1750966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "小藍說當時自己全程都很警覺"
    } ]
  }, {
    "tStartMs": 1753766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "不知道為什麼"
    } ]
  }, {
    "tStartMs": 1754700,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "眼睛一直在鏡子和廁所門口來回掃"
    } ]
  }, {
    "tStartMs": 1758433,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "時不時還往床那邊看"
    } ]
  }, {
    "tStartMs": 1760733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "阿姨也是靠在門框上"
    } ]
  }, {
    "tStartMs": 1762966,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "同時盯著廁所和房間"
    } ]
  }, {
    "tStartMs": 1765300,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1765833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就好像怕一眼沒注意啊"
    } ]
  }, {
    "tStartMs": 1767933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "屋子裡面就多了什麼東西"
    } ]
  }, {
    "tStartMs": 1769766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "或人出來一樣"
    } ]
  }, {
    "tStartMs": 1770933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1771766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "洗漱完畢"
    } ]
  }, {
    "tStartMs": 1772900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "三人準備全部擠在靠窗的那張床上睡"
    } ]
  }, {
    "tStartMs": 1776400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "小藍說自己睡眠品質很好"
    } ]
  }, {
    "tStartMs": 1779366,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "雖然有點害怕，但沒一會就睡著了"
    } ]
  }, {
    "tStartMs": 1783200,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "媽媽在心裡一直念著經，也睡著了"
    } ]
  }, {
    "tStartMs": 1787700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "這下就剩阿姨了"
    } ]
  }, {
    "tStartMs": 1789400,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "這下阿姨徹底失眠了"
    } ]
  }, {
    "tStartMs": 1791100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "落單了。對"
    } ]
  }, {
    "tStartMs": 1793300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "3點左右啊"
    } ]
  }, {
    "tStartMs": 1794733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "小藍被阿姨晃了晃"
    } ]
  }, {
    "tStartMs": 1796733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "阿姨用手機給小藍打字"
    } ]
  }, {
    "tStartMs": 1799333,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "可能怕吵醒媽媽"
    } ]
  }, {
    "tStartMs": 1800400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1801600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你聽見什麼聲音沒有"
    } ]
  }, {
    "tStartMs": 1803333,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "小藍剛想拿起手機問她聽什麼"
    } ]
  }, {
    "tStartMs": 1806900,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "就聽聽「噠噠噠」敲玻璃的聲音"
    } ]
  }, {
    "tStartMs": 1810966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "我還以為滴水聲音呢"
    } ]
  }, {
    "tStartMs": 1813600,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "你這個……你好可怕，你這個點太過分了"
    } ]
  }, {
    "tStartMs": 1817833,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "其實我聽到這"
    } ]
  }, {
    "tStartMs": 1821366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我就一直有個想法就是"
    } ]
  }, {
    "tStartMs": 1823333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "既然他們發現了這裡有這個房間不對"
    } ]
  }, {
    "tStartMs": 1825733,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "走啊或換呀"
    } ]
  }, {
    "tStartMs": 1828100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "可能"
    } ]
  }, {
    "tStartMs": 1830200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "有一點，自己懂點這個…"
    } ]
  }, {
    "tStartMs": 1832400,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "我也想"
    } ]
  }, {
    "tStartMs": 1832900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "而且他們就是皈依佛教了嘛"
    } ]
  }, {
    "tStartMs": 1835833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "也念了經文什麼的"
    } ]
  }, {
    "tStartMs": 1837033,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "就不怵這些東西"
    } ]
  }, {
    "tStartMs": 1838100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我們繼續往下聽啊"
    } ]
  }, {
    "tStartMs": 1842366,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "小藍回憶啊，當晚窗戶是拉著窗簾的"
    } ]
  }, {
    "tStartMs": 1846233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "所以這個「噠噠噠」的聲音啊"
    } ]
  }, {
    "tStartMs": 1848200,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "不知道是窗戶外面有東西在敲"
    } ]
  }, {
    "tStartMs": 1850800,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "嗯還是說，有東西藏在窗簾和窗戶中間"
    } ]
  }, {
    "tStartMs": 1854366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我去……這個好恐怖"
    } ]
  }, {
    "tStartMs": 1856333,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "對吧！小藍和阿姨嚇得夠嗆"
    } ]
  }, {
    "tStartMs": 1859233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但最後實在是撐不過睏意"
    } ]
  }, {
    "tStartMs": 1862400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "畢竟前一天，舟車勞頓的，還是睡著了"
    } ]
  }, {
    "tStartMs": 1865966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "就沒管那個「噠噠噠」了"
    } ]
  }, {
    "tStartMs": 1869200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "第二天早上6點起來"
    } ]
  }, {
    "tStartMs": 1870800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "一行人集合就去景點玩了"
    } ]
  }, {
    "tStartMs": 1873233,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "小藍雖然睏得要死啊"
    } ]
  }, {
    "tStartMs": 1875366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "黑眼圈都快掛地上了"
    } ]
  }, {
    "tStartMs": 1877133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "但是因為離開這個飯店了"
    } ]
  }, {
    "tStartMs": 1879366,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "那天白天玩起來心情還是不錯的"
    } ]
  }, {
    "tStartMs": 1882166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1883000,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "但是小藍後面才知道，這才是個開始"
    } ]
  }, {
    "tStartMs": 1886700,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "那東西一直跟著他們"
    } ]
  }, {
    "tStartMs": 1889300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "第二晚"
    } ]
  }, {
    "tStartMs": 1890133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小藍一行人入住了第二家飯店"
    } ]
  }, {
    "tStartMs": 1892766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "它這裡有佈局圖啊"
    } ]
  }, {
    "tStartMs": 1894566,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "他後面第一家酒店"
    } ]
  }, {
    "tStartMs": 1896533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "第二家飯店都有佈置圖"
    } ]
  }, {
    "tStartMs": 1898033,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我們會貼在動態，好的"
    } ]
  }, {
    "tStartMs": 1900533,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "然後b站會放在影片裡面"
    } ]
  }, {
    "tStartMs": 1903100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好嘞"
    } ]
  }, {
    "tStartMs": 1904800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "小藍說自己不懂風水"
    } ]
  }, {
    "tStartMs": 1906733,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1907133,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "但就是覺得這第二家飯店的房子"
    } ]
  }, {
    "tStartMs": 1909966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "格局特別奇怪"
    } ]
  }, {
    "tStartMs": 1911566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "廁所超大"
    } ]
  }, {
    "tStartMs": 1913566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "就和你剛才第一個故事一樣"
    } ]
  }, {
    "tStartMs": 1915500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1916533,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那個廁所呢"
    } ]
  }, {
    "tStartMs": 1917733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "甚至是比外面臥室區域還要大"
    } ]
  }, {
    "tStartMs": 1920700,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "這麼誇張"
    } ]
  }, {
    "tStartMs": 1921366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "對。而且廁所門一開"
    } ]
  }, {
    "tStartMs": 1923633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "盥洗台上的大鏡子正對床位"
    } ]
  }, {
    "tStartMs": 1927233,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小藍說自己也是膽肥"
    } ]
  }, {
    "tStartMs": 1929233,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "嗯當晚入住後，接著看恐怖小說"
    } ]
  }, {
    "tStartMs": 1932833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "哈哈哈！這是"
    } ]
  }, {
    "tStartMs": 1935133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "不是一般人啊"
    } ]
  }, {
    "tStartMs": 1935966,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不是一般人。太喜歡這個啊"
    } ]
  }, {
    "tStartMs": 1939200,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但這次沒看幾頁自己就不行了"
    } ]
  }, {
    "tStartMs": 1941800,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "嗯直接把書的封面扯下來了"
    } ]
  }, {
    "tStartMs": 1944433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "撕碎丟到垃圾桶裡"
    } ]
  }, {
    "tStartMs": 1946600,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "小藍開始覺得那個封面極度的恐怖"
    } ]
  }, {
    "tStartMs": 1949900,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "小藍說其實後面看起來"
    } ]
  }, {
    "tStartMs": 1951533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "那本書封面還挺正常的"
    } ]
  }, {
    "tStartMs": 1953900,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "書名，他也說了叫《14年獵鬼人》"
    } ]
  }, {
    "tStartMs": 1957766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "綠色的那本"
    } ]
  }, {
    "tStartMs": 1958700,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "聽過。我聽過就是說名字"
    } ]
  }, {
    "tStartMs": 1960566,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "撕完書以後一切就不對了"
    } ]
  }, {
    "tStartMs": 1963933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小藍跟媽媽她們說"
    } ]
  }, {
    "tStartMs": 1965533,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "廁所門必須打開，不能關上"
    } ]
  }, {
    "tStartMs": 1967933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "只要一關上嗯"
    } ]
  }, {
    "tStartMs": 1969600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我就覺得裡面有人，隔著門站那看自己"
    } ]
  }, {
    "tStartMs": 1974133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 1975000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "必須要開著門，開著燈，看著那鏡子"
    } ]
  }, {
    "tStartMs": 1977533,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "這天晚上剛開始小藍他們也是"
    } ]
  }, {
    "tStartMs": 1980900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "也沒看見什麼不好東西啊"
    } ]
  }, {
    "tStartMs": 1982566,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "嗯但就是莫名的恐懼"
    } ]
  }, {
    "tStartMs": 1984733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "就感覺自己要崩潰了"
    } ]
  }, {
    "tStartMs": 1986200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "控制不住害怕"
    } ]
  }, {
    "tStartMs": 1987933,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小藍的媽媽呢"
    } ]
  }, {
    "tStartMs": 1989033,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "第一天晚上即使是真的看到東西了"
    } ]
  }, {
    "tStartMs": 1992133,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "一直也是比較淡定的"
    } ]
  }, {
    "tStartMs": 1994233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但是到今天這個第二個晚上"
    } ]
  }, {
    "tStartMs": 1996833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "嗯他也快扛不住了"
    } ]
  }, {
    "tStartMs": 1998800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "媽媽和小藍和阿姨說啊"
    } ]
  }, {
    "tStartMs": 2001133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "晚上用手機放著誦經的聲音睡覺"
    } ]
  }, {
    "tStartMs": 2004333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "不然一定會出事"
    } ]
  }, {
    "tStartMs": 2005900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2007733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "媽媽和阿姨兩個人啊"
    } ]
  }, {
    "tStartMs": 2008933,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "甚至給寺廟的師傅"
    } ]
  }, {
    "tStartMs": 2010433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "和一個會看事的大姨打個電話"
    } ]
  }, {
    "tStartMs": 2012933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "但可惜沒打通"
    } ]
  }, {
    "tStartMs": 2014966,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "師傅的和大姨都沒打通？對"
    } ]
  }, {
    "tStartMs": 2017966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "沒辦法"
    } ]
  }, {
    "tStartMs": 2019333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "三個人只能硬著頭皮睡了"
    } ]
  }, {
    "tStartMs": 2021300,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "這次小藍他們學聰明了"
    } ]
  }, {
    "tStartMs": 2023333,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "直接把行李堆在另一張床上"
    } ]
  }, {
    "tStartMs": 2026133,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "三個人就是擠在一張床上"
    } ]
  }, {
    "tStartMs": 2028033,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "也不聊天了"
    } ]
  }, {
    "tStartMs": 2029233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "直接醞釀睡意"
    } ]
  }, {
    "tStartMs": 2030633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "就不走流程，直接睡覺"
    } ]
  }, {
    "tStartMs": 2033166,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "手中的誦經"
    } ]
  }, {
    "tStartMs": 2034433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "誦經的聲音啊放的很大"
    } ]
  }, {
    "tStartMs": 2036200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "確實是有一點效果"
    } ]
  }, {
    "tStartMs": 2037833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "三個人很快就睡著了"
    } ]
  }, {
    "tStartMs": 2039733,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "小藍說"
    } ]
  }, {
    "tStartMs": 2040966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "自己就是那種一覺睡到天亮的人啊"
    } ]
  }, {
    "tStartMs": 2043966,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但是那天晚上小藍半夜被凍醒"
    } ]
  }, {
    "tStartMs": 2047400,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "小藍說真的很冷"
    } ]
  }, {
    "tStartMs": 2049166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "抬頭看看呢"
    } ]
  }, {
    "tStartMs": 2050500,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "空調他們開的是暖風"
    } ]
  }, {
    "tStartMs": 2053366,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "而且是8月份"
    } ]
  }, {
    "tStartMs": 2054733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "三人穿著不薄的衣服"
    } ]
  }, {
    "tStartMs": 2056333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "擠在一個厚被子裡面"
    } ]
  }, {
    "tStartMs": 2057600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "按小藍的話說"
    } ]
  }, {
    "tStartMs": 2058833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "不熱死就算好的了"
    } ]
  }, {
    "tStartMs": 2060500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2061500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "自己居然是被凍醒了"
    } ]
  }, {
    "tStartMs": 2063300,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "是那種刺的慌的冷"
    } ]
  }, {
    "tStartMs": 2065566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "小藍突然覺得，哪裡有點不對勁"
    } ]
  }, {
    "tStartMs": 2068966,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "但是一時半會不知道哪裡出了問題"
    } ]
  }, {
    "tStartMs": 2071600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "山裡面窗戶打開比較冷"
    } ]
  }, {
    "tStartMs": 2073533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "不是，你聽啊"
    } ]
  }, {
    "tStartMs": 2075233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "想了會明白過來"
    } ]
  }, {
    "tStartMs": 2077200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "環境太安靜了"
    } ]
  }, {
    "tStartMs": 2079133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "誦經的聲音停了"
    } ]
  }, {
    "tStartMs": 2081000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "經文聲沒了？對"
    } ]
  }, {
    "tStartMs": 2082400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "小藍不知道（誦經）是什麼時候停下來的"
    } ]
  }, {
    "tStartMs": 2085133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "也不敢把手從被子裡面伸出來"
    } ]
  }, {
    "tStartMs": 2087300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "去拿手機"
    } ]
  }, {
    "tStartMs": 2088166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "但是那個手機"
    } ]
  }, {
    "tStartMs": 2089700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "設定的是不會熄畫面的"
    } ]
  }, {
    "tStartMs": 2091233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "而且一直充著電"
    } ]
  }, {
    "tStartMs": 2093200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "沒人動它絕對不會停的"
    } ]
  }, {
    "tStartMs": 2095000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小藍這下真的毛了"
    } ]
  }, {
    "tStartMs": 2097100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "推了推媽媽和阿姨"
    } ]
  }, {
    "tStartMs": 2098600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "誰也沒醒"
    } ]
  }, {
    "tStartMs": 2100566,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "就這個晚上輪到小藍遭殃了"
    } ]
  }, {
    "tStartMs": 2103100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "獨自恐怖。對"
    } ]
  }, {
    "tStartMs": 2105000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "廁所門還是沒關，還開著的"
    } ]
  }, {
    "tStartMs": 2107566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2108733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "小藍跟我說，不知道當時怎麼想的"
    } ]
  }, {
    "tStartMs": 2111933,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "真的很欠"
    } ]
  }, {
    "tStartMs": 2113200,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "稍微抬起點身子"
    } ]
  }, {
    "tStartMs": 2115433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "想去看看廁所裡面的鏡子"
    } ]
  }, {
    "tStartMs": 2117400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "小藍說真的"
    } ]
  }, {
    "tStartMs": 2119600,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "那一眼之後啊，自己腸子都悔青了"
    } ]
  }, {
    "tStartMs": 2122366,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2122833,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "那個女g"
    } ]
  }, {
    "tStartMs": 2124400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "在鏡子裡面扒著門框"
    } ]
  }, {
    "tStartMs": 2126400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "看著他們三個人睡覺"
    } ]
  }, {
    "tStartMs": 2127800,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我去！就像那種捉迷藏的小孩"
    } ]
  }, {
    "tStartMs": 2131133,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "身體在廁所裡面，歪著頭探了出來"
    } ]
  }, {
    "tStartMs": 2135000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "小藍整個人都不敢動了……也不敢呼吸……"
    } ]
  }, {
    "tStartMs": 2137633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "我去！一點點的躺回被窩裡面"
    } ]
  }, {
    "tStartMs": 2140166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "整個人都僵直了"
    } ]
  }, {
    "tStartMs": 2141733,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "小藍當晚是一宿沒睡"
    } ]
  }, {
    "tStartMs": 2144100,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "一直熬到了天亮"
    } ]
  }, {
    "tStartMs": 2146766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "你知道我想到什麼嗎"
    } ]
  }, {
    "tStartMs": 2148200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是我想到，這個女g"
    } ]
  }, {
    "tStartMs": 2150400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是不是他第一個故事床下的那個女g"
    } ]
  }, {
    "tStartMs": 2153700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "是一個女g"
    } ]
  }, {
    "tStartMs": 2155166,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "對呀！你想啥呢"
    } ]
  }, {
    "tStartMs": 2156533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "而且那個女g，我跟你講"
    } ]
  }, {
    "tStartMs": 2157900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "你剛剛跟我講完之後"
    } ]
  }, {
    "tStartMs": 2159166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "我腦補的是什麼"
    } ]
  }, {
    "tStartMs": 2160333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "是伊藤潤二的有一個漫畫"
    } ]
  }, {
    "tStartMs": 2162400,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "嗯講的是一群人請了一個模特兒到"
    } ]
  }, {
    "tStartMs": 2165800,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "森林裡面拍東西"
    } ]
  }, {
    "tStartMs": 2166933,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然後那個模特兒"
    } ]
  }, {
    "tStartMs": 2167833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "長得就跟你形容的一模一樣"
    } ]
  }, {
    "tStartMs": 2169366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "喔……我好像看過那個滿嘴"
    } ]
  }, {
    "tStartMs": 2171100,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "尖牙"
    } ]
  }, {
    "tStartMs": 2171433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "對，我看我第一個反應好像也是她"
    } ]
  }, {
    "tStartMs": 2173733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我看過那個解析的，就是對短片解析"
    } ]
  }, {
    "tStartMs": 2176600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "到時候叫阿偉把這個配在裡面"
    } ]
  }, {
    "tStartMs": 2178833,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "太可怕了"
    } ]
  }, {
    "tStartMs": 2180366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我穿著背心，吹著空調"
    } ]
  }, {
    "tStartMs": 2182033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我也有點冷…"
    } ]
  }, {
    "tStartMs": 2183800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我剛才起雞皮疙瘩"
    } ]
  }, {
    "tStartMs": 2185033,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然後你發現，其實今天我沒有錄音"
    } ]
  }, {
    "tStartMs": 2187166,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "你手機突然收了個簡訊："
    } ]
  }, {
    "tStartMs": 2189500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "妙妙今天我們錄音吧！"
    } ]
  }, {
    "tStartMs": 2190700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你別放屁啊！"
    } ]
  }, {
    "tStartMs": 2192133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "好，我們繼續啊"
    } ]
  }, {
    "tStartMs": 2193200,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "第三天小藍一行人"
    } ]
  }, {
    "tStartMs": 2196700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "住回了第一天的飯店"
    } ]
  }, {
    "tStartMs": 2198200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2199033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "但是，還好是不同房間啊"
    } ]
  }, {
    "tStartMs": 2201300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "這邊依然是有佈局圖"
    } ]
  }, {
    "tStartMs": 2203366,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "嗯小藍他們玩了一天啊"
    } ]
  }, {
    "tStartMs": 2205433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "晚上回到飯店就開始洗漱"
    } ]
  }, {
    "tStartMs": 2207400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "媽媽陪小藍阿姨洗完以後啊"
    } ]
  }, {
    "tStartMs": 2210366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "自己是最後洗的"
    } ]
  }, {
    "tStartMs": 2212000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "洗完後坐在床邊吹頭髮"
    } ]
  }, {
    "tStartMs": 2214933,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "此處有插圖"
    } ]
  }, {
    "tStartMs": 2216966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "有位置插圖"
    } ]
  }, {
    "tStartMs": 2218933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "媽媽是低頭吹頭髮的"
    } ]
  }, {
    "tStartMs": 2221533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "因為小藍他們一晚都在聊天"
    } ]
  }, {
    "tStartMs": 2224566,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "所以電視一直沒開，是熄畫面的狀態嗯"
    } ]
  }, {
    "tStartMs": 2228333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "小藍媽媽吹著吹著"
    } ]
  }, {
    "tStartMs": 2229900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "就從吹起頭髮縫隙中"
    } ]
  }, {
    "tStartMs": 2232100,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "朝前看正好看到電視"
    } ]
  }, {
    "tStartMs": 2234433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "因為電視黑屏是會反光的嗎"
    } ]
  }, {
    "tStartMs": 2236533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "就從那模糊的反光裡"
    } ]
  }, {
    "tStartMs": 2239000,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "隱約看到自己身後，就坐著那個女的"
    } ]
  }, {
    "tStartMs": 2243333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "白衣服，一隻腿放床上"
    } ]
  }, {
    "tStartMs": 2246100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "另外一隻腿，在床底下耷拉著"
    } ]
  }, {
    "tStartMs": 2248700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "還一晃一晃的"
    } ]
  }, {
    "tStartMs": 2250133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2250966,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "據小藍媽媽事後回憶"
    } ]
  }, {
    "tStartMs": 2255300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "好像這個女鬼"
    } ]
  }, {
    "tStartMs": 2256433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "從頭到尾都沒有見過她的眼睛"
    } ]
  }, {
    "tStartMs": 2259166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "然後這邊標了女鬼的位置"
    } ]
  }, {
    "tStartMs": 2262800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "但是也沒有什麼好方法啊"
    } ]
  }, {
    "tStartMs": 2264233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "媽媽就硬撐著，把頭髮吹完了"
    } ]
  }, {
    "tStartMs": 2268366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "一抬頭女兒不見了"
    } ]
  }, {
    "tStartMs": 2271000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "小藍媽媽趕緊把眼睛閉上"
    } ]
  }, {
    "tStartMs": 2272933,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "心裡默念阿彌陀佛"
    } ]
  }, {
    "tStartMs": 2275133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "手裡握著脖子上的小牌"
    } ]
  }, {
    "tStartMs": 2278133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "小藍說，這其實是小塑膠盒子"
    } ]
  }, {
    "tStartMs": 2280600,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "裡面裝的是金色的，縮印的楞嚴咒"
    } ]
  }, {
    "tStartMs": 2284733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "在廟裡也開過光的"
    } ]
  }, {
    "tStartMs": 2287600,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "這件事啊"
    } ]
  }, {
    "tStartMs": 2288933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "當晚媽媽沒敢跟小藍他們說"
    } ]
  }, {
    "tStartMs": 2291333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "第二天才告訴他們的"
    } ]
  }, {
    "tStartMs": 2293533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "結果就是，阿姨告訴媽媽"
    } ]
  }, {
    "tStartMs": 2295600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "當時小藍媽媽站起來後"
    } ]
  }, {
    "tStartMs": 2297566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "那女的就站她身後"
    } ]
  }, {
    "tStartMs": 2299933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "就是和她一起從床上站起來"
    } ]
  }, {
    "tStartMs": 2302233,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2303000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "但不像是肉眼看見的"
    } ]
  }, {
    "tStartMs": 2304966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "感覺是腦中出現的影像"
    } ]
  }, {
    "tStartMs": 2308166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "她們也太…"
    } ]
  }, {
    "tStartMs": 2309333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "三天結束啊"
    } ]
  }, {
    "tStartMs": 2311400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "小藍回憶這幾天玩也沒玩好"
    } ]
  }, {
    "tStartMs": 2314000,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "住也沒住"
    } ]
  }, {
    "tStartMs": 2315133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "吃也沒吃好"
    } ]
  }, {
    "tStartMs": 2316900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "一行人終於呢上了回程的車"
    } ]
  }, {
    "tStartMs": 2319900,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2320533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "媽媽在車上給小藍的爸爸、舅舅打電話"
    } ]
  }, {
    "tStartMs": 2323933,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "讓他們來接站"
    } ]
  }, {
    "tStartMs": 2324933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "按小藍的話"
    } ]
  }, {
    "tStartMs": 2327366,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "他們可以說是興致勃勃去"
    } ]
  }, {
    "tStartMs": 2329633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "屁滾尿流的回"
    } ]
  }, {
    "tStartMs": 2331766,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "在車上呢"
    } ]
  }, {
    "tStartMs": 2332633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "是睡了這幾天以來最好的一覺"
    } ]
  }, {
    "tStartMs": 2335133,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "下了車小藍一行，把行李丟上車"
    } ]
  }, {
    "tStartMs": 2338933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "都沒敢回家，直接開車去了寺廟"
    } ]
  }, {
    "tStartMs": 2341833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "師傅說問題不大"
    } ]
  }, {
    "tStartMs": 2343966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "磕幾個頭拜一拜燒個香，就沒事了"
    } ]
  }, {
    "tStartMs": 2346366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "回家就好"
    } ]
  }, {
    "tStartMs": 2347233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "然而事情還沒結束"
    } ]
  }, {
    "tStartMs": 2349533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "我去"
    } ]
  }, {
    "tStartMs": 2350166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "是的，跟著來了。對"
    } ]
  }, {
    "tStartMs": 2352733,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "小藍他沒想到那東西一路跟著回來了"
    } ]
  }, {
    "tStartMs": 2356566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "跟進了小藍的家"
    } ]
  }, {
    "tStartMs": 2358166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "小藍晚上睡覺時"
    } ]
  }, {
    "tStartMs": 2359933,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "一直聽見客廳裡有來回走路的聲音"
    } ]
  }, {
    "tStartMs": 2363766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "後面開始慢慢的聽見有"
    } ]
  }, {
    "tStartMs": 2366233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "有節奏的敲門聲"
    } ]
  }, {
    "tStartMs": 2368166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "聲音很輕啊"
    } ]
  }, {
    "tStartMs": 2369333,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "但明顯感覺不是在正常的位置敲"
    } ]
  }, {
    "tStartMs": 2372833,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2373133,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "好像有個人，趴在地上敲門腳的聲音"
    } ]
  }, {
    "tStartMs": 2378733,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "第二天早上一起來"
    } ]
  }, {
    "tStartMs": 2380566,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "媽媽就給那個阿姨打電話"
    } ]
  }, {
    "tStartMs": 2382600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "兩人第一句話都是"
    } ]
  }, {
    "tStartMs": 2384200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那女的是不是跟回家了"
    } ]
  }, {
    "tStartMs": 2386433,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "就等於說，這個女的，她在小藍家作祟了"
    } ]
  }, {
    "tStartMs": 2389933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "不是女的，是女g啊"
    } ]
  }, {
    "tStartMs": 2391633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "又到了阿姨家。是的"
    } ]
  }, {
    "tStartMs": 2394300,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "不得已啊"
    } ]
  }, {
    "tStartMs": 2395633,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "小藍他們又去寺廟，單獨找了師傅"
    } ]
  }, {
    "tStartMs": 2398233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "這把就是"
    } ]
  }, {
    "tStartMs": 2400166,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "回來以後發生的事，又和師傅講明了"
    } ]
  }, {
    "tStartMs": 2403033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "嗯師傅也開始重視起來"
    } ]
  }, {
    "tStartMs": 2405533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "又給三人灌了頂"
    } ]
  }, {
    "tStartMs": 2407500,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "又讓他們去寺廟門口土地廟拜了一拜"
    } ]
  }, {
    "tStartMs": 2410766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "據小藍說"
    } ]
  }, {
    "tStartMs": 2412500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "這個女人之後就再也沒有跟到他們了"
    } ]
  }, {
    "tStartMs": 2415333,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "那東西似乎呢，是留在寺廟裡面修行了"
    } ]
  }, {
    "tStartMs": 2419033,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2419766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "有個安身的地方"
    } ]
  }, {
    "tStartMs": 2421233,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "後來媽媽和小藍說啊"
    } ]
  }, {
    "tStartMs": 2422900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "這個女人一開始就找他們"
    } ]
  }, {
    "tStartMs": 2425133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "嗯可能是因為媽媽"
    } ]
  }, {
    "tStartMs": 2426766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "和阿姨在賓館裡面啊"
    } ]
  }, {
    "tStartMs": 2428533,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "是第一晚在賓館裡面誦經"
    } ]
  }, {
    "tStartMs": 2431200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "包括聊到了一些"
    } ]
  }, {
    "tStartMs": 2432500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "寺廟和靈異有關的事情"
    } ]
  }, {
    "tStartMs": 2434766,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "難怪"
    } ]
  }, {
    "tStartMs": 2435200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "這個女人可能覺得小藍一行可以看到她"
    } ]
  }, {
    "tStartMs": 2438500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "或有能力幫她"
    } ]
  }, {
    "tStartMs": 2440533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "所以跟上來了"
    } ]
  }, {
    "tStartMs": 2441433,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "對。畢竟從頭到尾她雖然是挺嚇人"
    } ]
  }, {
    "tStartMs": 2444600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但是沒有做出什麼傷害性的舉動啊"
    } ]
  }, {
    "tStartMs": 2447100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "是的，還好沒做過…這個故事"
    } ]
  }, {
    "tStartMs": 2449566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "其實"
    } ]
  }, {
    "tStartMs": 2451400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我改稿子時候，最恐怖的一點就是"
    } ]
  }, {
    "tStartMs": 2455366,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "姥姥姥爺呢？"
    } ]
  }, {
    "tStartMs": 2457133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "哦！是吧！就在故事裡面沒出現"
    } ]
  }, {
    "tStartMs": 2459200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "對！我反應過來，我趕緊問小藍"
    } ]
  }, {
    "tStartMs": 2460933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我說他們人呢"
    } ]
  }, {
    "tStartMs": 2462500,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "小藍說就是，他們完全沒事有影響"
    } ]
  }, {
    "tStartMs": 2464966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "幾天玩的特別好啊"
    } ]
  }, {
    "tStartMs": 2466433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就沒提到他們而已"
    } ]
  }, {
    "tStartMs": 2468233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "就是我嚇到我了！我真的真的沒了…"
    } ]
  }, {
    "tStartMs": 2471633,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "還好啊"
    } ]
  }, {
    "tStartMs": 2472433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那其實你記得嗎，我們之前台灣的那個"
    } ]
  }, {
    "tStartMs": 2476500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "懂一些的這個大師"
    } ]
  }, {
    "tStartMs": 2477833,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "嗯也是"
    } ]
  }, {
    "tStartMs": 2478333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "鯰魚也早，我們最早的"
    } ]
  }, {
    "tStartMs": 2480133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "這台灣省的粉絲啊"
    } ]
  }, {
    "tStartMs": 2481433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他說"
    } ]
  }, {
    "tStartMs": 2482333,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "往往在寺廟的地方，反而會滋生這些（靈）…"
    } ]
  }, {
    "tStartMs": 2486300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "對對！我記得這些！對吧"
    } ]
  }, {
    "tStartMs": 2487966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "徘徊的靈"
    } ]
  }, {
    "tStartMs": 2489166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "他們想往生之類的。對對對"
    } ]
  }, {
    "tStartMs": 2491966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "但其實又讓我想到了一個"
    } ]
  }, {
    "tStartMs": 2493533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是之前，也是咱們的這個焦大師說的"
    } ]
  }, {
    "tStartMs": 2496166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就是說"
    } ]
  }, {
    "tStartMs": 2497600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "靈啊，就這種惡L"
    } ]
  }, {
    "tStartMs": 2498833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "有一點惡的這種靈"
    } ]
  }, {
    "tStartMs": 2500300,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "或者是，不能說惡吧"
    } ]
  }, {
    "tStartMs": 2501733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "是說，執念很強的靈"
    } ]
  }, {
    "tStartMs": 2504600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "它即便是執念很強"
    } ]
  }, {
    "tStartMs": 2505966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "它也不能離開它埋骨地太遠"
    } ]
  }, {
    "tStartMs": 2509233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "有這種設定。對"
    } ]
  }, {
    "tStartMs": 2511033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "所以其實這個靈它跟小藍來回"
    } ]
  }, {
    "tStartMs": 2514966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "返程而出現"
    } ]
  }, {
    "tStartMs": 2517433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那證明要嘛就是這個靈"
    } ]
  }, {
    "tStartMs": 2519166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "它的念力真的很強"
    } ]
  }, {
    "tStartMs": 2521300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "要嘛就是，小藍其實離長白山不遠"
    } ]
  }, {
    "tStartMs": 2525533,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "嗯。這個我倒是沒問他位置啊"
    } ]
  }, {
    "tStartMs": 2528300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小藍應該東北人"
    } ]
  }, {
    "tStartMs": 2529566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "他的形容有些是東北語氣"
    } ]
  }, {
    "tStartMs": 2533133,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "這可能是我改成東北語氣了"
    } ]
  }, {
    "tStartMs": 2535333,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "你應該"
    } ]
  }, {
    "tStartMs": 2535800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "不知道這個東北語氣吧"
    } ]
  }, {
    "tStartMs": 2537333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "啊，是吧。這個我倒是沒問啊"
    } ]
  }, {
    "tStartMs": 2539966,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "其實和之前你一個故事裡面，叫劉哥的"
    } ]
  }, {
    "tStartMs": 2544033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "好像好多人叫劉哥"
    } ]
  }, {
    "tStartMs": 2545233,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "就那時候是從外地帶回來的靈吧"
    } ]
  }, {
    "tStartMs": 2548133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "也是能力很強的一個靈"
    } ]
  }, {
    "tStartMs": 2551533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "你記得吧"
    } ]
  }, {
    "tStartMs": 2552166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "記得，記得，記得"
    } ]
  }, {
    "tStartMs": 2552933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "對，他們出差回來，帶回來的"
    } ]
  }, {
    "tStartMs": 2554700,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "是的，是的，是的"
    } ]
  }, {
    "tStartMs": 2556433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "這小藍跟我講"
    } ]
  }, {
    "tStartMs": 2558200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "因為他家裡面信這個也遇不少事"
    } ]
  }, {
    "tStartMs": 2561400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "他可能之後也會投更多精彩的故事"
    } ]
  }, {
    "tStartMs": 2564566,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "期待，期待一下"
    } ]
  }, {
    "tStartMs": 2565733,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "好的好的"
    } ]
  }, {
    "tStartMs": 2566366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "反正這個故事到這邊。好嘞"
    } ]
  }, {
    "tStartMs": 2572733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "好，今天的第三個故事呢"
    } ]
  }, {
    "tStartMs": 2574100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "來自於我們小紅書的魚友"
    } ]
  }, {
    "tStartMs": 2575533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "皺月"
    } ]
  }, {
    "tStartMs": 2576933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "皺紋的“皺”，月亮的“月”"
    } ]
  }, {
    "tStartMs": 2578533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我們下面稱呼她為小月"
    } ]
  }, {
    "tStartMs": 2580566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "小月的故事比較短，但是細思極恐啊"
    } ]
  }, {
    "tStartMs": 2583900,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "那故事發生在去年夏天，也就是22年"
    } ]
  }, {
    "tStartMs": 2587366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "大概就是中元節前後"
    } ]
  }, {
    "tStartMs": 2589400,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "小月說自己呢"
    } ]
  }, {
    "tStartMs": 2590500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "偶爾會遇到一些靈異事件"
    } ]
  }, {
    "tStartMs": 2592600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "所以對這些事情還是比較在意的"
    } ]
  }, {
    "tStartMs": 2595233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "那特別像是中元節啊"
    } ]
  }, {
    "tStartMs": 2596933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "寒食節這一類的節慶啊"
    } ]
  }, {
    "tStartMs": 2598833,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "她都會特別小心"
    } ]
  }, {
    "tStartMs": 2600966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "但今年，因為是她們有一個小組"
    } ]
  }, {
    "tStartMs": 2603200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "作業特別忙"
    } ]
  }, {
    "tStartMs": 2604500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "就沒有像往年那麼細緻"
    } ]
  }, {
    "tStartMs": 2607133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那因為她的疏忽呢"
    } ]
  }, {
    "tStartMs": 2608800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她那天傍晚跟著媽媽出門了"
    } ]
  }, {
    "tStartMs": 2611566,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "小月跟媽媽是準備去姥姥姥爺家嗯"
    } ]
  }, {
    "tStartMs": 2614833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "準備去吃飯的啊"
    } ]
  }, {
    "tStartMs": 2616300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "然後那天呢，當時天色擦黑"
    } ]
  }, {
    "tStartMs": 2619233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "媽媽就騎著電動車帶她"
    } ]
  }, {
    "tStartMs": 2621433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "媽媽可能是比較急著去姥姥家"
    } ]
  }, {
    "tStartMs": 2624033,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "就抄了一條小徑，平常不太走的地方"
    } ]
  }, {
    "tStartMs": 2626633,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "小月說呢，那條路啊很小很窄"
    } ]
  }, {
    "tStartMs": 2631400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "雖然談不上逼仄"
    } ]
  }, {
    "tStartMs": 2633100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "但估計汽車通過是比較勉強的"
    } ]
  }, {
    "tStartMs": 2636300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "路的兩邊呢是小樹林"
    } ]
  }, {
    "tStartMs": 2638700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "感覺有點陰森森的"
    } ]
  }, {
    "tStartMs": 2640300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就在小月百無聊賴的時候啊"
    } ]
  }, {
    "tStartMs": 2643000,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "她突然看到了一座"
    } ]
  }, {
    "tStartMs": 2644566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "新墳嗯"
    } ]
  }, {
    "tStartMs": 2646566,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "她給我說"
    } ]
  }, {
    "tStartMs": 2647166,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "她說"
    } ]
  }, {
    "tStartMs": 2647566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "她第一時間就意識到，那是一座新墳"
    } ]
  }, {
    "tStartMs": 2650133,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "為什麼呢"
    } ]
  }, {
    "tStartMs": 2650900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "首先，這個周圍一直是沒有什麼"
    } ]
  }, {
    "tStartMs": 2653133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "墳地或者墳堆的"
    } ]
  }, {
    "tStartMs": 2654766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那突然出現的這一個墳墓"
    } ]
  }, {
    "tStartMs": 2656533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "就顯得很突兀"
    } ]
  }, {
    "tStartMs": 2658100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "而且這墳地上的這個花圈啊"
    } ]
  }, {
    "tStartMs": 2660966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "是看上去就比較新"
    } ]
  }, {
    "tStartMs": 2663300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "那小月還沒反應過來"
    } ]
  }, {
    "tStartMs": 2665300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "又發現了哎"
    } ]
  }, {
    "tStartMs": 2666800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "這個墳邊的樹上纏著一些紅繩"
    } ]
  }, {
    "tStartMs": 2671400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "其實，我這邊先補充就是"
    } ]
  }, {
    "tStartMs": 2674366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "綁紅繩不奇怪"
    } ]
  }, {
    "tStartMs": 2676000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "因為民間有一些說法是說，在這個"
    } ]
  }, {
    "tStartMs": 2679333,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "祖先墳墓的這個樹上綁紅塵是"
    } ]
  }, {
    "tStartMs": 2682533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "寓意著把這場災難綁在野外"
    } ]
  }, {
    "tStartMs": 2685500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "也可以保佑這個子孫後代紅紅火火"
    } ]
  }, {
    "tStartMs": 2688800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2690100,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那你上墳會綁紅繩"
    } ]
  }, {
    "tStartMs": 2692566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我們家好像沒有這個習慣哎"
    } ]
  }, {
    "tStartMs": 2696200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我們家每年啊"
    } ]
  }, {
    "tStartMs": 2697766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "上我爺爺奶奶和外公外婆的時候"
    } ]
  }, {
    "tStartMs": 2700200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "不僅我們自己綁"
    } ]
  }, {
    "tStartMs": 2701366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "我還看到"
    } ]
  }, {
    "tStartMs": 2702400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "就是因為我們都是南京公墓嗎"
    } ]
  }, {
    "tStartMs": 2703966,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 2704566,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "會有其他的樹上面也會綁"
    } ]
  }, {
    "tStartMs": 2707033,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是嗎？我們還真沒有這個習慣"
    } ]
  }, {
    "tStartMs": 2710100,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就是可能我們看到的這個"
    } ]
  }, {
    "tStartMs": 2712433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "些許差異。對對對"
    } ]
  }, {
    "tStartMs": 2714833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我們再書歸正題"
    } ]
  }, {
    "tStartMs": 2716033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我們回到小月這個故事裡面"
    } ]
  }, {
    "tStartMs": 2717733,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "小月投稿裡面說啊"
    } ]
  }, {
    "tStartMs": 2718800,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "她說"
    } ]
  }, {
    "tStartMs": 2719200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "其實她看到這個樹上的紅繩的時候"
    } ]
  }, {
    "tStartMs": 2721700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "自己並沒有特別奇怪"
    } ]
  }, {
    "tStartMs": 2723633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但是奇怪的是"
    } ]
  }, {
    "tStartMs": 2725333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她發現這個墓碑上也綁著紅繩"
    } ]
  }, {
    "tStartMs": 2728500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "特別是，她媽媽騎車經過的時候"
    } ]
  }, {
    "tStartMs": 2731100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "她回頭還瞥了一眼"
    } ]
  }, {
    "tStartMs": 2732900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "她看到這個墓碑正面是紅繩"
    } ]
  }, {
    "tStartMs": 2736033,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "背面紅繩竟然掛著幾張黃符"
    } ]
  }, {
    "tStartMs": 2740533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "那因為她媽媽騎車的速度比較快"
    } ]
  }, {
    "tStartMs": 2742733,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "沒有減速嘛"
    } ]
  }, {
    "tStartMs": 2743600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "嗯所以她並沒有看清"
    } ]
  }, {
    "tStartMs": 2745200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "這個上面到底是什麼樣的符咒"
    } ]
  }, {
    "tStartMs": 2748133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "果然"
    } ]
  }, {
    "tStartMs": 2749000,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "當天晚上回家之後，小月被gyc了"
    } ]
  }, {
    "tStartMs": 2752333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "那gyc的具體的這個情況啊"
    } ]
  }, {
    "tStartMs": 2754166,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "小月也沒跟我說"
    } ]
  }, {
    "tStartMs": 2755100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我們就暫時不說了"
    } ]
  }, {
    "tStartMs": 2756300,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "應該跟故事沒什麼關係"
    } ]
  }, {
    "tStartMs": 2757533,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2758133,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "但小月說她自己家裡面是信佛"
    } ]
  }, {
    "tStartMs": 2761600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "所以跟之前都是一樣啊"
    } ]
  }, {
    "tStartMs": 2763566,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "她就佈置了很多禮佛用的香爐啊"
    } ]
  }, {
    "tStartMs": 2766166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "佛像什麼的"
    } ]
  }, {
    "tStartMs": 2767166,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "不知道為什麼這樣還會被gyc"
    } ]
  }, {
    "tStartMs": 2770300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "然後我就追問她嘛"
    } ]
  }, {
    "tStartMs": 2771500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "我說gyc無所謂"
    } ]
  }, {
    "tStartMs": 2774233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "但是你告訴我大概是什麼狀況"
    } ]
  }, {
    "tStartMs": 2776233,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "她說自己不是特別清楚了"
    } ]
  }, {
    "tStartMs": 2778166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "細節呢"
    } ]
  }, {
    "tStartMs": 2779800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就是恐怖的細節沒有忘記"
    } ]
  }, {
    "tStartMs": 2782033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "就是自己出現這個gyc的這個時間"
    } ]
  }, {
    "tStartMs": 2784966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是出現這個事情之後啊"
    } ]
  }, {
    "tStartMs": 2786900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "時間大概是凌晨3點"
    } ]
  }, {
    "tStartMs": 2788933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "嗯他一直試著睜開眼睛"
    } ]
  }, {
    "tStartMs": 2790900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "但怎麼睜都"
    } ]
  }, {
    "tStartMs": 2792000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "沒有辦法（睜開眼睛），睜不開"
    } ]
  }, {
    "tStartMs": 2792966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2794166,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "突然呢"
    } ]
  }, {
    "tStartMs": 2794733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "她就聽到有人在敲自己的臥室門"
    } ]
  }, {
    "tStartMs": 2798166,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "剛開始時「咚咚咚」的敲門聲"
    } ]
  }, {
    "tStartMs": 2801333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "隨著時間的推移，慢慢的變成了撞門"
    } ]
  }, {
    "tStartMs": 2804400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我靠！小月說啊"
    } ]
  }, {
    "tStartMs": 2806333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "她說自己的門上面"
    } ]
  }, {
    "tStartMs": 2808033,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "有媽媽從寺廟裡面求來的開光的符咒"
    } ]
  }, {
    "tStartMs": 2811733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "因為自己之前也會做惡夢"
    } ]
  }, {
    "tStartMs": 2813766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "所以她媽就求了這個符咒"
    } ]
  }, {
    "tStartMs": 2815733,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 2816400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "現在感覺這個門，被撞的「嘣嘣嘣」作響"
    } ]
  }, {
    "tStartMs": 2820233,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "她甚至能聽到這個符，佛家的符"
    } ]
  }, {
    "tStartMs": 2824500,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "佛咒的這個鍊子撞在門上的聲響"
    } ]
  }, {
    "tStartMs": 2828700,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就說這個東西（符咒）對這個撞門的（阿飄）"
    } ]
  }, {
    "tStartMs": 2830933,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "沒有任何影響"
    } ]
  }, {
    "tStartMs": 2832566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "是啊"
    } ]
  }, {
    "tStartMs": 2834133,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小月說時間不知道持續了多久"
    } ]
  }, {
    "tStartMs": 2836500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "她突然就聽到哎撞門聲停了"
    } ]
  }, {
    "tStartMs": 2838833,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "她能動她就趕緊翻身起床"
    } ]
  }, {
    "tStartMs": 2841200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "一看時間凌晨4點"
    } ]
  }, {
    "tStartMs": 2842900,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "她這時候就​​心有餘悸"
    } ]
  }, {
    "tStartMs": 2844300,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "完全不敢開門嘛"
    } ]
  }, {
    "tStartMs": 2845533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "啊一直等到日出"
    } ]
  }, {
    "tStartMs": 2847333,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "她趕緊跑出去"
    } ]
  }, {
    "tStartMs": 2848900,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "跑到父母的這個房間"
    } ]
  }, {
    "tStartMs": 2850400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "把她爸媽都叫醒了"
    } ]
  }, {
    "tStartMs": 2851766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "然後就問他們有沒有聽到"
    } ]
  }, {
    "tStartMs": 2853333,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "昨晚有人敲門"
    } ]
  }, {
    "tStartMs": 2854566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "那爸媽都說沒聽到"
    } ]
  }, {
    "tStartMs": 2855800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "肯定沒聽到"
    } ]
  }, {
    "tStartMs": 2856833,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "對，然後故事到這邊就結束了哦"
    } ]
  }, {
    "tStartMs": 2860600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "沒了。就是個叫"
    } ]
  }, {
    "tStartMs": 2862133,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "這個撞門有點過分了"
    } ]
  }, {
    "tStartMs": 2864233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "是的，是的"
    } ]
  }, {
    "tStartMs": 2865300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "所以其實這個"
    } ]
  }, {
    "tStartMs": 2866366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "乍聽之下也是沒什麼結尾的故事啊"
    } ]
  }, {
    "tStartMs": 2868333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "虎頭蛇尾"
    } ]
  }, {
    "tStartMs": 2869333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "但是呢"
    } ]
  }, {
    "tStartMs": 2870300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "也挺好，證明是小月起碼是平安的"
    } ]
  }, {
    "tStartMs": 2874300,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "還是我覺得加強一點"
    } ]
  }, {
    "tStartMs": 2877566,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "防禦工事"
    } ]
  }, {
    "tStartMs": 2878600,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "要不再多加強點防禦工事"
    } ]
  }, {
    "tStartMs": 2882033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我覺得可能是小月她（體質）比較"
    } ]
  }, {
    "tStartMs": 2884033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "敏感，在這個方面"
    } ]
  }, {
    "tStartMs": 2885333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "所以她當時去這個"
    } ]
  }, {
    "tStartMs": 2888033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "她自己平常會注意"
    } ]
  }, {
    "tStartMs": 2889600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "在7月半之前不出去"
    } ]
  }, {
    "tStartMs": 2891100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "但她這一年，就沒辦法，忘了啊"
    } ]
  }, {
    "tStartMs": 2895000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就所以才也算巧了嗎"
    } ]
  }, {
    "tStartMs": 2896800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "對對對"
    } ]
  }, {
    "tStartMs": 2897533,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2898166,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "然後我後面，我也是"
    } ]
  }, {
    "tStartMs": 2900900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "我覺得，確實有點虎頭蛇尾嘛"
    } ]
  }, {
    "tStartMs": 2902166,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "我就"
    } ]
  }, {
    "tStartMs": 2902900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "當然，我們祝福小月後面也是平平安安的"
    } ]
  }, {
    "tStartMs": 2905700,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2906133,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "虎頭蛇尾是好事"
    } ]
  }, {
    "tStartMs": 2907733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "然後我知道大家一定沒聽過癮"
    } ]
  }, {
    "tStartMs": 2909433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "所以我就查了一些"
    } ]
  }, {
    "tStartMs": 2910933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "這個墓碑上，這個符咒的相關的東西啊"
    } ]
  }, {
    "tStartMs": 2913800,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "一些資料"
    } ]
  }, {
    "tStartMs": 2914400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "我幫大家做一些，比較溫柔的解釋啊"
    } ]
  }, {
    "tStartMs": 2917633,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "不做這種很（生硬的）…小課堂"
    } ]
  }, {
    "tStartMs": 2920000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "哎，小課堂"
    } ]
  }, {
    "tStartMs": 2921000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "不做那種特別嚇人的"
    } ]
  }, {
    "tStartMs": 2922533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我們都上些什麼課吧哈哈哈"
    } ]
  }, {
    "tStartMs": 2925566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "首先呢說這個"
    } ]
  }, {
    "tStartMs": 2927300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "紅繩和黃符"
    } ]
  }, {
    "tStartMs": 2928766,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "都是民間傳統信仰中的東西"
    } ]
  }, {
    "tStartMs": 2931533,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "它（們）是被認為能夠辟邪驅鬼的"
    } ]
  }, {
    "tStartMs": 2934833,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 2935900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "它有的時候在一些傳統民俗裡面"
    } ]
  }, {
    "tStartMs": 2939033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "它是會被用於墓碑之上的"
    } ]
  }, {
    "tStartMs": 2940900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "大家可以不用特別的疑問"
    } ]
  }, {
    "tStartMs": 2943733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "不一定是怪事"
    } ]
  }, {
    "tStartMs": 2945100,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 2945800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "在我們傳統文化裡面，紅色是吉祥"
    } ]
  }, {
    "tStartMs": 2948233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "象徵好運和福氣"
    } ]
  }, {
    "tStartMs": 2949966,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 2950400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "而黃色則是驅邪避禍的意思"
    } ]
  }, {
    "tStartMs": 2953500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "所以當"
    } ]
  }, {
    "tStartMs": 2955166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "你把這個"
    } ]
  }, {
    "tStartMs": 2956533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "紅繩和黃符綁在這個墓碑上的時候"
    } ]
  }, {
    "tStartMs": 2959833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "它是"
    } ]
  }, {
    "tStartMs": 2961400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "設計是保護墓碑的主人的靈魂"
    } ]
  }, {
    "tStartMs": 2964133,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不受邪罪的侵害"
    } ]
  }, {
    "tStartMs": 2966100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "同時希望他們"
    } ]
  }, {
    "tStartMs": 2967200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "在來世中，獲得平安和好運"
    } ]
  }, {
    "tStartMs": 2969966,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "哦！對！所以其實綁這個東西是好事"
    } ]
  }, {
    "tStartMs": 2973533,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "一種祈福"
    } ]
  }, {
    "tStartMs": 2974400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "哎，那也有一些說法，就不一樣"
    } ]
  }, {
    "tStartMs": 2978400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "在一些地區呢"
    } ]
  }, {
    "tStartMs": 2979966,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "有的人，這個大家會相信啊"
    } ]
  }, {
    "tStartMs": 2982800,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "綁紅繩和黃符，同時綁在墓碑上"
    } ]
  }, {
    "tStartMs": 2985766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是防止這個"
    } ]
  }, {
    "tStartMs": 2988000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "故去的這個人的，魂體離開墳墓"
    } ]
  }, {
    "tStartMs": 2991166,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "因為如果說他太極端"
    } ]
  }, {
    "tStartMs": 2993633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "或者是生前有過一些"
    } ]
  }, {
    "tStartMs": 2995833,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "做過一些不好的事情"
    } ]
  }, {
    "tStartMs": 2997133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "他死後就會變成惡g"
    } ]
  }, {
    "tStartMs": 3000033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "所以透過這個方式呢"
    } ]
  }, {
    "tStartMs": 3001633,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "把他禁錮在墳墓裡。兩面性"
    } ]
  }, {
    "tStartMs": 3006033,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "理解不一樣"
    } ]
  }, {
    "tStartMs": 3007000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我感覺是"
    } ]
  }, {
    "tStartMs": 3008200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "每個地方差異性比較大"
    } ]
  }, {
    "tStartMs": 3011800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "其實我"
    } ]
  }, {
    "tStartMs": 3012733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我做到這，就突然想到"
    } ]
  }, {
    "tStartMs": 3014433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "你剛才那個故事"
    } ]
  }, {
    "tStartMs": 3015333,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "我應該，以後我都點想讓我們"
    } ]
  }, {
    "tStartMs": 3020166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "就是每次每期"
    } ]
  }, {
    "tStartMs": 3021200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我們其實稿子完全不互通的嗎"
    } ]
  }, {
    "tStartMs": 3022800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "互通互通"
    } ]
  }, {
    "tStartMs": 3023933,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "因為什麼呢"
    } ]
  }, {
    "tStartMs": 3024500,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "因為小葉碰到一個故事啊"
    } ]
  }, {
    "tStartMs": 3026566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "跟你這個特別像，就咱們"
    } ]
  }, {
    "tStartMs": 3028166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就剛才第二個故事嗎"
    } ]
  }, {
    "tStartMs": 3029966,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "就咱們團隊裡面的小葉"
    } ]
  }, {
    "tStartMs": 3032100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "她之前，公司團建啊"
    } ]
  }, {
    "tStartMs": 3034566,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "去了南京週邊的一個，我忘記是"
    } ]
  }, {
    "tStartMs": 3038366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "常州"
    } ]
  }, {
    "tStartMs": 3039733,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "還是哪邊的一個，很有名的一個度假村"
    } ]
  }, {
    "tStartMs": 3043233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "她碰到這事，類似"
    } ]
  }, {
    "tStartMs": 3045566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "但沒有那麼邪啊"
    } ]
  }, {
    "tStartMs": 3046800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "沒有那麼邪，但也挺可怕的"
    } ]
  }, {
    "tStartMs": 3050133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "她後來做措施了吧"
    } ]
  }, {
    "tStartMs": 3052533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "做動作了吧"
    } ]
  }, {
    "tStartMs": 3053433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "沒有沒有啊…你帶她回來做一下"
    } ]
  }, {
    "tStartMs": 3056233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "她回來了嗎？"
    } ]
  }, {
    "tStartMs": 3057600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "回來？"
    } ]
  }, {
    "tStartMs": 3058833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "萬一帶回來東西了呢"
    } ]
  }, {
    "tStartMs": 3060433,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "那，還好沒有"
    } ]
  }, {
    "tStartMs": 3061900,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "那還好是吧"
    } ]
  }, {
    "tStartMs": 3062633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "對，因為她（的故事）要排隊嘛"
    } ]
  }, {
    "tStartMs": 3064366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "所以他的故事應該理論上也要等到"
    } ]
  }, {
    "tStartMs": 3066533,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "七、八月"
    } ]
  }, {
    "tStartMs": 3067100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "才能講。所以正常排隊"
    } ]
  }, {
    "tStartMs": 3069533,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "是的，那我今天要給大家也做個預告啊"
    } ]
  }, {
    "tStartMs": 3073033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我們後面的鯰魚呢"
    } ]
  }, {
    "tStartMs": 3074900,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "會做一整期的城市合集"
    } ]
  }, {
    "tStartMs": 3079366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "就像我之前說過的嗯"
    } ]
  }, {
    "tStartMs": 3081000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我們這期節目應該"
    } ]
  }, {
    "tStartMs": 3082933,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是在"
    } ]
  }, {
    "tStartMs": 3084833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "6月的第三或第四"
    } ]
  }, {
    "tStartMs": 3086366,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "應該6月底吧"
    } ]
  }, {
    "tStartMs": 3087533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "6月底發這一期節目"
    } ]
  }, {
    "tStartMs": 3088900,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "大家聽到的時候應該是6月底"
    } ]
  }, {
    "tStartMs": 3090366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "那7月開始呢"
    } ]
  }, {
    "tStartMs": 3092200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我們就會從這個地域開始"
    } ]
  }, {
    "tStartMs": 3094833,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "做這個不同地域的靈異故事"
    } ]
  }, {
    "tStartMs": 3097733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但是大家有一個點我們做的不一樣"
    } ]
  }, {
    "tStartMs": 3100233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "因為網路上面有很多"
    } ]
  }, {
    "tStartMs": 3102766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "做這個地域靈異的，他們講的也很傳統"
    } ]
  }, {
    "tStartMs": 3105633,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我們就不講，因為這些都講過了"
    } ]
  }, {
    "tStartMs": 3107633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我們不講傳統的"
    } ]
  }, {
    "tStartMs": 3109100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我們還是按鯰魚的風格，我們就用投稿"
    } ]
  }, {
    "tStartMs": 3111900,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 3112500,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "那投稿的話呢"
    } ]
  }, {
    "tStartMs": 3113333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "可能它（稿件）的地域色彩沒有那麼的"
    } ]
  }, {
    "tStartMs": 3116600,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "怎麼樣…豐滿"
    } ]
  }, {
    "tStartMs": 3117733,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "沒有那麼的，風情（特色）"
    } ]
  }, {
    "tStartMs": 3120633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "對吧，沒有那麼像那個地方的"
    } ]
  }, {
    "tStartMs": 3122600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "但是呢，貴在一個真實"
    } ]
  }, {
    "tStartMs": 3124833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "對啊，所以給大家預告一下"
    } ]
  }, {
    "tStartMs": 3126966,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "我們第一期就是烏克蘭的靈異故事"
    } ]
  }, {
    "tStartMs": 3132366,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "之後呢"
    } ]
  }, {
    "tStartMs": 3133033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你讓我怎麼做"
    } ]
  }, {
    "tStartMs": 3134733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "你想辦法啊"
    } ]
  }, {
    "tStartMs": 3136100,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "哈哈哈？我去哪找烏克蘭的？怎麼搞"
    } ]
  }, {
    "tStartMs": 3138633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "是你"
    } ]
  }, {
    "tStartMs": 3139633,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你可以去烏克蘭嗎"
    } ]
  }, {
    "tStartMs": 3141100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "現在我不剛好嗎"
    } ]
  }, {
    "tStartMs": 3142133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "過分了啊"
    } ]
  }, {
    "tStartMs": 3143533,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "那第二期，是廣西的鬼故事"
    } ]
  }, {
    "tStartMs": 3146433,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "再往後一期呢是四川的鬼故事"
    } ]
  }, {
    "tStartMs": 3149766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "嗯啊然後再往後就是我們按順序吧"
    } ]
  }, {
    "tStartMs": 3152800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "一直到新疆西藏我們都準備好了"
    } ]
  }, {
    "tStartMs": 3154800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "嗯好也希望大家期待一下"
    } ]
  }, {
    "tStartMs": 3157133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "那我呢？那我烏克蘭怎麼辦"
    } ]
  }, {
    "tStartMs": 3159166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "哈哈哈你實在不行就算了"
    } ]
  }, {
    "tStartMs": 3160833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "哈哈哈！好好好"
    } ]
  }, {
    "tStartMs": 3162366,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "行，好。那今天的故事到這邊就結束了"
    } ]
  }, {
    "tStartMs": 3164800,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "如果你有些適合在夜裡說的奇事"
    } ]
  }, {
    "tStartMs": 3166633,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "和怪事以及邪事"
    } ]
  }, {
    "tStartMs": 3168933,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 3169600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "還有那個烏克蘭魚友記得聯絡我一下"
    } ]
  }, {
    "tStartMs": 3172433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "是說，我這邊缺篇烏克蘭的稿子！哈哈"
    } ]
  }, {
    "tStartMs": 3174966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "好的，好的"
    } ]
  }, {
    "tStartMs": 3175600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "好，那這邊就到這邊結束了"
    } ]
  }, {
    "tStartMs": 3177166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "如果說你有些適合在夜裡說的奇事、"
    } ]
  }, {
    "tStartMs": 3178966,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "怪事、邪事"
    } ]
  }, {
    "tStartMs": 3179566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "歡迎給我們投稿！"
    } ]
  }, {
    "tStartMs": 3180566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "拜拜！拜拜！"
    } ]
  } ]
}
