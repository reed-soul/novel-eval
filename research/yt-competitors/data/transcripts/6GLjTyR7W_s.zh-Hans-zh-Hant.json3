{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 300,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "七月半鬼门开"
    } ]
  }, {
    "tStartMs": 1733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "每年的7月15"
    } ]
  }, {
    "tStartMs": 3400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "地府的大门就会打开"
    } ]
  }, {
    "tStartMs": 5400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "阴曹地府的灵魂就会回到人间"
    } ]
  }, {
    "tStartMs": 8066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "在这一天"
    } ]
  }, {
    "tStartMs": 9100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "大家都会像约好了一样"
    } ]
  }, {
    "tStartMs": 11200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "尽量不出门"
    } ]
  }, {
    "tStartMs": 12366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然而这天"
    } ]
  }, {
    "tStartMs": 13366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "某大学的操场上"
    } ]
  }, {
    "tStartMs": 14966,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "却坐着四个人"
    } ]
  }, {
    "tStartMs": 16200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "他们围在一起聊天"
    } ]
  }, {
    "tStartMs": 18000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "其中一个叫铭的男生"
    } ]
  }, {
    "tStartMs": 19833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "开口问道"
    } ]
  }, {
    "tStartMs": 20733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "你们都不怕鬼吗"
    } ]
  }, {
    "tStartMs": 22233,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "但是没想到"
    } ]
  }, {
    "tStartMs": 23366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "他得到的答案都是一样的"
    } ]
  }, {
    "tStartMs": 25466,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "都是因为某些原因"
    } ]
  }, {
    "tStartMs": 27366,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "从小就能看到鬼"
    } ]
  }, {
    "tStartMs": 29066,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "接着铭又建议说"
    } ]
  }, {
    "tStartMs": 30500,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "既然我们都一样"
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "不如把各自能看见鬼的遭遇"
    } ]
  }, {
    "tStartMs": 34166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "说出来怎么样"
    } ]
  }, {
    "tStartMs": 35233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他的提议"
    } ]
  }, {
    "tStartMs": 36166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "很快得到了大家的同意"
    } ]
  }, {
    "tStartMs": 38200,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 38900,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "一个叫阿美的女生说"
    } ]
  }, {
    "tStartMs": 40600,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "那我先来讲吧"
    } ]
  }, {
    "tStartMs": 41833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "阿美说"
    } ]
  }, {
    "tStartMs": 42733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "自己十岁之前"
    } ]
  }, {
    "tStartMs": 44300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "还是个普通人"
    } ]
  }, {
    "tStartMs": 45666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "直到后来她在外婆家"
    } ]
  }, {
    "tStartMs": 47566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "犯了一个禁忌"
    } ]
  }, {
    "tStartMs": 48533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "当年"
    } ]
  }, {
    "tStartMs": 49400,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "她在外婆家发现"
    } ]
  }, {
    "tStartMs": 50900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "她们那的人"
    } ]
  }, {
    "tStartMs": 52066,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "家家户户都有一个大罐子"
    } ]
  }, {
    "tStartMs": 54200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不知道是装什么东西的"
    } ]
  }, {
    "tStartMs": 56166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "外婆嘱咐过她"
    } ]
  }, {
    "tStartMs": 57600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "一定不能碰这个罐子"
    } ]
  }, {
    "tStartMs": 59500,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "但是小孩的好奇心非常重"
    } ]
  }, {
    "tStartMs": 61966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "这天"
    } ]
  }, {
    "tStartMs": 62600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "阿美和几个朋友去隔壁妞妞家玩"
    } ]
  }, {
    "tStartMs": 65333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "看见她家也有个罐子"
    } ]
  }, {
    "tStartMs": 67233,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "就好奇的问道"
    } ]
  }, {
    "tStartMs": 68600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "罐子里装的什么"
    } ]
  }, {
    "tStartMs": 69900,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "妞妞神秘的说"
    } ]
  }, {
    "tStartMs": 71233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "这里面是我的祖宗"
    } ]
  }, {
    "tStartMs": 72900,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "因为当时年纪小"
    } ]
  }, {
    "tStartMs": 74433,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "根本不信什么鬼神之说"
    } ]
  }, {
    "tStartMs": 76500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "便觉得妞妞骗了自己"
    } ]
  }, {
    "tStartMs": 78600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "气呼呼的跟她争辩起来"
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "不服输的妞妞怂恿道"
    } ]
  }, {
    "tStartMs": 82566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那要不信"
    } ]
  }, {
    "tStartMs": 83533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "就把缸里的东西涂到眼皮上看看啊"
    } ]
  }, {
    "tStartMs": 86666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "虽然阿美心里也在发怵"
    } ]
  }, {
    "tStartMs": 88900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "但碍于小朋友的面子"
    } ]
  }, {
    "tStartMs": 90833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "直接将手伸进罐子里"
    } ]
  }, {
    "tStartMs": 92766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "抓出一点像是泥土的东西"
    } ]
  }, {
    "tStartMs": 95066,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "涂在了眼皮上"
    } ]
  }, {
    "tStartMs": 96200,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "接着"
    } ]
  }, {
    "tStartMs": 96933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "阿美得意的对妞妞说"
    } ]
  }, {
    "tStartMs": 98866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "你不是说里面是你祖宗吗"
    } ]
  }, {
    "tStartMs": 101033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "但缸里什么都没有"
    } ]
  }, {
    "tStartMs": 102700,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "你就是在骗人"
    } ]
  }, {
    "tStartMs": 103966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "经过这一闹剧"
    } ]
  }, {
    "tStartMs": 105266,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "大家也都各自回家了"
    } ]
  }, {
    "tStartMs": 107200,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "就当阿美独自一人回家时"
    } ]
  }, {
    "tStartMs": 109600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "却在村口发现一个上吊的女人"
    } ]
  }, {
    "tStartMs": 112266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "对着阿美阴森森的笑着"
    } ]
  }, {
    "tStartMs": 114466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "看到这"
    } ]
  }, {
    "tStartMs": 115300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "阿美吓得撒腿就跑"
    } ]
  }, {
    "tStartMs": 117166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "回家后"
    } ]
  }, {
    "tStartMs": 118033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "将这件事告诉了外婆"
    } ]
  }, {
    "tStartMs": 120166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "没想到外婆听完后"
    } ]
  }, {
    "tStartMs": 122000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "突然"
    } ]
  }, {
    "tStartMs": 122766,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "脸色煞白"
    } ]
  }, {
    "tStartMs": 123933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "还狠狠的打了她一巴掌"
    } ]
  }, {
    "tStartMs": 125933,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "直到后来"
    } ]
  }, {
    "tStartMs": 126900,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "阿美才知道"
    } ]
  }, {
    "tStartMs": 128033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "妞妞并没有骗她"
    } ]
  }, {
    "tStartMs": 129533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那个大罐子里装的"
    } ]
  }, {
    "tStartMs": 131133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "确实是她祖先"
    } ]
  }, {
    "tStartMs": 132633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这也是那个村里的习俗"
    } ]
  }, {
    "tStartMs": 134433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "说是土葬的人"
    } ]
  }, {
    "tStartMs": 135800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "在几十年后会变成尸泥"
    } ]
  }, {
    "tStartMs": 138033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "用罐子把他们装回家"
    } ]
  }, {
    "tStartMs": 140100,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就可以保佑全家顺风顺水"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "而她还有一个作用"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "那就是将尸泥涂在眼睛上"
    } ]
  }, {
    "tStartMs": 146266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "就可以让人拥有阴阳眼"
    } ]
  }, {
    "tStartMs": 148533,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "阿美平淡的生活"
    } ]
  }, {
    "tStartMs": 150033,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "也从那时就被打破了"
    } ]
  }, {
    "tStartMs": 152066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "小萌看着阿美说"
    } ]
  }, {
    "tStartMs": 153566,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "你的遭遇还真是离奇"
    } ]
  }, {
    "tStartMs": 155533,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "我见鬼的时间"
    } ]
  }, {
    "tStartMs": 156866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "要比你晚很多"
    } ]
  }, {
    "tStartMs": 158100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我是上了大学后才能看到的"
    } ]
  }, {
    "tStartMs": 160566,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "不知道你们有没有听过这样一个故事"
    } ]
  }, {
    "tStartMs": 163100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "有人说在午夜十二点"
    } ]
  }, {
    "tStartMs": 165200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "不停的盯着天花板看"
    } ]
  }, {
    "tStartMs": 167166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "窗户那边"
    } ]
  }, {
    "tStartMs": 168166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "就会听到咚咚咚的声音"
    } ]
  }, {
    "tStartMs": 170400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "听到这里大家纷纷摇头"
    } ]
  }, {
    "tStartMs": 172800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "表示没有听说过"
    } ]
  }, {
    "tStartMs": 174233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "小萌见状接着说道"
    } ]
  }, {
    "tStartMs": 176100,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "有天晚上"
    } ]
  }, {
    "tStartMs": 177200,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "宿舍就我一个人"
    } ]
  }, {
    "tStartMs": 178433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我躺在床上怎么也睡不着"
    } ]
  }, {
    "tStartMs": 180900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就突然想起了这个故事"
    } ]
  }, {
    "tStartMs": 182866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "眼看马上就要到十二点了"
    } ]
  }, {
    "tStartMs": 185200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "好奇心驱使着她"
    } ]
  }, {
    "tStartMs": 186833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "开始测试起这个故事"
    } ]
  }, {
    "tStartMs": 188566,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "午夜十二点很快就到了"
    } ]
  }, {
    "tStartMs": 190766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "小萌的眼睛紧紧盯着天花板"
    } ]
  }, {
    "tStartMs": 193233,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "一下眼睛都不敢眨"
    } ]
  }, {
    "tStartMs": 194966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "时间缓缓的走着"
    } ]
  }, {
    "tStartMs": 196633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "宿舍里静的连呼吸声都听得很清楚"
    } ]
  }, {
    "tStartMs": 199766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "小萌也越来越紧张"
    } ]
  }, {
    "tStartMs": 201666,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "就在她数了几秒"
    } ]
  }, {
    "tStartMs": 203233,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "想要放弃的时候"
    } ]
  }, {
    "tStartMs": 204733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "窗外突然传来一阵"
    } ]
  }, {
    "tStartMs": 206600,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "咚咚咚的声音"
    } ]
  }, {
    "tStartMs": 207733,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那声音在深夜里"
    } ]
  }, {
    "tStartMs": 209500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "显得格外突兀"
    } ]
  }, {
    "tStartMs": 210900,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "小萌吓得突然从床上坐起来"
    } ]
  }, {
    "tStartMs": 213466,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "真不是她胆小"
    } ]
  }, {
    "tStartMs": 214766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "而是他的宿舍在四楼"
    } ]
  }, {
    "tStartMs": 216666,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "怎么可能会有人在外面敲窗呢"
    } ]
  }, {
    "tStartMs": 219200,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "还是在半夜十二点"
    } ]
  }, {
    "tStartMs": 220900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "就在小萌吓得缩在床角发抖时"
    } ]
  }, {
    "tStartMs": 224033,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "宿舍的门突然被人推开了"
    } ]
  }, {
    "tStartMs": 226233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "借着走廊上的微光"
    } ]
  }, {
    "tStartMs": 227833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "她看清了来人"
    } ]
  }, {
    "tStartMs": 229166,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "正是她的室友苗苗"
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "只是她看上去很累的样子"
    } ]
  }, {
    "tStartMs": 233033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "浑身都湿漉漉的"
    } ]
  }, {
    "tStartMs": 234466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "她看着小萌说"
    } ]
  }, {
    "tStartMs": 235833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "不好意思"
    } ]
  }, {
    "tStartMs": 236833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "这么晚才回来"
    } ]
  }, {
    "tStartMs": 238066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "打扰你休息了吧"
    } ]
  }, {
    "tStartMs": 239466,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "听到这里我笑着说道"
    } ]
  }, {
    "tStartMs": 241433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "没关系"
    } ]
  }, {
    "tStartMs": 242366,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "反正我也没睡着"
    } ]
  }, {
    "tStartMs": 243800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 244600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "小萌的手机突然响了"
    } ]
  }, {
    "tStartMs": 246633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "是另一位室友晶晶打来的"
    } ]
  }, {
    "tStartMs": 248800,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "小萌刚接过电话"
    } ]
  }, {
    "tStartMs": 250400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就听到对方幽幽的说"
    } ]
  }, {
    "tStartMs": 252200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "小萌"
    } ]
  }, {
    "tStartMs": 253033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "你在宿舍小心一点"
    } ]
  }, {
    "tStartMs": 255000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "苗苗晚上掉进河里淹死了"
    } ]
  }, {
    "tStartMs": 257366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "小心她回宿舍去找你"
    } ]
  }, {
    "tStartMs": 259733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "听了室友的话"
    } ]
  }, {
    "tStartMs": 260966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "小萌整个人都楞住了"
    } ]
  }, {
    "tStartMs": 262966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "浑身的鸡皮疙瘩都炸了起来"
    } ]
  }, {
    "tStartMs": 265300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "瞬间"
    } ]
  }, {
    "tStartMs": 266166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "恐惧不安的情绪将她包裹起来"
    } ]
  }, {
    "tStartMs": 268866,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "她不由自主的朝苗苗的床铺看去"
    } ]
  }, {
    "tStartMs": 271900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "只见她的床边"
    } ]
  }, {
    "tStartMs": 273233,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "不停的向下滴着水"
    } ]
  }, {
    "tStartMs": 275033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "身上也是湿漉漉的"
    } ]
  }, {
    "tStartMs": 276633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "脸色也不太对劲"
    } ]
  }, {
    "tStartMs": 278233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "看到这里"
    } ]
  }, {
    "tStartMs": 279166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "小萌的心都快提到嗓子眼了"
    } ]
  }, {
    "tStartMs": 281733,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "但这时她又想到了"
    } ]
  }, {
    "tStartMs": 283633,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "另一个诡异的问题"
    } ]
  }, {
    "tStartMs": 285100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那就是"
    } ]
  }, {
    "tStartMs": 285900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他的手机"
    } ]
  }, {
    "tStartMs": 286900,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "晚上一直是关机的状态"
    } ]
  }, {
    "tStartMs": 289266,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "晶晶是怎么打进来的"
    } ]
  }, {
    "tStartMs": 290833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就在我拿着手机疑惑时"
    } ]
  }, {
    "tStartMs": 292666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "苗苗突然转过身来"
    } ]
  }, {
    "tStartMs": 294433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "直勾勾的盯着小萌说"
    } ]
  }, {
    "tStartMs": 296266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "小萌"
    } ]
  }, {
    "tStartMs": 297066,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "有件事"
    } ]
  }, {
    "tStartMs": 297900,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "我没有告诉你"
    } ]
  }, {
    "tStartMs": 298966,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "闻言"
    } ]
  }, {
    "tStartMs": 299933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "小萌颤抖的问道"
    } ]
  }, {
    "tStartMs": 301433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "什么事"
    } ]
  }, {
    "tStartMs": 302233,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "苗苗说"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "我今天这么晚回来"
    } ]
  }, {
    "tStartMs": 304666,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "是因为在路上"
    } ]
  }, {
    "tStartMs": 306033,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "看到了一起车祸"
    } ]
  }, {
    "tStartMs": 307433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "车祸现场还死了人"
    } ]
  }, {
    "tStartMs": 309300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那人你也认识"
    } ]
  }, {
    "tStartMs": 310700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "就是我们的室友晶晶"
    } ]
  }, {
    "tStartMs": 312166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "苗苗用平淡的语气"
    } ]
  }, {
    "tStartMs": 314133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "叙述了车祸现场的情况"
    } ]
  }, {
    "tStartMs": 316366,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "但这些话"
    } ]
  }, {
    "tStartMs": 317500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "传到小萌耳朵里后"
    } ]
  }, {
    "tStartMs": 319266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "却在她的心里激起了千层浪"
    } ]
  }, {
    "tStartMs": 321566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一时间"
    } ]
  }, {
    "tStartMs": 322433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "不知道该相信谁"
    } ]
  }, {
    "tStartMs": 323900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "因为"
    } ]
  }, {
    "tStartMs": 324700,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "她们俩的表现都不对劲"
    } ]
  }, {
    "tStartMs": 326700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "晶晶打电话说苗苗死了"
    } ]
  }, {
    "tStartMs": 328966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "苗苗却说是晶晶死了"
    } ]
  }, {
    "tStartMs": 330833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就这样"
    } ]
  }, {
    "tStartMs": 331766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "小萌一整晚都在惊恐中度过"
    } ]
  }, {
    "tStartMs": 334366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "到现在"
    } ]
  }, {
    "tStartMs": 335233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "她都无法忘记这件事"
    } ]
  }, {
    "tStartMs": 337166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "说到这"
    } ]
  }, {
    "tStartMs": 338066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "小萌不禁打了个寒颤"
    } ]
  }, {
    "tStartMs": 339866,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "之后又接着说道"
    } ]
  }, {
    "tStartMs": 341366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "从那之后"
    } ]
  }, {
    "tStartMs": 342266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "我就经常在宿舍里看到她们"
    } ]
  }, {
    "tStartMs": 344766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "每次出现的时间"
    } ]
  }, {
    "tStartMs": 346333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "都是在午夜十二点之后"
    } ]
  }, {
    "tStartMs": 348533,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "后来才知道"
    } ]
  }, {
    "tStartMs": 349600,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "其实"
    } ]
  }, {
    "tStartMs": 350300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "她们两个人都是鬼"
    } ]
  }, {
    "tStartMs": 352100,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "小萌的遭遇"
    } ]
  }, {
    "tStartMs": 353233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "在这个特殊的日子里"
    } ]
  }, {
    "tStartMs": 354833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "无疑是更加恐怖"
    } ]
  }, {
    "tStartMs": 356500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "众人听了都忍不住浑身一颤"
    } ]
  }, {
    "tStartMs": 358733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 359566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "铭又出言问道"
    } ]
  }, {
    "tStartMs": 360766,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "大鹏"
    } ]
  }, {
    "tStartMs": 361633,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "你的故事是什么"
    } ]
  }, {
    "tStartMs": 363066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "听到铭点到自己"
    } ]
  }, {
    "tStartMs": 364666,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "大鹏叹了口气"
    } ]
  }, {
    "tStartMs": 365566,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "说"
    } ]
  }, {
    "tStartMs": 366766,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "你们确定要听我的故事吗"
    } ]
  }, {
    "tStartMs": 368766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "我的遭遇可比她们恐怖多了"
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "闻言"
    } ]
  }, {
    "tStartMs": 371866,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "大家都说"
    } ]
  }, {
    "tStartMs": 372933,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "有什么好怕的"
    } ]
  }, {
    "tStartMs": 374133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "她们自己都见过鬼"
    } ]
  }, {
    "tStartMs": 376066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "还会怕鬼故事吗"
    } ]
  }, {
    "tStartMs": 377500,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "在大家的催促下"
    } ]
  }, {
    "tStartMs": 379066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "大鹏终于开始讲了"
    } ]
  }, {
    "tStartMs": 380833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你们也知道我很胖"
    } ]
  }, {
    "tStartMs": 382600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "根本就没有人会喜欢上我这样的人"
    } ]
  }, {
    "tStartMs": 385300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我一直希望能有个女朋友"
    } ]
  }, {
    "tStartMs": 387500,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 388600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我的一位室友告诉我"
    } ]
  }, {
    "tStartMs": 390233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "只要在凌晨三点的时候"
    } ]
  }, {
    "tStartMs": 392233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "将两面相同的镜子靠在一起"
    } ]
  }, {
    "tStartMs": 394900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "镜子里就会出现很多你没有见过的脸"
    } ]
  }, {
    "tStartMs": 397900,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "而其中的第十三张脸"
    } ]
  }, {
    "tStartMs": 400100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就是你未来女朋友的样子"
    } ]
  }, {
    "tStartMs": 402000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "听到这"
    } ]
  }, {
    "tStartMs": 402900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "大鹏又怎么能忍得住呢"
    } ]
  }, {
    "tStartMs": 404933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "他可是一直都渴望能拥有一位女朋友"
    } ]
  }, {
    "tStartMs": 408000,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "于是"
    } ]
  }, {
    "tStartMs": 408633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "他便在室友都睡着的时候"
    } ]
  }, {
    "tStartMs": 410900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "偷偷爬起来拿着两面镜子"
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "跑到阳台上"
    } ]
  }, {
    "tStartMs": 414300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "借着月光"
    } ]
  }, {
    "tStartMs": 415333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "将镜子靠在了一起"
    } ]
  }, {
    "tStartMs": 417033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一开始"
    } ]
  }, {
    "tStartMs": 417933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "镜子根本就没有任何反应"
    } ]
  }, {
    "tStartMs": 420233,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "直到大鹏不断的调试后"
    } ]
  }, {
    "tStartMs": 422233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "镜子突然出现了镜像的情况"
    } ]
  }, {
    "tStartMs": 424800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "之后就像室友说的那样"
    } ]
  }, {
    "tStartMs": 426766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "出现了很多张脸"
    } ]
  }, {
    "tStartMs": 428233,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "但是"
    } ]
  }, {
    "tStartMs": 428933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "都只照出了大鹏自己的样子"
    } ]
  }, {
    "tStartMs": 431400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "他按照室友的说法"
    } ]
  }, {
    "tStartMs": 433033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "一张一张的数着"
    } ]
  }, {
    "tStartMs": 434533,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就在他刚要数十三时"
    } ]
  }, {
    "tStartMs": 436466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "镜子里突然出现了恐怖的笑声"
    } ]
  }, {
    "tStartMs": 439200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "让本就紧张的大鹏"
    } ]
  }, {
    "tStartMs": 441066,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "受到了不小的惊吓"
    } ]
  }, {
    "tStartMs": 442666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "以至于不小心碰到了镜子"
    } ]
  }, {
    "tStartMs": 444933,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "然而"
    } ]
  }, {
    "tStartMs": 445666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "就在大鹏触碰到镜子时"
    } ]
  }, {
    "tStartMs": 448000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "那镜子直接就炸开了"
    } ]
  }, {
    "tStartMs": 449866,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "突然"
    } ]
  }, {
    "tStartMs": 450633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "大鹏的身后"
    } ]
  }, {
    "tStartMs": 451866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "传来一阵嘲笑声"
    } ]
  }, {
    "tStartMs": 453500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "大鹏一回头"
    } ]
  }, {
    "tStartMs": 454833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就看见了那位怂恿自己这样做的室友"
    } ]
  }, {
    "tStartMs": 457833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "室友见自己按照他的说法做了"
    } ]
  }, {
    "tStartMs": 460533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "便嘲笑道"
    } ]
  }, {
    "tStartMs": 461633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那故事是我骗你的"
    } ]
  }, {
    "tStartMs": 463266,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "你还真信了"
    } ]
  }, {
    "tStartMs": 464466,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "不管你怎么数"
    } ]
  }, {
    "tStartMs": 465733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "看到的都只是你自己"
    } ]
  }, {
    "tStartMs": 467700,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "怎么可能会看到你未来女朋友的样子"
    } ]
  }, {
    "tStartMs": 470433,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这世上根本就没有鬼神之说"
    } ]
  }, {
    "tStartMs": 472800,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "就你这样的"
    } ]
  }, {
    "tStartMs": 473833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "还想有女朋友"
    } ]
  }, {
    "tStartMs": 475300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "简直是在做梦"
    } ]
  }, {
    "tStartMs": 476600,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "听他这样说"
    } ]
  }, {
    "tStartMs": 477733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "大鹏才知道自己被骗了"
    } ]
  }, {
    "tStartMs": 479833,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "但是"
    } ]
  }, {
    "tStartMs": 480600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "他有件事没有告诉室友"
    } ]
  }, {
    "tStartMs": 482733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "刚刚镜子里的第十三张脸"
    } ]
  }, {
    "tStartMs": 484933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "根本不是自己的"
    } ]
  }, {
    "tStartMs": 486333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "而是那室友的"
    } ]
  }, {
    "tStartMs": 487400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "只不过"
    } ]
  }, {
    "tStartMs": 488266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "那是一张满是鲜血的脸"
    } ]
  }, {
    "tStartMs": 490300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "之后"
    } ]
  }, {
    "tStartMs": 491100,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "又过了很长时间"
    } ]
  }, {
    "tStartMs": 492633,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "大鹏也将这件事淡忘了"
    } ]
  }, {
    "tStartMs": 494800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 495900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "大鹏突然收到了警察带来的消息"
    } ]
  }, {
    "tStartMs": 498900,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "那位耍自己的室友"
    } ]
  }, {
    "tStartMs": 500700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "在校外酒吧里闹事"
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "被几个小混混失手打死了"
    } ]
  }, {
    "tStartMs": 504900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "作为他的室友"
    } ]
  }, {
    "tStartMs": 506166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "大鹏必须要跟警察去派出所做笔录"
    } ]
  }, {
    "tStartMs": 509266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然而"
    } ]
  }, {
    "tStartMs": 510066,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "它却在派出所里"
    } ]
  }, {
    "tStartMs": 511566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "意外看到了室友的死状"
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那一刻"
    } ]
  }, {
    "tStartMs": 514500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "大鹏整个人都呆住了"
    } ]
  }, {
    "tStartMs": 516466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "他怎么也不敢相信"
    } ]
  }, {
    "tStartMs": 517966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "室友的死状"
    } ]
  }, {
    "tStartMs": 519100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "竟然和自己之前在镜子里看到的一样"
    } ]
  }, {
    "tStartMs": 522200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "从那之后"
    } ]
  }, {
    "tStartMs": 523200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "大鹏就惊讶的发现"
    } ]
  }, {
    "tStartMs": 525066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "自己平时总会看到一些别人看不见的东西"
    } ]
  }, {
    "tStartMs": 528666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "随着大鹏的故事结束"
    } ]
  }, {
    "tStartMs": 530433,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "就只剩下铭的故事还没有讲了"
    } ]
  }, {
    "tStartMs": 532766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "接着"
    } ]
  }, {
    "tStartMs": 533566,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "大家都朝铭看去"
    } ]
  }, {
    "tStartMs": 535066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "示意他"
    } ]
  }, {
    "tStartMs": 535900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "可以开始讲了"
    } ]
  }, {
    "tStartMs": 537033,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "只见"
    } ]
  }, {
    "tStartMs": 537833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "铭笑了笑说"
    } ]
  }, {
    "tStartMs": 539066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "跟你们比"
    } ]
  }, {
    "tStartMs": 540033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我实在是没什么说的"
    } ]
  }, {
    "tStartMs": 541766,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "因为"
    } ]
  }, {
    "tStartMs": 542466,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我是从小就能看见"
    } ]
  }, {
    "tStartMs": 544200,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "这些别人看不到的东西"
    } ]
  }, {
    "tStartMs": 546300,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 546966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "阿美说道"
    } ]
  }, {
    "tStartMs": 547900,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "你可以讲一讲"
    } ]
  }, {
    "tStartMs": 549133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "你觉得可怕的事情"
    } ]
  }, {
    "tStartMs": 550900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "铭看着她们一副好奇的样子"
    } ]
  }, {
    "tStartMs": 553466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "笑着说道"
    } ]
  }, {
    "tStartMs": 554433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "那我就给你们讲个我见鬼的经历吧"
    } ]
  }, {
    "tStartMs": 557166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我小时候身体不是很好"
    } ]
  }, {
    "tStartMs": 559466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "父母从不让我和小朋友一起玩"
    } ]
  }, {
    "tStartMs": 562133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这对于一个小孩来说"
    } ]
  }, {
    "tStartMs": 563766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "是多么可悲的事情啊"
    } ]
  }, {
    "tStartMs": 565366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "不过好在家里"
    } ]
  }, {
    "tStartMs": 566766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "还有一个姐姐可以陪自己玩"
    } ]
  }, {
    "tStartMs": 569100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这让铭开心不少"
    } ]
  }, {
    "tStartMs": 570700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "每次姐姐来找他玩"
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "都会坐在衣柜里"
    } ]
  }, {
    "tStartMs": 573933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "身上披着好几件衣服"
    } ]
  }, {
    "tStartMs": 575900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "形象看起来怪怪的"
    } ]
  }, {
    "tStartMs": 577900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "姐姐的身体状况和铭差不多"
    } ]
  }, {
    "tStartMs": 580366,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "都不怎么好"
    } ]
  }, {
    "tStartMs": 581300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "因此"
    } ]
  }, {
    "tStartMs": 582133,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "她们每次见面"
    } ]
  }, {
    "tStartMs": 583466,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "都只能坐着聊天或下棋"
    } ]
  }, {
    "tStartMs": 585833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就这样"
    } ]
  }, {
    "tStartMs": 586700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "一直持续了很久"
    } ]
  }, {
    "tStartMs": 588133,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 589266,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "铭的父母都不在家"
    } ]
  }, {
    "tStartMs": 591000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "他开心的跑到衣橱旁"
    } ]
  }, {
    "tStartMs": 593133,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "将衣橱打开"
    } ]
  }, {
    "tStartMs": 594600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "兴奋的对姐姐说道"
    } ]
  }, {
    "tStartMs": 596133,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "姐姐"
    } ]
  }, {
    "tStartMs": 597000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "今天我父母都不在家"
    } ]
  }, {
    "tStartMs": 598900,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我们一起出去玩吧"
    } ]
  }, {
    "tStartMs": 600400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "本以为"
    } ]
  }, {
    "tStartMs": 601600,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "姐姐会很开心的答应自己的要求"
    } ]
  }, {
    "tStartMs": 604300,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "但是没想到"
    } ]
  }, {
    "tStartMs": 605500,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "姐姐想也没想"
    } ]
  }, {
    "tStartMs": 606833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "直接就拒绝了自己"
    } ]
  }, {
    "tStartMs": 608333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "铭很伤心"
    } ]
  }, {
    "tStartMs": 609400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他不明白"
    } ]
  }, {
    "tStartMs": 610400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "姐姐为什么不愿意跟自己出去玩"
    } ]
  }, {
    "tStartMs": 613100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "但他想着"
    } ]
  }, {
    "tStartMs": 614200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "父母好不容易都不在家"
    } ]
  }, {
    "tStartMs": 616300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "今天不出去玩"
    } ]
  }, {
    "tStartMs": 617500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "以后"
    } ]
  }, {
    "tStartMs": 618333,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "可能就出不去了"
    } ]
  }, {
    "tStartMs": 619566,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "因为"
    } ]
  }, {
    "tStartMs": 620433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不想错过这大好时机"
    } ]
  }, {
    "tStartMs": 622466,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "便不顾姐姐的拒绝"
    } ]
  }, {
    "tStartMs": 624133,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "想要伸手拉她出去"
    } ]
  }, {
    "tStartMs": 625966,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "但是没想到"
    } ]
  }, {
    "tStartMs": 627133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "姐姐一看他伸手"
    } ]
  }, {
    "tStartMs": 628733,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "直接就躲进了柜子里"
    } ]
  }, {
    "tStartMs": 630333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "关上了柜门"
    } ]
  }, {
    "tStartMs": 631400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "铭见状"
    } ]
  }, {
    "tStartMs": 632333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "赶紧将柜门打开"
    } ]
  }, {
    "tStartMs": 634033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "但不管他怎么找"
    } ]
  }, {
    "tStartMs": 635500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "都找不到姐姐的身影"
    } ]
  }, {
    "tStartMs": 637366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "他大哭的跑到楼下"
    } ]
  }, {
    "tStartMs": 639300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "但却看到"
    } ]
  }, {
    "tStartMs": 640400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "母亲身边围着一群白衣服的人"
    } ]
  }, {
    "tStartMs": 643233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "吓得他直接躲了起来"
    } ]
  }, {
    "tStartMs": 645333,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "直到大家都离开了"
    } ]
  }, {
    "tStartMs": 646933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "他才跑出来"
    } ]
  }, {
    "tStartMs": 648100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "一脸委屈的告诉母亲"
    } ]
  }, {
    "tStartMs": 650100,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "姐姐不见了"
    } ]
  }, {
    "tStartMs": 651133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一听这话"
    } ]
  }, {
    "tStartMs": 652133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "母亲直接就楞住了"
    } ]
  }, {
    "tStartMs": 653800,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "尖叫着说道"
    } ]
  }, {
    "tStartMs": 654933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你姐姐在你出生之前"
    } ]
  }, {
    "tStartMs": 657000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就已经被坏人闷死在衣橱里了"
    } ]
  }, {
    "tStartMs": 659533,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 660266,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "我才意思到"
    } ]
  }, {
    "tStartMs": 661266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "自己是看见鬼了"
    } ]
  }, {
    "tStartMs": 662766,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "从那之后"
    } ]
  }, {
    "tStartMs": 663733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "那位姐姐就再也没出现过了"
    } ]
  }, {
    "tStartMs": 666033,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "之后"
    } ]
  }, {
    "tStartMs": 666833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "铭又偷偷从家里溜出来一次"
    } ]
  }, {
    "tStartMs": 669133,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "见门口有个扫地的阿姨"
    } ]
  }, {
    "tStartMs": 671733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "便亲切的叫着她"
    } ]
  }, {
    "tStartMs": 673266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但是铭一直叫了很长时间"
    } ]
  }, {
    "tStartMs": 675633,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "她才转过头来"
    } ]
  }, {
    "tStartMs": 677000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "指着自己家的方向"
    } ]
  }, {
    "tStartMs": 678333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "说道"
    } ]
  }, {
    "tStartMs": 679166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "那家的女人真可怜"
    } ]
  }, {
    "tStartMs": 680966,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "女儿被人活活闷死在衣柜里"
    } ]
  }, {
    "tStartMs": 683433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "小儿子也在出生后不久"
    } ]
  }, {
    "tStartMs": 685733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就去世了"
    } ]
  }, {
    "tStartMs": 686666,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "之后就彻底疯了"
    } ]
  }, {
    "tStartMs": 688066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "以至于"
    } ]
  }, {
    "tStartMs": 688900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她到现在都觉得自己的儿子还活着"
    } ]
  }, {
    "tStartMs": 691833,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "铭听完这些话"
    } ]
  }, {
    "tStartMs": 693133,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "也楞住了"
    } ]
  }, {
    "tStartMs": 694200,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "母亲什么时候又生了个男孩"
    } ]
  }, {
    "tStartMs": 696400,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 697133,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "铭突然回头"
    } ]
  }, {
    "tStartMs": 698266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "发现"
    } ]
  }, {
    "tStartMs": 699133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "自己身后还站着一个人"
    } ]
  }, {
    "tStartMs": 701000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "原来"
    } ]
  }, {
    "tStartMs": 701766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "那阿姨不是在跟自己说话"
    } ]
  }, {
    "tStartMs": 704000,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 704733,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "他突然顿住了"
    } ]
  }, {
    "tStartMs": 705933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "难道说"
    } ]
  }, {
    "tStartMs": 706833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "她们都看不到自己吗"
    } ]
  }, {
    "tStartMs": 708766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "故事讲完后"
    } ]
  }, {
    "tStartMs": 709933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "小萌忍不住提出了疑问"
    } ]
  }, {
    "tStartMs": 711866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "你这个故事"
    } ]
  }, {
    "tStartMs": 712966,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "为什么我有点听不懂"
    } ]
  }, {
    "tStartMs": 714733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这时"
    } ]
  }, {
    "tStartMs": 715566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "铭的脸上"
    } ]
  }, {
    "tStartMs": 716566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "突然露出一副诡异的笑容"
    } ]
  }, {
    "tStartMs": 718933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "他看着大家说道"
    } ]
  }, {
    "tStartMs": 720400,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "我的故事是说"
    } ]
  }, {
    "tStartMs": 721533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我从小就能看见鬼的原因是"
    } ]
  }, {
    "tStartMs": 723800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "因为我在小的时候"
    } ]
  }, {
    "tStartMs": 725300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "就已经死了"
    } ]
  } ]
}
