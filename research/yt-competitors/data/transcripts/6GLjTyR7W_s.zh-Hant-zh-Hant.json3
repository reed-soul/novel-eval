{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 300,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "七月半鬼門開"
    } ]
  }, {
    "tStartMs": 1733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "每年的7月15"
    } ]
  }, {
    "tStartMs": 3400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "地府的大門就會打開"
    } ]
  }, {
    "tStartMs": 5400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "陰曹地府的靈魂就會回到人間"
    } ]
  }, {
    "tStartMs": 8066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "在這一天"
    } ]
  }, {
    "tStartMs": 9100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "大家都會像約好了一樣"
    } ]
  }, {
    "tStartMs": 11200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "盡量不出門"
    } ]
  }, {
    "tStartMs": 12366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然而這天"
    } ]
  }, {
    "tStartMs": 13366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "某大學的操場上"
    } ]
  }, {
    "tStartMs": 14966,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "卻坐著四個人"
    } ]
  }, {
    "tStartMs": 16200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "他們圍在一起聊天"
    } ]
  }, {
    "tStartMs": 18000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "其中一個叫銘的男生"
    } ]
  }, {
    "tStartMs": 19833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "開口問道"
    } ]
  }, {
    "tStartMs": 20733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "你們都不怕鬼嗎"
    } ]
  }, {
    "tStartMs": 22233,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "但是沒想到"
    } ]
  }, {
    "tStartMs": 23366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "他得到的答案都是一樣的"
    } ]
  }, {
    "tStartMs": 25466,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "都是因為某些原因"
    } ]
  }, {
    "tStartMs": 27366,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "從小就能看到鬼"
    } ]
  }, {
    "tStartMs": 29066,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "接著銘又建議說"
    } ]
  }, {
    "tStartMs": 30500,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "既然我們都一樣"
    } ]
  }, {
    "tStartMs": 31800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "不如把各自能看見鬼的遭遇"
    } ]
  }, {
    "tStartMs": 34166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "說出來怎麼樣"
    } ]
  }, {
    "tStartMs": 35233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他的提議"
    } ]
  }, {
    "tStartMs": 36166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "很快得到了大家的同意"
    } ]
  }, {
    "tStartMs": 38200,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 38900,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "一個叫阿美的女生說"
    } ]
  }, {
    "tStartMs": 40600,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "那我先來講吧"
    } ]
  }, {
    "tStartMs": 41833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "阿美說"
    } ]
  }, {
    "tStartMs": 42733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "自己十歲之前"
    } ]
  }, {
    "tStartMs": 44300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "還是個普通人"
    } ]
  }, {
    "tStartMs": 45666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "直到後來她在外婆家"
    } ]
  }, {
    "tStartMs": 47566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "犯了一個禁忌"
    } ]
  }, {
    "tStartMs": 48533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "當年"
    } ]
  }, {
    "tStartMs": 49400,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "她在外婆家發現"
    } ]
  }, {
    "tStartMs": 50900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "她們那的人"
    } ]
  }, {
    "tStartMs": 52066,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "家家戶戶都有一個大罐子"
    } ]
  }, {
    "tStartMs": 54200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不知道是裝什麼東西的"
    } ]
  }, {
    "tStartMs": 56166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "外婆囑咐過她"
    } ]
  }, {
    "tStartMs": 57600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "一定不能碰這個罐子"
    } ]
  }, {
    "tStartMs": 59500,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "但是小孩的好奇心非常重"
    } ]
  }, {
    "tStartMs": 61966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "這天"
    } ]
  }, {
    "tStartMs": 62600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "阿美和幾個朋友去隔壁妞妞家玩"
    } ]
  }, {
    "tStartMs": 65333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "看見她家也有個罐子"
    } ]
  }, {
    "tStartMs": 67233,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "就好奇的問道"
    } ]
  }, {
    "tStartMs": 68600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "罐子裏裝的什麼"
    } ]
  }, {
    "tStartMs": 69900,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "妞妞神秘的說"
    } ]
  }, {
    "tStartMs": 71233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "這裏面是我的祖宗"
    } ]
  }, {
    "tStartMs": 72900,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "因為當時年紀小"
    } ]
  }, {
    "tStartMs": 74433,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "根本不信什麼鬼神之說"
    } ]
  }, {
    "tStartMs": 76500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "便覺得妞妞騙了自己"
    } ]
  }, {
    "tStartMs": 78600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "氣呼呼的跟她爭辯起來"
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "不服輸的妞妞慫恿道"
    } ]
  }, {
    "tStartMs": 82566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那要不信"
    } ]
  }, {
    "tStartMs": 83533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "就把缸裏的東西塗到眼皮上看看啊"
    } ]
  }, {
    "tStartMs": 86666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "雖然阿美心裏也在發怵"
    } ]
  }, {
    "tStartMs": 88900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "但礙於小朋友的面子"
    } ]
  }, {
    "tStartMs": 90833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "直接將手伸進罐子裏"
    } ]
  }, {
    "tStartMs": 92766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "抓出一點像是泥土的東西"
    } ]
  }, {
    "tStartMs": 95066,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "塗在了眼皮上"
    } ]
  }, {
    "tStartMs": 96200,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "接著"
    } ]
  }, {
    "tStartMs": 96933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "阿美得意的對妞妞說"
    } ]
  }, {
    "tStartMs": 98866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "你不是說裏面是你祖宗嗎"
    } ]
  }, {
    "tStartMs": 101033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "但缸裏什麼都沒有"
    } ]
  }, {
    "tStartMs": 102700,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "你就是在騙人"
    } ]
  }, {
    "tStartMs": 103966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "經過這一鬧劇"
    } ]
  }, {
    "tStartMs": 105266,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "大家也都各自回家了"
    } ]
  }, {
    "tStartMs": 107200,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "就當阿美獨自一人回家時"
    } ]
  }, {
    "tStartMs": 109600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "卻在村口發現一個上吊的女人"
    } ]
  }, {
    "tStartMs": 112266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "對著阿美陰森森的笑著"
    } ]
  }, {
    "tStartMs": 114466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "看到這"
    } ]
  }, {
    "tStartMs": 115300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "阿美嚇得撒腿就跑"
    } ]
  }, {
    "tStartMs": 117166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "回家後"
    } ]
  }, {
    "tStartMs": 118033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "將這件事告訴了外婆"
    } ]
  }, {
    "tStartMs": 120166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "沒想到外婆聽完後"
    } ]
  }, {
    "tStartMs": 122000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "突然"
    } ]
  }, {
    "tStartMs": 122766,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "臉色煞白"
    } ]
  }, {
    "tStartMs": 123933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "還狠狠的打了她一巴掌"
    } ]
  }, {
    "tStartMs": 125933,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "直到後來"
    } ]
  }, {
    "tStartMs": 126900,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "阿美才知道"
    } ]
  }, {
    "tStartMs": 128033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "妞妞並沒有騙她"
    } ]
  }, {
    "tStartMs": 129533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那個大罐子裏裝的"
    } ]
  }, {
    "tStartMs": 131133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "確實是她祖先"
    } ]
  }, {
    "tStartMs": 132633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "這也是那個村裏的習俗"
    } ]
  }, {
    "tStartMs": 134433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "說是土葬的人"
    } ]
  }, {
    "tStartMs": 135800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "在幾十年後會變成屍泥"
    } ]
  }, {
    "tStartMs": 138033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "用罐子把他們裝回家"
    } ]
  }, {
    "tStartMs": 140100,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "就可以保佑全家順風順水"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "而她還有一個作用"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "那就是將屍泥塗在眼睛上"
    } ]
  }, {
    "tStartMs": 146266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "就可以讓人擁有陰陽眼"
    } ]
  }, {
    "tStartMs": 148533,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "阿美平淡的生活"
    } ]
  }, {
    "tStartMs": 150033,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "也從那時就被打破了"
    } ]
  }, {
    "tStartMs": 152066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "小萌看著阿美說"
    } ]
  }, {
    "tStartMs": 153566,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "你的遭遇還真是離奇"
    } ]
  }, {
    "tStartMs": 155533,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "我見鬼的時間"
    } ]
  }, {
    "tStartMs": 156866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "要比你晚很多"
    } ]
  }, {
    "tStartMs": 158100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我是上了大學後才能看到的"
    } ]
  }, {
    "tStartMs": 160566,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "不知道你們有沒有聽過這樣一個故事"
    } ]
  }, {
    "tStartMs": 163100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "有人說在午夜十二點"
    } ]
  }, {
    "tStartMs": 165200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "不停的盯著天花板看"
    } ]
  }, {
    "tStartMs": 167166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "窗戶那邊"
    } ]
  }, {
    "tStartMs": 168166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "就會聽到咚咚咚的聲音"
    } ]
  }, {
    "tStartMs": 170400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "聽到這裏大家紛紛搖頭"
    } ]
  }, {
    "tStartMs": 172800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "表示沒有聽說過"
    } ]
  }, {
    "tStartMs": 174233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "小萌見狀接著說道"
    } ]
  }, {
    "tStartMs": 176100,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "有天晚上"
    } ]
  }, {
    "tStartMs": 177200,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "宿舍就我一個人"
    } ]
  }, {
    "tStartMs": 178433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我躺在床上怎麼也睡不著"
    } ]
  }, {
    "tStartMs": 180900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就突然想起了這個故事"
    } ]
  }, {
    "tStartMs": 182866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "眼看馬上就要到十二點了"
    } ]
  }, {
    "tStartMs": 185200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "好奇心驅使著她"
    } ]
  }, {
    "tStartMs": 186833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "開始測試起這個故事"
    } ]
  }, {
    "tStartMs": 188566,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "午夜十二點很快就到了"
    } ]
  }, {
    "tStartMs": 190766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "小萌的眼睛緊緊盯著天花板"
    } ]
  }, {
    "tStartMs": 193233,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "一下眼睛都不敢眨"
    } ]
  }, {
    "tStartMs": 194966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "時間緩緩的走著"
    } ]
  }, {
    "tStartMs": 196633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "宿舍裏靜的連呼吸聲都聽得很清楚"
    } ]
  }, {
    "tStartMs": 199766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "小萌也越來越緊張"
    } ]
  }, {
    "tStartMs": 201666,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "就在她數了幾秒"
    } ]
  }, {
    "tStartMs": 203233,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "想要放棄的時候"
    } ]
  }, {
    "tStartMs": 204733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "窗外突然傳來一陣"
    } ]
  }, {
    "tStartMs": 206600,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "咚咚咚的聲音"
    } ]
  }, {
    "tStartMs": 207733,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那聲音在深夜裏"
    } ]
  }, {
    "tStartMs": 209500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "顯得格外突兀"
    } ]
  }, {
    "tStartMs": 210900,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "小萌嚇得突然從床上坐起來"
    } ]
  }, {
    "tStartMs": 213466,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "真不是她膽小"
    } ]
  }, {
    "tStartMs": 214766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "而是他的宿舍在四樓"
    } ]
  }, {
    "tStartMs": 216666,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "怎麼可能會有人在外面敲窗呢"
    } ]
  }, {
    "tStartMs": 219200,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "還是在半夜十二點"
    } ]
  }, {
    "tStartMs": 220900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "就在小萌嚇得縮在床角發抖時"
    } ]
  }, {
    "tStartMs": 224033,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "宿舍的門突然被人推開了"
    } ]
  }, {
    "tStartMs": 226233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "借著走廊上的微光"
    } ]
  }, {
    "tStartMs": 227833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "她看清了來人"
    } ]
  }, {
    "tStartMs": 229166,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "正是她的室友苗苗"
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "只是她看上去很累的樣子"
    } ]
  }, {
    "tStartMs": 233033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "渾身都濕漉漉的"
    } ]
  }, {
    "tStartMs": 234466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "她看著小萌說"
    } ]
  }, {
    "tStartMs": 235833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "不好意思"
    } ]
  }, {
    "tStartMs": 236833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "這麼晚才回來"
    } ]
  }, {
    "tStartMs": 238066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "打擾你休息了吧"
    } ]
  }, {
    "tStartMs": 239466,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "聽到這裏我笑著說道"
    } ]
  }, {
    "tStartMs": 241433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "沒關系"
    } ]
  }, {
    "tStartMs": 242366,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "反正我也沒睡著"
    } ]
  }, {
    "tStartMs": 243800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 244600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "小萌的手機突然響了"
    } ]
  }, {
    "tStartMs": 246633,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "是另一位室友晶晶打來的"
    } ]
  }, {
    "tStartMs": 248800,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "小萌剛接過電話"
    } ]
  }, {
    "tStartMs": 250400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就聽到對方幽幽的說"
    } ]
  }, {
    "tStartMs": 252200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "小萌"
    } ]
  }, {
    "tStartMs": 253033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "你在宿舍小心一點"
    } ]
  }, {
    "tStartMs": 255000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "苗苗晚上掉進河裏淹死了"
    } ]
  }, {
    "tStartMs": 257366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "小心她回宿舍去找你"
    } ]
  }, {
    "tStartMs": 259733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "聽了室友的話"
    } ]
  }, {
    "tStartMs": 260966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "小萌整個人都楞住了"
    } ]
  }, {
    "tStartMs": 262966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "渾身的雞皮疙瘩都炸了起來"
    } ]
  }, {
    "tStartMs": 265300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "瞬間"
    } ]
  }, {
    "tStartMs": 266166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "恐懼不安的情緒將她包裹起來"
    } ]
  }, {
    "tStartMs": 268866,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "她不由自主的朝苗苗的床鋪看去"
    } ]
  }, {
    "tStartMs": 271900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "只見她的床邊"
    } ]
  }, {
    "tStartMs": 273233,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "不停的向下滴著水"
    } ]
  }, {
    "tStartMs": 275033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "身上也是濕漉漉的"
    } ]
  }, {
    "tStartMs": 276633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "臉色也不太對勁"
    } ]
  }, {
    "tStartMs": 278233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "看到這裏"
    } ]
  }, {
    "tStartMs": 279166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "小萌的心都快提到嗓子眼了"
    } ]
  }, {
    "tStartMs": 281733,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "但這時她又想到了"
    } ]
  }, {
    "tStartMs": 283633,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "另一個詭異的問題"
    } ]
  }, {
    "tStartMs": 285100,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那就是"
    } ]
  }, {
    "tStartMs": 285900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他的手機"
    } ]
  }, {
    "tStartMs": 286900,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "晚上一直是關機的狀態"
    } ]
  }, {
    "tStartMs": 289266,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "晶晶是怎麼打進來的"
    } ]
  }, {
    "tStartMs": 290833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就在我拿著手機疑惑時"
    } ]
  }, {
    "tStartMs": 292666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "苗苗突然轉過身來"
    } ]
  }, {
    "tStartMs": 294433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "直勾勾的盯著小萌說"
    } ]
  }, {
    "tStartMs": 296266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "小萌"
    } ]
  }, {
    "tStartMs": 297066,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "有件事"
    } ]
  }, {
    "tStartMs": 297900,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "我沒有告訴你"
    } ]
  }, {
    "tStartMs": 298966,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "聞言"
    } ]
  }, {
    "tStartMs": 299933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "小萌顫抖的問道"
    } ]
  }, {
    "tStartMs": 301433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "什麼事"
    } ]
  }, {
    "tStartMs": 302233,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "苗苗說"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "我今天這麼晚回來"
    } ]
  }, {
    "tStartMs": 304666,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "是因為在路上"
    } ]
  }, {
    "tStartMs": 306033,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "看到了一起車禍"
    } ]
  }, {
    "tStartMs": 307433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "車禍現場還死了人"
    } ]
  }, {
    "tStartMs": 309300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那人你也認識"
    } ]
  }, {
    "tStartMs": 310700,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "就是我們的室友晶晶"
    } ]
  }, {
    "tStartMs": 312166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "苗苗用平淡的語氣"
    } ]
  }, {
    "tStartMs": 314133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "敘述了車禍現場的情況"
    } ]
  }, {
    "tStartMs": 316366,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "但這些話"
    } ]
  }, {
    "tStartMs": 317500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "傳到小萌耳朵裏後"
    } ]
  }, {
    "tStartMs": 319266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "卻在她的心裏激起了千層浪"
    } ]
  }, {
    "tStartMs": 321566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一時間"
    } ]
  }, {
    "tStartMs": 322433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "不知道該相信誰"
    } ]
  }, {
    "tStartMs": 323900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "因為"
    } ]
  }, {
    "tStartMs": 324700,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "她們倆的表現都不對勁"
    } ]
  }, {
    "tStartMs": 326700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "晶晶打電話說苗苗死了"
    } ]
  }, {
    "tStartMs": 328966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "苗苗卻說是晶晶死了"
    } ]
  }, {
    "tStartMs": 330833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就這樣"
    } ]
  }, {
    "tStartMs": 331766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "小萌一整晚都在驚恐中度過"
    } ]
  }, {
    "tStartMs": 334366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "到現在"
    } ]
  }, {
    "tStartMs": 335233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "她都無法忘記這件事"
    } ]
  }, {
    "tStartMs": 337166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "說到這"
    } ]
  }, {
    "tStartMs": 338066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "小萌不禁打了個寒顫"
    } ]
  }, {
    "tStartMs": 339866,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "之後又接著說道"
    } ]
  }, {
    "tStartMs": 341366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "從那之後"
    } ]
  }, {
    "tStartMs": 342266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "我就經常在宿舍裏看到她們"
    } ]
  }, {
    "tStartMs": 344766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "每次出現的時間"
    } ]
  }, {
    "tStartMs": 346333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "都是在午夜十二點之後"
    } ]
  }, {
    "tStartMs": 348533,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "後來才知道"
    } ]
  }, {
    "tStartMs": 349600,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "其實"
    } ]
  }, {
    "tStartMs": 350300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "她們兩個人都是鬼"
    } ]
  }, {
    "tStartMs": 352100,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "小萌的遭遇"
    } ]
  }, {
    "tStartMs": 353233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "在這個特殊的日子裏"
    } ]
  }, {
    "tStartMs": 354833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "無疑是更加恐怖"
    } ]
  }, {
    "tStartMs": 356500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "眾人聽了都忍不住渾身一顫"
    } ]
  }, {
    "tStartMs": 358733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 359566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "銘又出言問道"
    } ]
  }, {
    "tStartMs": 360766,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "大鵬"
    } ]
  }, {
    "tStartMs": 361633,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "你的故事是什麼"
    } ]
  }, {
    "tStartMs": 363066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "聽到銘點到自己"
    } ]
  }, {
    "tStartMs": 364666,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "大鵬嘆了口氣"
    } ]
  }, {
    "tStartMs": 365566,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "說"
    } ]
  }, {
    "tStartMs": 366766,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "你們確定要聽我的故事嗎"
    } ]
  }, {
    "tStartMs": 368766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "我的遭遇可比她們恐怖多了"
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "聞言"
    } ]
  }, {
    "tStartMs": 371866,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "大家都說"
    } ]
  }, {
    "tStartMs": 372933,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "有什麼好怕的"
    } ]
  }, {
    "tStartMs": 374133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "她們自己都見過鬼"
    } ]
  }, {
    "tStartMs": 376066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "還會怕鬼故事嗎"
    } ]
  }, {
    "tStartMs": 377500,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "在大家的催促下"
    } ]
  }, {
    "tStartMs": 379066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "大鵬終於開始講了"
    } ]
  }, {
    "tStartMs": 380833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "你們也知道我很胖"
    } ]
  }, {
    "tStartMs": 382600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "根本就沒有人會喜歡上我這樣的人"
    } ]
  }, {
    "tStartMs": 385300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我一直希望能有個女朋友"
    } ]
  }, {
    "tStartMs": 387500,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 388600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我的一位室友告訴我"
    } ]
  }, {
    "tStartMs": 390233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "只要在淩晨三點的時候"
    } ]
  }, {
    "tStartMs": 392233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "將兩面相同的鏡子靠在一起"
    } ]
  }, {
    "tStartMs": 394900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "鏡子裏就會出現很多你沒有見過的臉"
    } ]
  }, {
    "tStartMs": 397900,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "而其中的第十三張臉"
    } ]
  }, {
    "tStartMs": 400100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "就是你未來女朋友的樣子"
    } ]
  }, {
    "tStartMs": 402000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "聽到這"
    } ]
  }, {
    "tStartMs": 402900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "大鵬又怎麼能忍得住呢"
    } ]
  }, {
    "tStartMs": 404933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "他可是一直都渴望能擁有一位女朋友"
    } ]
  }, {
    "tStartMs": 408000,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "於是"
    } ]
  }, {
    "tStartMs": 408633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "他便在室友都睡著的時候"
    } ]
  }, {
    "tStartMs": 410900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "偷偷爬起來拿著兩面鏡子"
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "跑到陽臺上"
    } ]
  }, {
    "tStartMs": 414300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "借著月光"
    } ]
  }, {
    "tStartMs": 415333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "將鏡子靠在了一起"
    } ]
  }, {
    "tStartMs": 417033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一開始"
    } ]
  }, {
    "tStartMs": 417933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "鏡子根本就沒有任何反應"
    } ]
  }, {
    "tStartMs": 420233,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "直到大鵬不斷的調試後"
    } ]
  }, {
    "tStartMs": 422233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "鏡子突然出現了鏡像的情況"
    } ]
  }, {
    "tStartMs": 424800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "之後就像室友說的那樣"
    } ]
  }, {
    "tStartMs": 426766,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "出現了很多張臉"
    } ]
  }, {
    "tStartMs": 428233,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "但是"
    } ]
  }, {
    "tStartMs": 428933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "都只照出了大鵬自己的樣子"
    } ]
  }, {
    "tStartMs": 431400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "他按照室友的說法"
    } ]
  }, {
    "tStartMs": 433033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "一張一張的數著"
    } ]
  }, {
    "tStartMs": 434533,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就在他剛要數十三時"
    } ]
  }, {
    "tStartMs": 436466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "鏡子裏突然出現了恐怖的笑聲"
    } ]
  }, {
    "tStartMs": 439200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "讓本就緊張的大鵬"
    } ]
  }, {
    "tStartMs": 441066,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "受到了不小的驚嚇"
    } ]
  }, {
    "tStartMs": 442666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "以至於不小心碰到了鏡子"
    } ]
  }, {
    "tStartMs": 444933,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "然而"
    } ]
  }, {
    "tStartMs": 445666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "就在大鵬觸碰到鏡子時"
    } ]
  }, {
    "tStartMs": 448000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "那鏡子直接就炸開了"
    } ]
  }, {
    "tStartMs": 449866,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "突然"
    } ]
  }, {
    "tStartMs": 450633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "大鵬的身後"
    } ]
  }, {
    "tStartMs": 451866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "傳來一陣嘲笑聲"
    } ]
  }, {
    "tStartMs": 453500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "大鵬一回頭"
    } ]
  }, {
    "tStartMs": 454833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就看見了那位慫恿自己這樣做的室友"
    } ]
  }, {
    "tStartMs": 457833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "室友見自己按照他的說法做了"
    } ]
  }, {
    "tStartMs": 460533,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "便嘲笑道"
    } ]
  }, {
    "tStartMs": 461633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那故事是我騙你的"
    } ]
  }, {
    "tStartMs": 463266,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "你還真信了"
    } ]
  }, {
    "tStartMs": 464466,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "不管你怎麼數"
    } ]
  }, {
    "tStartMs": 465733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "看到的都只是你自己"
    } ]
  }, {
    "tStartMs": 467700,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "怎麼可能會看到你未來女朋友的樣子"
    } ]
  }, {
    "tStartMs": 470433,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "這世上根本就沒有鬼神之說"
    } ]
  }, {
    "tStartMs": 472800,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "就你這樣的"
    } ]
  }, {
    "tStartMs": 473833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "還想有女朋友"
    } ]
  }, {
    "tStartMs": 475300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "簡直是在做夢"
    } ]
  }, {
    "tStartMs": 476600,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "聽他這樣說"
    } ]
  }, {
    "tStartMs": 477733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "大鵬才知道自己被騙了"
    } ]
  }, {
    "tStartMs": 479833,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "但是"
    } ]
  }, {
    "tStartMs": 480600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "他有件事沒有告訴室友"
    } ]
  }, {
    "tStartMs": 482733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "剛剛鏡子裏的第十三張臉"
    } ]
  }, {
    "tStartMs": 484933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "根本不是自己的"
    } ]
  }, {
    "tStartMs": 486333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "而是那室友的"
    } ]
  }, {
    "tStartMs": 487400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "只不過"
    } ]
  }, {
    "tStartMs": 488266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "那是一張滿是鮮血的臉"
    } ]
  }, {
    "tStartMs": 490300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "之後"
    } ]
  }, {
    "tStartMs": 491100,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "又過了很長時間"
    } ]
  }, {
    "tStartMs": 492633,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "大鵬也將這件事淡忘了"
    } ]
  }, {
    "tStartMs": 494800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 495900,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "大鵬突然收到了警察帶來的消息"
    } ]
  }, {
    "tStartMs": 498900,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "那位耍自己的室友"
    } ]
  }, {
    "tStartMs": 500700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "在校外酒吧裏鬧事"
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "被幾個小混混失手打死了"
    } ]
  }, {
    "tStartMs": 504900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "作為他的室友"
    } ]
  }, {
    "tStartMs": 506166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "大鵬必須要跟警察去派出所做筆錄"
    } ]
  }, {
    "tStartMs": 509266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然而"
    } ]
  }, {
    "tStartMs": 510066,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "它卻在派出所裏"
    } ]
  }, {
    "tStartMs": 511566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "意外看到了室友的死狀"
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那一刻"
    } ]
  }, {
    "tStartMs": 514500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "大鵬整個人都呆住了"
    } ]
  }, {
    "tStartMs": 516466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "他怎麽也不敢相信"
    } ]
  }, {
    "tStartMs": 517966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "室友的死狀"
    } ]
  }, {
    "tStartMs": 519100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "竟然和自己之前在鏡子裏看到的一樣"
    } ]
  }, {
    "tStartMs": 522200,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "從那之後"
    } ]
  }, {
    "tStartMs": 523200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "大鵬就驚訝的發現"
    } ]
  }, {
    "tStartMs": 525066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "自己平時總會看到一些別人看不見的東西"
    } ]
  }, {
    "tStartMs": 528666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "隨著大鵬的故事結束"
    } ]
  }, {
    "tStartMs": 530433,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "就只剩下銘的故事還沒有講了"
    } ]
  }, {
    "tStartMs": 532766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "接著"
    } ]
  }, {
    "tStartMs": 533566,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "大家都朝銘看去"
    } ]
  }, {
    "tStartMs": 535066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "示意他"
    } ]
  }, {
    "tStartMs": 535900,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "可以開始講了"
    } ]
  }, {
    "tStartMs": 537033,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "只見"
    } ]
  }, {
    "tStartMs": 537833,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "銘笑了笑說"
    } ]
  }, {
    "tStartMs": 539066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "跟你們比"
    } ]
  }, {
    "tStartMs": 540033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我實在是沒什麽說的"
    } ]
  }, {
    "tStartMs": 541766,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "因為"
    } ]
  }, {
    "tStartMs": 542466,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我是從小就能看見"
    } ]
  }, {
    "tStartMs": 544200,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "這些別人看不到的東西"
    } ]
  }, {
    "tStartMs": 546300,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 546966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "阿美說道"
    } ]
  }, {
    "tStartMs": 547900,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "你可以講一講"
    } ]
  }, {
    "tStartMs": 549133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "你覺得可怕的事情"
    } ]
  }, {
    "tStartMs": 550900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "銘看著她們一副好奇的樣子"
    } ]
  }, {
    "tStartMs": 553466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "笑著說道"
    } ]
  }, {
    "tStartMs": 554433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "那我就給你們講個我見鬼的經歷吧"
    } ]
  }, {
    "tStartMs": 557166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我小時候身體不是很好"
    } ]
  }, {
    "tStartMs": 559466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "父母從不讓我和小朋友一起玩"
    } ]
  }, {
    "tStartMs": 562133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "這對於一個小孩來說"
    } ]
  }, {
    "tStartMs": 563766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "是多麽可悲的事情啊"
    } ]
  }, {
    "tStartMs": 565366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "不過好在家裏"
    } ]
  }, {
    "tStartMs": 566766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "還有一個姐姐可以陪自己玩"
    } ]
  }, {
    "tStartMs": 569100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "這讓銘開心不少"
    } ]
  }, {
    "tStartMs": 570700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "每次姐姐來找他玩"
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "都會坐在衣櫃裏"
    } ]
  }, {
    "tStartMs": 573933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "身上披著好幾件衣服"
    } ]
  }, {
    "tStartMs": 575900,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "形象看起來怪怪的"
    } ]
  }, {
    "tStartMs": 577900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "姐姐的身體狀況和銘差不多"
    } ]
  }, {
    "tStartMs": 580366,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "都不怎麽好"
    } ]
  }, {
    "tStartMs": 581300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "因此"
    } ]
  }, {
    "tStartMs": 582133,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "她們每次見面"
    } ]
  }, {
    "tStartMs": 583466,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "都只能坐著聊天或下棋"
    } ]
  }, {
    "tStartMs": 585833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就這樣"
    } ]
  }, {
    "tStartMs": 586700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "一直持續了很久"
    } ]
  }, {
    "tStartMs": 588133,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "直到有一天"
    } ]
  }, {
    "tStartMs": 589266,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "銘的父母都不在家"
    } ]
  }, {
    "tStartMs": 591000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "他開心的跑到衣櫥旁"
    } ]
  }, {
    "tStartMs": 593133,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "將衣櫥打開"
    } ]
  }, {
    "tStartMs": 594600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "興奮的對姐姐說道"
    } ]
  }, {
    "tStartMs": 596133,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "姐姐"
    } ]
  }, {
    "tStartMs": 597000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "今天我父母都不在家"
    } ]
  }, {
    "tStartMs": 598900,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我們一起出去玩吧"
    } ]
  }, {
    "tStartMs": 600400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "本以為"
    } ]
  }, {
    "tStartMs": 601600,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "姐姐會很開心的答應自己的要求"
    } ]
  }, {
    "tStartMs": 604300,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "但是沒想到"
    } ]
  }, {
    "tStartMs": 605500,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "姐姐想也沒想"
    } ]
  }, {
    "tStartMs": 606833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "直接就拒絕了自己"
    } ]
  }, {
    "tStartMs": 608333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "銘很傷心"
    } ]
  }, {
    "tStartMs": 609400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他不明白"
    } ]
  }, {
    "tStartMs": 610400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "姐姐為什麽不願意跟自己出去玩"
    } ]
  }, {
    "tStartMs": 613100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "但他想著"
    } ]
  }, {
    "tStartMs": 614200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "父母好不容易都不在家"
    } ]
  }, {
    "tStartMs": 616300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "今天不出去玩"
    } ]
  }, {
    "tStartMs": 617500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "以後"
    } ]
  }, {
    "tStartMs": 618333,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "可能就出不去了"
    } ]
  }, {
    "tStartMs": 619566,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "因為"
    } ]
  }, {
    "tStartMs": 620433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不想錯過這大好時機"
    } ]
  }, {
    "tStartMs": 622466,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "便不顧姐姐的拒絕"
    } ]
  }, {
    "tStartMs": 624133,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "想要伸手拉她出去"
    } ]
  }, {
    "tStartMs": 625966,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "但是沒想到"
    } ]
  }, {
    "tStartMs": 627133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "姐姐一看他伸手"
    } ]
  }, {
    "tStartMs": 628733,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "直接就躲進了櫃子裏"
    } ]
  }, {
    "tStartMs": 630333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "關上了櫃門"
    } ]
  }, {
    "tStartMs": 631400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "銘見狀"
    } ]
  }, {
    "tStartMs": 632333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "趕緊將櫃門打開"
    } ]
  }, {
    "tStartMs": 634033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "但不管他怎麽找"
    } ]
  }, {
    "tStartMs": 635500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "都找不到姐姐的身影"
    } ]
  }, {
    "tStartMs": 637366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "他大哭的跑到樓下"
    } ]
  }, {
    "tStartMs": 639300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "但卻看到"
    } ]
  }, {
    "tStartMs": 640400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "母親身邊圍著一群白衣服的人"
    } ]
  }, {
    "tStartMs": 643233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "嚇得他直接躲了起來"
    } ]
  }, {
    "tStartMs": 645333,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "直到大家都離開了"
    } ]
  }, {
    "tStartMs": 646933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "他才跑出來"
    } ]
  }, {
    "tStartMs": 648100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "一臉委屈的告訴母親"
    } ]
  }, {
    "tStartMs": 650100,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "姐姐不見了"
    } ]
  }, {
    "tStartMs": 651133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "一聽這話"
    } ]
  }, {
    "tStartMs": 652133,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "母親直接就楞住了"
    } ]
  }, {
    "tStartMs": 653800,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "尖叫著說道"
    } ]
  }, {
    "tStartMs": 654933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你姐姐在你出生之前"
    } ]
  }, {
    "tStartMs": 657000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就已經被壞人悶死在衣櫥裏了"
    } ]
  }, {
    "tStartMs": 659533,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 660266,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "我才意思到"
    } ]
  }, {
    "tStartMs": 661266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "自己是看見鬼了"
    } ]
  }, {
    "tStartMs": 662766,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "從那之後"
    } ]
  }, {
    "tStartMs": 663733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "那位姐姐就再也沒出現過了"
    } ]
  }, {
    "tStartMs": 666033,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "之後"
    } ]
  }, {
    "tStartMs": 666833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "銘又偷偷從家裏溜出來一次"
    } ]
  }, {
    "tStartMs": 669133,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "見門口有個掃地的阿姨"
    } ]
  }, {
    "tStartMs": 671733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "便親切的叫著她"
    } ]
  }, {
    "tStartMs": 673266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但是銘一直叫了很長時間"
    } ]
  }, {
    "tStartMs": 675633,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "她才轉過頭來"
    } ]
  }, {
    "tStartMs": 677000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "指著自己家的方向"
    } ]
  }, {
    "tStartMs": 678333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "說道"
    } ]
  }, {
    "tStartMs": 679166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "那家的女人真可憐"
    } ]
  }, {
    "tStartMs": 680966,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "女兒被人活活悶死在衣櫃裏"
    } ]
  }, {
    "tStartMs": 683433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "小兒子也在出生後不久"
    } ]
  }, {
    "tStartMs": 685733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "就去世了"
    } ]
  }, {
    "tStartMs": 686666,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "之後就徹底瘋了"
    } ]
  }, {
    "tStartMs": 688066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "以至於"
    } ]
  }, {
    "tStartMs": 688900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "她到現在都覺得自己的兒子還活著"
    } ]
  }, {
    "tStartMs": 691833,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "銘聽完這些話"
    } ]
  }, {
    "tStartMs": 693133,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "也楞住了"
    } ]
  }, {
    "tStartMs": 694200,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "母親什麽時候又生了個男孩"
    } ]
  }, {
    "tStartMs": 696400,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 697133,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "銘突然回頭"
    } ]
  }, {
    "tStartMs": 698266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "發現"
    } ]
  }, {
    "tStartMs": 699133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "自己身後還站著一個人"
    } ]
  }, {
    "tStartMs": 701000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "原來"
    } ]
  }, {
    "tStartMs": 701766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "那阿姨不是在跟自己說話"
    } ]
  }, {
    "tStartMs": 704000,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 704733,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "他突然頓住了"
    } ]
  }, {
    "tStartMs": 705933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "難道說"
    } ]
  }, {
    "tStartMs": 706833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "她們都看不到自己嗎"
    } ]
  }, {
    "tStartMs": 708766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "故事講完後"
    } ]
  }, {
    "tStartMs": 709933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "小萌忍不住提出了疑問"
    } ]
  }, {
    "tStartMs": 711866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "你這個故事"
    } ]
  }, {
    "tStartMs": 712966,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "為什麽我有點聽不懂"
    } ]
  }, {
    "tStartMs": 714733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "這時"
    } ]
  }, {
    "tStartMs": 715566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "銘的臉上"
    } ]
  }, {
    "tStartMs": 716566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "突然露出一副詭異的笑容"
    } ]
  }, {
    "tStartMs": 718933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "他看著大家說道"
    } ]
  }, {
    "tStartMs": 720400,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "我的故事是說"
    } ]
  }, {
    "tStartMs": 721533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我從小就能看見鬼的原因是"
    } ]
  }, {
    "tStartMs": 723800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "因為我在小的時候"
    } ]
  }, {
    "tStartMs": 725300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "就已經死了"
    } ]
  } ]
}
